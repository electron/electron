{
  "name": "tab-identity",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["tabs", "scripting", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
