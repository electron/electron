     dContext->flush();
     dContext->submit(GrSyncCpu::kYes);
 
-    REPORTER_ASSERT(reporter, (helper.*check)(helper.liveCanvas(), kImageWH,
-                                              /*hits*/ 0, /*misses*/ 1, /*refs*/ 0, kNoID));
+    int expectedCacheEntries = failureClearsProxyCache ? 0 : 1;
