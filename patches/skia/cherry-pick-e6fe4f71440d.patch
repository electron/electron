+                uint32_t opBits = static_cast<uint32_t>(element->fOp);
+                builder[elementKeyIndex + 4] = fracBits | (opBits << 16);
+
+                const Shape& shape = element->fShape;
+                shape.writeKey(&builder[elementKeyIndex + kXformKeySize],
