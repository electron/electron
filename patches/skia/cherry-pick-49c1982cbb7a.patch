diff --git a/src/gpu/graphite/PathAtlas.cpp b/src/gpu/graphite/PathAtlas.cpp
index c8750cdf2ee777927c52e8af6a12a2461c2b7b5c..6b25135931fa600ee3fa3e2158acd18a6da7a10c 100644
