--- a/src/gpu/ganesh/vk/GrVkGpu.cpp
+++ b/src/gpu/ganesh/vk/GrVkGpu.cpp
@@ -72,9 +72,11 @@
 #include "src/gpu/vk/VulkanUtilsPriv.h"
 
 #include <algorithm>
+#include <chrono>
 #include <cstring>
 #include <functional>
 #include <numeric>
+#include <thread>
 #include <utility>
 
 class GrAttachment;
@@ -2234,11 +2236,17 @@ bool GrVkGpu::onSubmitToGpu(const GrSubmitInfo& info) {
 }
 
 void GrVkGpu::finishOutstandingGpuWork() {
-    VK_CALL(QueueWaitIdle(fQueue));
+    VkResult res;
+    VK_CALL_RET(res, QueueWaitIdle(fQueue));
 
     if (this->vkCaps().mustSyncCommandBuffersWithQueue()) {
         fResourceProvider.forceSyncAllCommandBuffers();
     }
+
+    if (this->vkCaps().sleepAfterLostDeviceWait() &&
+        (res == VK_ERROR_DEVICE_LOST || this->isDeviceLost())) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
 }
 
 void GrVkGpu::onReportSubmitHistograms() {
