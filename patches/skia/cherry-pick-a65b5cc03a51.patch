diff --git a/tests/RasterPipelineCodeGeneratorTest.cpp b/tests/RasterPipelineCodeGeneratorTest.cpp
index 617ae808f0280d1c09413e4ff4ec982fffbe77b8..4a1b46f90792387e3399d9fcd0d0b562343fdd9f 100644
