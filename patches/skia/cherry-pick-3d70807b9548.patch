+DEF_TEST(DistanceField_SDFMaskFilter, reporter) {
+    sk_sp<SkMaskFilter> filter = sktext::gpu::SDFMaskFilter::Make();
+    REPORTER_ASSERT(reporter, filter != nullptr);
+
+    constexpr int kW = 8;
+    constexpr int kH = 8;
