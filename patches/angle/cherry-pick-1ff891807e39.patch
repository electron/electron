diff --git a/src/compiler/translator/ir/src/transform/ensure_loop_forward_progress.rs b/src/compiler/translator/ir/src/transform/ensure_loop_forward_progress.rs
index b84303ffa490831a7b6048327d791127db232a8f..b0813146cf49acc6588fc5e6520b4276911a1fe2 100644
--- a/src/compiler/translator/ir/src/transform/ensure_loop_forward_progress.rs
+++ b/src/compiler/translator/ir/src/transform/ensure_loop_forward_progress.rs
@@ -172,14 +172,30 @@ fn matches_finite_loop_condition(ir_meta: &IRMeta, block: &Block) -> Option<Vari
             return None;
         }
 
-        // If the type is uint and the condition is >=, it might be |>= 0| which is always true;
-        // don't consider that a finite loop.  Only |>= 0| and |>= variable_that_could_be_zero| may
+        // If the type is uint and the condition is >=, it might be `>= 0` which is always true;
+        // don't consider that a finite loop.  Only `>= 0` and `>= variable_that_could_be_zero` may
         // lead to infinite loop, but all uint with >= is considered infinite loop for simplicity.
-        if matches!(type_info, Type::Scalar(BasicType::Uint))
-            && matches!(
-                ir_meta.get_instruction(op_result).op,
-                OpCode::Binary(BinaryOpCode::GreaterThanEqual, ..)
-            )
+        //
+        // While signed int overflow is undefined behavior, `>= INT_MIN` would also be
+        // unconditionally true even if the compiler makes signed int overflow well-defined.
+        // Using >= in loops is uncommon, so any >= use is considered a potential infinite loop
+        // for simplicity.
+        if matches!(
+            ir_meta.get_instruction(op_result).op,
+            OpCode::Binary(BinaryOpCode::GreaterThanEqual, ..)
+        ) {
+            return None;
+        }
+
+        // If the condition is <=, it might be `<= UINT_MAX` or `<= INT_MAX` for signed ints.
+        // However, `for` loops with <= are likely common, so we try to avoid considering them as
+        // infinite loop unnecessarily.  For simplicity, if a variable is used or any
+        // unrealistically large constant, consider it a potential infinite loop.
+        if matches!(
+            ir_meta.get_instruction(op_result).op,
+            OpCode::Binary(BinaryOpCode::LessThanEqual, ..)
+        ) && let Id::Constant(comparator_constant) = comparator
+            && ir_meta.get_constant(comparator_constant).value.get_index() > 1_000_000
         {
             return None;
         }
diff --git a/src/compiler/translator/tree_ops/EnsureLoopForwardProgress.cpp b/src/compiler/translator/tree_ops/EnsureLoopForwardProgress.cpp
index 1382016a87e8cec757aed3f8c9398a47918ad1bc..ed3ee0c54e0b2e29e2d4fae645d4bddaca0b69ad 100644
--- a/src/compiler/translator/tree_ops/EnsureLoopForwardProgress.cpp
+++ b/src/compiler/translator/tree_ops/EnsureLoopForwardProgress.cpp
@@ -86,32 +86,63 @@ const TVariable *computeFiniteLoopVariable(TIntermLoop *loop)
     {
         return nullptr;
     }
+    // Loop index must be compared with a constant or uniform or similar read-only variable.
+    if (!IsReadOnlyExpr(*binCond->getRight()))
+    {
+        return nullptr;
+    }
     switch (binCond->getOp())
     {
         case EOpEqual:
         case EOpNotEqual:
         case EOpLessThan:
         case EOpGreaterThan:
+            break;
         case EOpLessThanEqual:
+        {
+            // If the condition is <=, it might be |<= UINT_MAX| or |<= INT_MAX| for signed ints.
+            // However, |for| loops with <= are likely common, so we try to avoid considering them
+            // as infinite loop unnecessarily.  For simplicity, if a variable is used or any
+            // unrealistically large constant, consider it a potential infinite loop.
+            constexpr int32_t kLoopLimit     = 1'000'000;
+            const TConstantUnion *comparator = binCond->getRight()->getConstantValue();
+            if (comparator == nullptr)
+            {
+                return nullptr;
+            }
+            switch (comparator->getType())
+            {
+                case EbtInt:
+                    if (comparator->getIConst() < 0 || comparator->getIConst() >= kLoopLimit)
+                    {
+                        return nullptr;
+                    }
+                    break;
+                case EbtUInt:
+                    if (comparator->getUConst() >= kLoopLimit)
+                    {
+                        return nullptr;
+                    }
+                    break;
+                default:
+                    return nullptr;
+            }
             break;
+        }
         case EOpGreaterThanEqual:
             // If the type is uint and the condition is >=, it might be |>= 0| which is always true;
             // don't consider that a finite loop.  Only |>= 0| and |>= variable_that_could_be_zero|
             // may lead to infinite loop, but all uint with >= is considered infinite loop for
             // simplicity.
-            if (variable->getType().getBasicType() == EbtUInt)
-            {
-                return nullptr;
-            }
-            break;
+            //
+            // While signed int overflow is undefined behavior, |>= INT_MIN| would also be
+            // unconditionally true even if the compiler makes signed int overflow well-defined.
+            // Using >= in loops is uncommon, so any >= use is considered a potential infinite loop
+            // for simplicity.
+            return nullptr;
         default:
             return nullptr;
     }
