diff --git a/src/libANGLE/Framebuffer.cpp b/src/libANGLE/Framebuffer.cpp
index fd4818d42903fb63438b37454a8072a7f02eb849..79a3dc6133c0d6a1c9ae0367f0e60cb966b9693a 100644
--- a/src/libANGLE/Framebuffer.cpp
+++ b/src/libANGLE/Framebuffer.cpp
@@ -669,6 +669,39 @@ bool FramebufferState::colorAttachmentsAreUniqueImages() const
             {
                 return false;
             }
+
+            // Also check if two attachments on the same texture and mip level have overlapping
+            // layer ranges. For example, glFramebufferTextureMultiviewOVR can attach a range of
+            // layers [baseViewIndex, baseViewIndex + numViews) from a 2D array texture. Even if
+            // two attachments have different baseViewIndex values (so firstAttachment !=
+            // secondAttachment), their layer ranges can still overlap (e.g. layers [0, 2) and
+            // [1, 3) both include layer 1).
+            if (firstAttachment.type() == GL_TEXTURE && secondAttachment.type() == GL_TEXTURE &&
+                firstAttachment.getResource() == secondAttachment.getResource())
+            {
+                const ImageIndex &firstIndex  = firstAttachment.getTextureImageIndex();
+                const ImageIndex &secondIndex = secondAttachment.getTextureImageIndex();
+                if (firstIndex.getLevelIndex() == secondIndex.getLevelIndex())
+                {
+                    // If either attachment covers the entire mip level rather than specific
+                    // layer(s), they must overlap.
+                    if (!firstIndex.hasLayer() || !secondIndex.hasLayer())
+                    {
+                        return false;
+                    }
+
+                    // Check whether the half-open layer intervals [firstStart, firstEnd) and
+                    // [secondStart, secondEnd) overlap.
+                    const GLint firstStart  = firstIndex.getLayerIndex();
+                    const GLint firstEnd    = firstStart + firstIndex.getLayerCount();
+                    const GLint secondStart = secondIndex.getLayerIndex();
+                    const GLint secondEnd   = secondStart + secondIndex.getLayerCount();
+                    if (firstStart < secondEnd && secondStart < firstEnd)
+                    {
+                        return false;
+                    }
+                }
+            }
         }
     }
 
diff --git a/src/libANGLE/renderer/d3d/FramebufferD3D.cpp b/src/libANGLE/renderer/d3d/FramebufferD3D.cpp
index 204b3a753c149788d69140da04cc6a3a7ba2c714..7656e1988210870f5c56829bbf977bd8455ba235 100644
--- a/src/libANGLE/renderer/d3d/FramebufferD3D.cpp
+++ b/src/libANGLE/renderer/d3d/FramebufferD3D.cpp
@@ -284,6 +284,42 @@ gl::FramebufferStatus FramebufferD3D::checkStatus(const gl::Context *context) co
             gl::err::kFramebufferIncompleteUnsupportedMissmatchedDimensions);
     }
 
+    // D3D11's OMSetRenderTargets requires all bound RenderTargetViews and the DepthStencilView to
+    // have matching resource dimensions; otherwise the call fails and leaves the previously bound
+    // targets active on the device context. 3D texture color attachments use
+    // D3D11_RTV_DIMENSION_TEXTURE3D, so they cannot be mixed with non-3D color attachments (such
+    // as 2D textures, 2D array textures, cube maps, or renderbuffers).
+    bool has3DAttachment    = false;
+    bool hasNon3DAttachment = false;
+    for (const gl::FramebufferAttachment &attachment : mState.getColorAttachments())
+    {
+        if (attachment.isAttached())
+        {
+            if (attachment.type() == GL_TEXTURE &&
+                attachment.getTextureImageIndex().getType() == gl::TextureType::_3D)
+            {
+                has3DAttachment = true;
+            }
+            else
+            {
+                hasNon3DAttachment = true;
+            }
+        }
+    }
+    // D3D11 does not support 3D depth/stencil views (D3D11_DSV_DIMENSION_TEXTURE3D does not
+    // exist), so any depth or stencil attachment is always non-3D and cannot be bound alongside a
+    // 3D texture color attachment in OMSetRenderTargets.
+    if (mState.getDepthAttachment() != nullptr || mState.getStencilAttachment() != nullptr)
+    {
+        hasNon3DAttachment = true;
+    }
+    if (has3DAttachment && hasNon3DAttachment)
+    {
+        return gl::FramebufferStatus::Incomplete(
+            GL_FRAMEBUFFER_UNSUPPORTED,
+            gl::err::kFramebufferIncompleteUnsupportedMixed3DAndNon3DAttachments);
+    }
+
     return gl::FramebufferStatus::Complete();
 }
 
