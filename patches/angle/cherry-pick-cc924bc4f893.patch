+template <typename DrawQuadFn>
+void TestUniqueFramebufferAttachmentsMultiview(DrawQuadFn drawQuadFn)
+{
+    ANGLE_SKIP_TEST_IF(!EnsureGLExtensionEnabled("GL_OVR_multiview2"));
+
+    constexpr char kVS[] = R"(#version 300 es
