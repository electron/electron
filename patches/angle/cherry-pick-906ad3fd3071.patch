From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antonio Maiorano <amaiorano@google.com>
Date: Thu, 1 Oct 2026 15:29:41 -0400
Subject: D3D11: Fix UNPACK_ROW_LENGTH handling in fast PBO unpack

In PixelTransfer11::setBufferToTextureCopyParams, PixelsPerRow was set
to unpack.rowLength (when > 0) instead of destArea.width. Because
PixelsPerRow controls the number of destination columns drawn per row,
setting it to unpack.rowLength caused incomplete row writes when 0 <
unpack.rowLength < destArea.width and out-of-bounds row writes when
unpack.rowLength > destArea.width on partial-width updates.

Set PixelsPerRow to destArea.width and compute RowStride from
unpack.rowLength (when > 0) or destArea.width.

Also move PBO unpack validation and hardened-context unpack parameter
validation from ValidateES3TexImageParametersBase into
ValidImageDataSize so ES2 contexts with GL_EXT_unpack_subimage and
GL_NV_pixel_buffer_object enforce the same checks as ES3.

Add tests:
- Texture2DTestES3.TexImageUnpackRowLengthSmallerThanWidthAndSubRectPBO
- WebGL1CompatibilityTest.UnpackStateAndPBOValidation

Skip
Texture2DTestES3.TexImageUnpackRowLengthSmallerThanWidthAndSubRectPBO on
PIXEL10 GLES (PowerVR), where the native GLES driver fails with
GL_INVALID_OPERATION when unpacking overlapping rows (0 <
GL_UNPACK_ROW_LENGTH < width) from a PBO, matching existing skips under
crbug.com/480069042.

Bug: b/556750258
Change-Id: Idf1791c5e0eead05c9bbf2a1995cbc393b3e1127
Reviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/8502520
Reviewed-by: Shahbaz Youssefi <syoussefi@chromium.org>
Commit-Queue: Antonio Maiorano <amaiorano@google.com>
Reviewed-by: Ran Wang <wangra@google.com>

Electron adaptation notes (42-x-y): on this ANGLE revision
ValidImageDataSize still takes `GLsizei imageSize` (not `outImageSize`) and
already performed the pixel-unpack-buffer transform-feedback check under
`isWebGL() || isHardenedContext()`, so upstream's duplicate of that check
is not added; the data-alignment, mapped-buffer and UNPACK_SKIP_* / ROW_LENGTH
checks are moved out of ValidateES3TexImageParametersBase into
ValidImageDataSize as upstream, with the unpack-parameter block guarded by
`isHardenedContext() || webglCompatibilityANGLE` to preserve the condition
the ES3 path used here. The upstream-only
ValidateHardenedContextTextureLevelRedefine hunk has no counterpart and is
omitted. WebGLCompatibilityTest hunks did not apply and were dropped.

diff --git a/src/libANGLE/renderer/d3d/d3d11/PixelTransfer11.cpp b/src/libANGLE/renderer/d3d/d3d11/PixelTransfer11.cpp
index b806942caf44afadb86ad888fd7dad7064e232a5..cf9097d0e14dff97b5157142add9a210d58724d6 100644
--- a/src/libANGLE/renderer/d3d/d3d11/PixelTransfer11.cpp
+++ b/src/libANGLE/renderer/d3d/d3d11/PixelTransfer11.cpp
@@ -135,9 +135,10 @@ void PixelTransfer11::setBufferToTextureCopyParams(const gl::Box &destArea,
         (alignmentBytes <= bytesPerPixel ? 1 : alignmentBytes / bytesPerPixel);
 
     parametersOut->FirstPixelOffset = offset / bytesPerPixel;
-    parametersOut->PixelsPerRow =
-        static_cast<unsigned int>((unpack.rowLength > 0) ? unpack.rowLength : destArea.width);
-    parametersOut->RowStride    = roundUp(parametersOut->PixelsPerRow, alignmentPixels);
+    parametersOut->PixelsPerRow     = static_cast<unsigned int>(destArea.width);
+    parametersOut->RowStride        = roundUp(
+        static_cast<unsigned int>((unpack.rowLength > 0) ? unpack.rowLength : destArea.width),
+        alignmentPixels);
     parametersOut->RowsPerSlice = static_cast<unsigned int>(destArea.height);
     parametersOut->PositionOffset[0] =
         texelCenterX + (destArea.x / float(destSize.width)) * 2.0f - 1.0f;
diff --git a/src/libANGLE/validationES.cpp b/src/libANGLE/validationES.cpp
index 37c3b4bc2b9e947e440876ef968500bdd44efc14..75945f36e11e443edf275fe9bbbeafa59a62c08e 100644
--- a/src/libANGLE/validationES.cpp
+++ b/src/libANGLE/validationES.cpp
@@ -1389,6 +1389,7 @@ bool ValidImageDataSize(const Context *context,
                         GLsizei width,
                         GLsizei height,
                         GLsizei depth,
+                        bool isSubImage,
                         GLenum format,
                         GLenum type,
                         const void *pixels,
@@ -1441,6 +1442,26 @@ bool ValidImageDataSize(const Context *context,
                                    kPixelUnpackBufferBoundForTransformFeedback);
             return false;
         }
+
+        // ...data is not evenly divisible into the number of bytes needed to store in memory a
+        // datum indicated by type.
+        {
+            size_t offset            = reinterpret_cast<size_t>(pixels);
+            size_t dataBytesPerPixel = static_cast<size_t>(GetTypeInfo(type).bytes);
+
+            if ((offset % dataBytesPerPixel) != 0)
+            {
+                ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kDataTypeNotAligned);
+                return false;
+            }
+        }
+
+        // ...the buffer object's data store is currently mapped but not persistently.
+        if (pixelUnpackBuffer->isMapped() && !pixelUnpackBuffer->isPersistentlyMapped())
+        {
+            ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kBufferMapped);
+            return false;
+        }
     }
     else
     {
@@ -1458,6 +1479,49 @@ bool ValidImageDataSize(const Context *context,
         }
     }
 
+    if (context->isHardenedContext() || context->getExtensions().webglCompatibilityANGLE)
+    {
+        // Define:
+        //   DataStoreWidth  = (GL_UNPACK_ROW_LENGTH ? GL_UNPACK_ROW_LENGTH : width)
+        //   DataStoreHeight = (GL_UNPACK_IMAGE_HEIGHT ? GL_UNPACK_IMAGE_HEIGHT : height)
+        //
+        // WebGL 2.0 / hardened contexts impose the following additional constraints:
+        //
+        // 1) texImage2D and texSubImage2D generate INVALID_OPERATION if:
+        //      GL_UNPACK_SKIP_PIXELS + width > DataStoreWidth
+        //    except for texImage2D if no GL_PIXEL_UNPACK_BUFFER is
+        //    bound and _pixels_ is null.
+        //
+        // 2) texImage3D and texSubImage3D generate INVALID_OPERATION if:
+        //      GL_UNPACK_SKIP_PIXELS + width > DataStoreWidth
+        //      GL_UNPACK_SKIP_ROWS + height > DataStoreHeight
+        //    except for texImage3D if no GL_PIXEL_UNPACK_BUFFER is
+        //    bound and _pixels_ is null.
+        if (!pixelUnpackBuffer && !pixels && !isSubImage)
+        {
+            // Exception case for texImage2D or texImage3D, above.
+        }
+        else
+        {
+            GLint dataStoreWidth = unpack.rowLength ? unpack.rowLength : width;
+            if (unpack.skipPixels + width > dataStoreWidth)
+            {
+                ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kInvalidUnpackParametersForWebGL);
+                return false;
+            }
+            if (texType == TextureType::_3D || texType == TextureType::_2DArray)
+            {
+                // Note that CubeMapArray is not supported as a texture target in WebGL.
+                GLint dataStoreHeight = unpack.imageHeight ? unpack.imageHeight : height;
+                if (unpack.skipRows + height > dataStoreHeight)
+                {
+                    ANGLE_VALIDATION_ERROR(GL_INVALID_OPERATION, kInvalidUnpackParametersForWebGL);
+                    return false;
+                }
+            }
+        }
+    }
+
     return true;
 }
 
