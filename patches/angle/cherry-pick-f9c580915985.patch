From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shahbaz Youssefi <syoussefi@chromium.org>
Date: Wed, 2 Sep 2026 15:16:44 -0400
Subject: Fix robust-init when OOB-copying between mips of same texture

The front-end has logic to initialize the destination texture when the
target of glCopyTexImage2D is out of bounds of the source framebuffer.
However, this is skipped during self-copies as the initialization would
destroy source(==destination)'s content before the copy.

This self-copy check is improved in this change to exclude copies
between different subresources of the same texture.

Bug: chromium:550302121
Change-Id: I565ea820d49ea8d37910247b03729468280509f0
Reviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/8347448
Reviewed-by: Geoff Lang <geofflang@chromium.org>
Commit-Queue: Shahbaz Youssefi <syoussefi@chromium.org>

Electron adaptation notes (43-x-y):
Caps.h: context drift only (squarePvrtc1 feature present on the branch).
angle_end2end_tests_expectations.txt kept as on the branch (test-only).

diff --git a/src/libANGLE/Caps.h b/src/libANGLE/Caps.h
index 1bfa827e240447a5db2f4f1ccf82b51f093fcbd0..69f001fb4ec48ce06da360b54bf08b88cb00df07 100644
--- a/src/libANGLE/Caps.h
+++ b/src/libANGLE/Caps.h
@@ -148,6 +148,10 @@ struct Limitations
     // PVRTC1 textures must be squares.
     bool squarePvrtc1 = false;
 
+    // Some backends don't apply robust init when glCopyTexImage2D reads out of bounds of source
+    // framebuffer, whose read attachment is a different mip of the same texture being redefined.
+    bool noRobustInitOnOOBCopyTexImageSameTexture = false;
+
     // ETC1 texture support is emulated.
     bool emulatedEtc1 = false;
 
diff --git a/src/libANGLE/Texture.cpp b/src/libANGLE/Texture.cpp
index 631c85c9322db2f774be3d1e9ad281fd71f45519..3888e7840ee8f9509092778a64012f2fd8eadab0 100644
--- a/src/libANGLE/Texture.cpp
+++ b/src/libANGLE/Texture.cpp
@@ -1584,11 +1584,15 @@ angle::Result Texture::copyImage(Context *context,
         const FramebufferAttachment *sourceReadAttachment = source->getReadColorAttachment();
         Extents fbSize                                    = sourceReadAttachment->getSize();
         // Force using copySubImage when the source area is out of bounds AND
-        // we're not copying to and from the same texture
-        forceCopySubImage = ((sourceArea.x < 0) || (sourceArea.y < 0) ||
-                             ((sourceArea.x + sourceArea.width) > fbSize.width) ||
-                             ((sourceArea.y + sourceArea.height) > fbSize.height)) &&
-                            (sourceReadAttachment->getResource() != this);
+        // we're not copying to and from the same texture.  When
+        // noRobustInitOnOOBCopyTexImageSameTexture is set, copySubImage is used also when copying
+        // between different subresources of the same texture.
+        forceCopySubImage = (sourceArea.x < 0 || sourceArea.y < 0 ||
+                             sourceArea.x + sourceArea.width > fbSize.width ||
+                             sourceArea.y + sourceArea.height > fbSize.height) &&
+                            (sourceReadAttachment->getResource() != this ||
+                             (context->getLimitations().noRobustInitOnOOBCopyTexImageSameTexture &&
+                              sourceReadAttachment->getTextureImageIndex() != index));
         Rectangle clippedArea;
         if (ClipRectangle(sourceArea, Rectangle(0, 0, fbSize.width, fbSize.height), &clippedArea))
         {
diff --git a/src/libANGLE/renderer/vulkan/vk_caps_utils.cpp b/src/libANGLE/renderer/vulkan/vk_caps_utils.cpp
index f5de86123d2576f2a4d62b211187bb7ee25cb618..c236166d662ac5851c5811c89f0cf835bcda1c2a 100644
--- a/src/libANGLE/renderer/vulkan/vk_caps_utils.cpp
+++ b/src/libANGLE/renderer/vulkan/vk_caps_utils.cpp
@@ -1518,6 +1518,10 @@ void Renderer::ensureCapsInitialized() const
     mNativeLimitations.maxBufferBytes  = static_cast<size_t>(mMaxMemoryAllocationSize);
     mNativeLimitations.maxTextureBytes = static_cast<size_t>(mMaxMemoryAllocationSize);
 
+    // Ask the front-end to handle robust-init when copying between mips of the same texture via
+    // glCopyTexImage2D.
+    mNativeLimitations.noRobustInitOnOOBCopyTexImageSameTexture = true;
+
     // Log any missing extensions required for GLES 3.2.
     LogMissingExtensionsForGLES32(mNativeExtensions);
 }
