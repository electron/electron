         }
         else
         {
-            *mapPtr = syncAndObtainShadowCopy(contextMtl, offset, length).data();
+            ptr = syncAndObtainShadowCopy(contextMtl, offset, length).data();
         }
+        ANGLE_TRY(contextMtl->checkCommandBufferError());
+        *mapPtr = ptr;
     }
 
     return angle::Result::Continue;
