     if (mapPtr)
     {
         ContextMtl *contextMtl = mtl::GetImpl(context);
+        uint8_t *ptr           = nullptr;
         if (mShadowCopy.size() == 0)
         {
-            *mapPtr = mBuffer
-                          ->mapWithOpt(contextMtl, (access & GL_MAP_WRITE_BIT) == 0,
-                                       access & GL_MAP_UNSYNCHRONIZED_BIT, offset, length)
-                          .data();
+            ptr = mBuffer
+                      ->mapWithOpt(contextMtl, (access & GL_MAP_WRITE_BIT) == 0,
