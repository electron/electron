@@ -24184,6 +24184,40 @@ TEST_P(GLSLTest_ES3, DynamicWriteStaticReadVaryingArray)
     // (Note: 565 with no alpha, glReadPixels will pad alpha to 255).
     EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::white);
