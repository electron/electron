From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ran Wang <wangra@google.com>
Date: Thu, 17 Sep 2026 12:51:43 -0400
Subject: D3D11: Do not sync incomplete texture images from storage

Only sync image staging memory from render target storage when the
image index is valid and complete, avoiding uninitialized memory
imports. Also remove unused hasDirtyImages().

Test:
    angle_end2end_tests --gtest_filter="IncompleteLevelDoesNotSyncFromStorage"
Bug: b/561613775
Change-Id: I3fd62c57271dd80af91a06861b0c7dd43b77f87d
Reviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/8423401
Reviewed-by: Geoff Lang <geofflang@chromium.org>
Commit-Queue: Ran Wang <wangra@google.com>
Reviewed-by: Shahbaz Youssefi <syoussefi@chromium.org>

diff --git a/src/libANGLE/renderer/d3d/TextureD3D.cpp b/src/libANGLE/renderer/d3d/TextureD3D.cpp
index c70c4abb2ebcc9d1b26c277c220750ca2083f423..2318957f12ada484168cc750c07d03eba1541d53 100644
--- a/src/libANGLE/renderer/d3d/TextureD3D.cpp
+++ b/src/libANGLE/renderer/d3d/TextureD3D.cpp
@@ -189,12 +189,12 @@ angle::Result TextureD3D::getImageAndSyncFromStorage(const gl::Context *context,
                                                      ImageD3D **outImage)
 {
     ImageD3D *image = getImage(index);
-    if (mTexStorage && mTexStorage->isRenderTarget())
+    if (mTexStorage && mTexStorage->isRenderTarget() && isValidIndex(index) &&
+        isImageComplete(index))
     {
         ANGLE_TRY(image->copyFromTexStorage(context, index, mTexStorage));
-        mDirtyImages = true;
+        image->markClean();
     }
-    image->markClean();
     *outImage = image;
     return angle::Result::Continue;
 }
diff --git a/src/libANGLE/renderer/d3d/TextureD3D.h b/src/libANGLE/renderer/d3d/TextureD3D.h
