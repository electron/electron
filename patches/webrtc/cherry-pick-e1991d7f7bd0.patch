Electron adaptation notes (42-x-y): PeerConnection::OnTransportChanged() on
this branch checks internal->HasChannel() and calls
SetChannelRtpTransport() (renamed SetRtpTransport() upstream); the MID
comparison is switched to channel_mid() while keeping those branch names.
Test-only hunks in sdp_offer_answer_unittest.cc were dropped.

diff --git a/pc/peer_connection.cc b/pc/peer_connection.cc
index 75b0b0ee38c2aea4fa33b6584ce512be95822e3a..6269306e819334c2919eb75597abef437806c0a9 100644
--- a/pc/peer_connection.cc
+++ b/pc/peer_connection.cc
@@ -3080,7 +3080,10 @@ bool PeerConnection::OnTransportChanged(
     for (const auto& transceiver :
          rtp_manager()->transceivers()->UnsafeList()) {
       auto internal = transceiver->internal();
-      if (internal->HasChannel() && internal->mid() == mid) {
+      // Match on the MID that the channel was created for rather than on the
+      // transceiver's current MID. The channel is bound to the transport of
+      // that MID and must be notified when that transport changes.
+      if (internal->HasChannel() && internal->channel_mid() == mid) {
         ret = internal->SetChannelRtpTransport(rtp_transport);
       }
     }
