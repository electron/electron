--- a/src/fcint.h
+++ b/src/fcint.h
@@ -599,6 +599,7 @@ struct _FcConfig {
      * match preferrentially
      */
     FcFontSet *fonts[FcSetApplication + 1];
+    FcRwLock   fonts_lock;
     /*
      * Fontconfig can periodically rescan the system configuration
      * and font directories.  This rescanning occurs when font
diff --git a/src/fclist.c b/src/fclist.c
index 50d79cd206468ee4c1e3be52df6b1d9b6ddaef12..1f714171317d7a0a1545016369faa52707c038ff 100644
--- a/src/fclist.c
+++ b/src/fclist.c
@@ -564,12 +564,14 @@ FcFontList (FcConfig    *config,
     config = FcConfigReference (config);
     if (!config)
 	return NULL;
+    FcRwLockReadLock (&config->fonts_lock);
     nsets = 0;
     if (config->fonts[FcSetSystem])
 	sets[nsets++] = config->fonts[FcSetSystem];
     if (config->fonts[FcSetApplication])
 	sets[nsets++] = config->fonts[FcSetApplication];
     ret = FcFontSetList (config, sets, nsets, p, os);
+    FcRwLockUnlockRead (&config->fonts_lock);
     FcConfigDestroy (config);
 
     return ret;
diff --git a/src/fcmatch.c b/src/fcmatch.c
index 14fbefb918f06c004466eb73b13aa423b7f4d73b..890025dddec065aeb9f2f676e59e34df2cd4dbde 100644
--- a/src/fcmatch.c
+++ b/src/fcmatch.c
