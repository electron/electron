From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Dominik=20R=C3=B6ttsches?= <drott@chromium.org>
Date: Fri, 4 Sep 2026 12:01:38 +0300
Subject: Synchronize font set access with FcRwLock

Add fonts_lock to struct _FcConfig and use reader-writer locking
to synchronize concurrent reads and writes to config->fonts.

Reader lock is acquired during font matching, sorting, and listing
(FcFontMatch, FcFontSort, FcFontList), while writer lock is acquired
when modifying font sets (FcConfigAppFontAddFile, FcConfigAppFontAddDir,
FcConfigAppFontClear, FcConfigSetFonts, FcConfigBuildFonts).

Note that this change does not address the MT unsafety of FcConfigGetFonts.
FcConfigGetFonts returns an internal pointer to config->fonts[set], which
cannot be made thread-safe without external synchronization as long as
callers access the returned FcFontSet after the lock is released.
Acquiring the lock only during the pointer read would give a false sense
of security. It remains documented as not MT-safe in doc/fcconfig.fncs.

Changelog: fixed

Electron adaptation notes (44-x-y):
The pinned fontconfig (b707078e) predates the appFonts bookkeeping and
the FcFileScanFontFile split, so FcConfigAppFontAddFile still scans with
FcFileScanConfig and then recurses into FcConfigAppFontAddDir for any
subdirectories. The write lock is therefore released after the scan and
before that recursion (FcConfigAppFontAddDir acquires the lock itself),
instead of being held until the common bail label. The
FcStrSetDeleteAll(config->appFonts) line in FcConfigAppFontClear has no
counterpart on this version and is omitted. Locking semantics are
otherwise unchanged: every mutation of config->fonts happens under the
write lock and FcFontMatch/FcFontSort/FcFontList take the read lock.

(cherry picked from commit 8e9585bc5e763ced51c6c09b6b2e21645a947c34)

diff --git a/src/fccfg.c b/src/fccfg.c
index 7bca51e2b1c218bb61b2ebf737d65dec99ab9390..ae7625b86f7aada1bf56db96263ceb0e3ac434c9 100644
--- a/src/fccfg.c
+++ b/src/fccfg.c
@@ -193,6 +193,7 @@ FcConfigCreate (void)
     config->maxObjects = 0;
     for (set = FcSetSystem; set <= FcSetApplication; set++)
 	config->fonts[set] = 0;
+    FcRwLockInit (&config->fonts_lock);
 
     config->rescanTime = time (0);
     config->rescanInterval = 30;
@@ -410,6 +411,8 @@ FcConfigDestroy (FcConfig *config)
 	if (config->desktop_name)
 	    FcStrFree (config->desktop_name);
 
+	FcRwLockFinish (&config->fonts_lock);
+
 	free (config);
     }
 }
@@ -541,6 +544,16 @@ FcConfigAddDirList (FcConfig *config, FcSetName set, FcStrSet *dirSet)
  * and build the set of available fonts.
  */
 
+static void
+FcConfigSetFontsLocked (FcConfig  *config,
+                        FcFontSet *fonts,
+                        FcSetName  set)
+{
+    if (config->fonts[set])
+	FcFontSetDestroy (config->fonts[set]);
+    config->fonts[set] = fonts;
+}
+
 FcBool
 FcConfigBuildFonts (FcConfig *config)
 {
@@ -557,14 +570,17 @@ FcConfigBuildFonts (FcConfig *config)
 	goto bail;
     }
 
-    FcConfigSetFonts (config, fonts, FcSetSystem);
+    FcRwLockWriteLock (&config->fonts_lock);
+    FcConfigSetFontsLocked (config, fonts, FcSetSystem);
 
     if (!FcConfigAddDirList (config, FcSetSystem, config->fontDirs)) {
 	ret = FcFalse;
-	goto bail;
+	goto bail_unlock;
     }
     if (FcDebug() & FC_DBG_FONTSET)
 	FcFontSetPrint (fonts);
+bail_unlock:
+    FcRwLockUnlockWrite (&config->fonts_lock);
 bail:
     FcConfigDestroy (config);
 
@@ -798,6 +814,14 @@ FcConfigGetCache (FcConfig *config FC_UNUSED)
     return NULL;
 }
 
+/*
+ * Note: this function is not thread-safe as documented in doc/fcconfig.fncs.
+ * It returns an internal pointer to config->fonts[set], which cannot be safely
+ * accessed without external synchronization if other threads may concurrently
+ * modify font sets (e.g. via FcConfigAppFontAdd* or FcConfigAppFontClear).
+ * Acquiring fonts_lock only during the pointer read would not protect callers
+ * after this function returns.
+ */
 FcFontSet *
 FcConfigGetFonts (FcConfig *config,
                   FcSetName set)
@@ -815,9 +839,9 @@ FcConfigSetFonts (FcConfig  *config,
                   FcFontSet *fonts,
                   FcSetName  set)
 {
-    if (config->fonts[set])
-	FcFontSetDestroy (config->fonts[set]);
-    config->fonts[set] = fonts;
+    FcRwLockWriteLock (&config->fonts_lock);
+    FcConfigSetFontsLocked (config, fonts, set);
+    FcRwLockUnlockWrite (&config->fonts_lock);
 }
 
 FcConfig *
@@ -2732,22 +2756,29 @@ FcConfigAppFontAddFile (FcConfig      *config,
 	goto bail;
     }
 
-    set = FcConfigGetFonts (config, FcSetApplication);
+    FcRwLockWriteLock (&config->fonts_lock);
+
+    set = config->fonts[FcSetApplication];
     if (!set) {
 	set = FcFontSetCreate();
 	if (!set) {
 	    FcStrSetDestroy (subdirs);
 	    ret = FcFalse;
-	    goto bail;
+	    goto bail_unlock;
 	}
-	FcConfigSetFonts (config, set, FcSetApplication);
+	FcConfigSetFontsLocked (config, set, FcSetApplication);
     }
 
     if (!FcFileScanConfig (set, subdirs, file, config)) {
 	FcStrSetDestroy (subdirs);
 	ret = FcFalse;
-	goto bail;
+	goto bail_unlock;
     }
+    /*
+     * FcConfigAppFontAddDir takes the write lock itself, so release it
+     * before recursing into the scanned subdirectories.
+     */
+    FcRwLockUnlockWrite (&config->fonts_lock);
     if ((sublist = FcStrListCreate (subdirs))) {
 	while ((subdir = FcStrListNext (sublist))) {
 	    FcConfigAppFontAddDir (config, subdir);
@@ -2755,6 +2786,9 @@ FcConfigAppFontAddFile (FcConfig      *config,
 	FcStrListDone (sublist);
     }
     FcStrSetDestroy (subdirs);
+    goto bail;
+bail_unlock:
+    FcRwLockUnlockWrite (&config->fonts_lock);
 bail:
     FcConfigDestroy (config);
 
@@ -2779,15 +2813,17 @@ FcConfigAppFontAddDir (FcConfig      *config,
 	goto bail;
     }
 
-    set = FcConfigGetFonts (config, FcSetApplication);
+    FcRwLockWriteLock (&config->fonts_lock);
+
+    set = config->fonts[FcSetApplication];
     if (!set) {
 	set = FcFontSetCreate();
 	if (!set) {
 	    FcStrSetDestroy (dirs);
 	    ret = FcFalse;
-	    goto bail;
+	    goto bail_unlock;
 	}
-	FcConfigSetFonts (config, set, FcSetApplication);
+	FcConfigSetFontsLocked (config, set, FcSetApplication);
     }
 
     FcStrSetAddFilename (dirs, dir);
@@ -2795,9 +2831,11 @@ FcConfigAppFontAddDir (FcConfig      *config,
     if (!FcConfigAddDirList (config, FcSetApplication, dirs)) {
 	FcStrSetDestroy (dirs);
 	ret = FcFalse;
-	goto bail;
+	goto bail_unlock;
     }
     FcStrSetDestroy (dirs);
+bail_unlock:
+    FcRwLockUnlockWrite (&config->fonts_lock);
 bail:
     FcConfigDestroy (config);
 
@@ -2811,7 +2849,9 @@ FcConfigAppFontClear (FcConfig *config)
     if (!config)
 	return;
 
-    FcConfigSetFonts (config, 0, FcSetApplication);
+    FcRwLockWriteLock (&config->fonts_lock);
+    FcConfigSetFontsLocked (config, 0, FcSetApplication);
+    FcRwLockUnlockWrite (&config->fonts_lock);
 
     FcConfigDestroy (config);
 }
diff --git a/src/fcint.h b/src/fcint.h
index 59a8e1ffb44c0dc9cf551266fb783397a2467f33..7218204d7087f9b92d1a80d8716d56634b9ec272 100644
--- a/src/fcint.h
+++ b/src/fcint.h
@@ -600,6 +600,7 @@ struct _FcConfig {
      * match preferrentially
      */
     FcFontSet *fonts[FcSetApplication + 1];
+    FcRwLock   fonts_lock;
     /*
      * Fontconfig can periodically rescan the system configuration
      * and font directories.  This rescanning occurs when font
diff --git a/src/fclist.c b/src/fclist.c
index 50d79cd206468ee4c1e3be52df6b1d9b6ddaef12..1f714171317d7a0a1545016369faa52707c038ff 100644
--- a/src/fclist.c
+++ b/src/fclist.c
@@ -564,12 +564,14 @@ FcFontList (FcConfig    *config,
     config = FcConfigReference (config);
     if (!config)
 	return NULL;
+    FcRwLockReadLock (&config->fonts_lock);
     nsets = 0;
     if (config->fonts[FcSetSystem])
 	sets[nsets++] = config->fonts[FcSetSystem];
     if (config->fonts[FcSetApplication])
 	sets[nsets++] = config->fonts[FcSetApplication];
     ret = FcFontSetList (config, sets, nsets, p, os);
+    FcRwLockUnlockRead (&config->fonts_lock);
     FcConfigDestroy (config);
 
     return ret;
diff --git a/src/fcmatch.c b/src/fcmatch.c
index 1adbbdc2f079570a04f71547028dd6ed4262eb36..3a2915467ba6499435a6be9589ed81125ff5118b 100644
--- a/src/fcmatch.c
+++ b/src/fcmatch.c
@@ -1037,6 +1037,7 @@ FcFontMatch (FcConfig  *config,
     config = FcConfigReference (config);
     if (!config)
 	return NULL;
+    FcRwLockReadLock (&config->fonts_lock);
     nsets = 0;
     if (config->fonts[FcSetSystem])
 	sets[nsets++] = config->fonts[FcSetSystem];
@@ -1044,6 +1045,7 @@ FcFontMatch (FcConfig  *config,
 	sets[nsets++] = config->fonts[FcSetApplication];
 
     best = FcFontSetMatchInternal (sets, nsets, p, result);
+    FcRwLockUnlockRead (&config->fonts_lock);
     if (best) {
 	ret = FcFontRenderPrepare (config, p, best);
 	FcPatternDestroy (best);
@@ -1349,12 +1351,14 @@ FcFontSort (FcConfig   *config,
     config = FcConfigReference (config);
     if (!config)
 	return NULL;
+    FcRwLockReadLock (&config->fonts_lock);
     nsets = 0;
     if (config->fonts[FcSetSystem])
 	sets[nsets++] = config->fonts[FcSetSystem];
     if (config->fonts[FcSetApplication])
 	sets[nsets++] = config->fonts[FcSetApplication];
     ret = FcFontSetSort (config, sets, nsets, p, trim, csp, result);
+    FcRwLockUnlockRead (&config->fonts_lock);
     FcConfigDestroy (config);
 
     return ret;
