index 70f47be960faec252c86db62c60c2bf9b537ebc1..a067ae5cb54bdab851f66ee7578a4cc5e3b0c56e 100644
--- a/base/files/file_util.h
+++ b/base/files/file_util.h
@@ -410,6 +410,19 @@ BASE_EXPORT FilePath GetHomeDir();
