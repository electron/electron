+++ b/third_party/blink/renderer/core/html/canvas/canvas_rendering_context.cc
@@ -90,7 +90,9 @@ void CanvasRenderingContext::Dispose() {
   // an error when CanvasRenderingContext::DidProcessTask() is invoked
   // after the HTMLCanvasElement is destroyed.
