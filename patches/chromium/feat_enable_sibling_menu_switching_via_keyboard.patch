index 492028cb2f3a590853aef537d62686a544064dca..2d076e418f8cd4d8832f696b75dcb3e613a0936a 100644
--- a/ui/views/controls/menu/menu_controller.cc
+++ b/ui/views/controls/menu/menu_controller.cc
@@ -2550,9 +2550,9 @@ bool MenuController::OnKeyPressed(const ui::KeyEvent& event) {
         break;
       }
       if (base::i18n::IsRTL()) {
