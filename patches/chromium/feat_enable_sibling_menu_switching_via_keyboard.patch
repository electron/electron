From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michaela Laurencin <mlaurencin@electronjs.org>
Date: Thu, 2 Jul 2026 20:32:59 -0400
Subject: feat: enable sibling menu switching via keyboard

Allow Left/Right arrow keys to move between adjacent top-level menus (e.g. an application menu bar)
while a menu is open, matching native platform behavior on Windows and Linux.
Adds MenuDelegate::SwitchToSiblingMenu, invoked from MenuController when the user presses
Left/Right at the top level with nothing to open or close in that direction.

diff --git a/ui/views/controls/menu/menu_controller.cc b/ui/views/controls/menu/menu_controller.cc
index 31d319ca34fd0f940e2bebe196794d9b01312d51..178df8b17f9ab6cf7e89ebfd160f0cb9e89cbea5 100644
--- a/ui/views/controls/menu/menu_controller.cc
+++ b/ui/views/controls/menu/menu_controller.cc
@@ -2069,9 +2069,9 @@ bool MenuController::OnKeyPressed(const ui::KeyEvent& event) {
         break;
       }
       if (base::i18n::IsRTL()) {
-        CloseSubmenu();
+        CloseSubmenuOrSwitchSiblingMenu();
       } else {
-        OpenSubmenuChangeSelectionIfCan();
+        OpenSubmenuOrSwitchSiblingMenu();
       }
       break;
 
@@ -2080,9 +2080,9 @@ bool MenuController::OnKeyPressed(const ui::KeyEvent& event) {
         break;
       }
       if (base::i18n::IsRTL()) {
-        OpenSubmenuChangeSelectionIfCan();
+        OpenSubmenuOrSwitchSiblingMenu();
       } else {
-        CloseSubmenu();
+        CloseSubmenuOrSwitchSiblingMenu();
       }
       break;
 
@@ -3431,6 +3431,52 @@ void MenuController::CloseSubmenu() {
   }
 }
 
+void MenuController::OpenSubmenuOrSwitchSiblingMenu() {
+  MenuItemView* const selected = pending_state_.item;
+  // If the selected item can open a submenu, open it as usual.
+  if (selected && selected->HasSubmenu() && selected->GetEnabled()) {
+    OpenSubmenuChangeSelectionIfCan();
+    return;
+  }
+  // Otherwise, only switch to the next sibling menu when the selection
+  // is a direct child of the root menu. Switching is not allowed from
+  // within a nested submenu.
+  const bool is_top_level_child =
+      selected && !selected->HasSubmenu() && selected->GetParentMenuItem() &&
+      !selected->GetParentMenuItem()->GetParentMenuItem();
+  if (is_top_level_child && selected->GetDelegate() &&
+      selected->GetDelegate()->SwitchToSiblingMenu(/*next=*/true)) {
+    return;
+  }
+  OpenSubmenuChangeSelectionIfCan();
+}
+
+void MenuController::CloseSubmenuOrSwitchSiblingMenu() {
+  MenuItemView* item = state_.item;
+  // If there is a submenu to close, close it as usual.
+  const bool can_close_submenu =
+      item && item->GetParentMenuItem() &&
+      (item->SubmenuIsShowing() ||
+       item->GetParentMenuItem()->GetParentMenuItem());
+  if (can_close_submenu) {
+    CloseSubmenu();
+    return;
+  }
+  // Otherwise, only switch to the previous sibling menu when the selection is a
+  // direct child of the root menu. Use pending_state_.item, not state_.item:
+  // keyboard selection of a submenu item defers the state_ commit, so state_
+  // may still point at the previously selected leaf.
+  MenuItemView* const selected = pending_state_.item;
+  const bool is_top_level_child =
+      selected && !selected->HasSubmenu() && selected->GetParentMenuItem() &&
+      !selected->GetParentMenuItem()->GetParentMenuItem();
+  if (is_top_level_child && selected->GetDelegate() &&
+      selected->GetDelegate()->SwitchToSiblingMenu(/*next=*/false)) {
+    return;
+  }
+  CloseSubmenu();
+}
+
 MenuController::SelectByCharDetails MenuController::FindChildForMnemonic(
     MenuItemView* parent,
     char16_t key,
diff --git a/ui/views/controls/menu/menu_controller.h b/ui/views/controls/menu/menu_controller.h
