@@ -4093,6 +4093,49 @@ void MenuController::CloseSubmenu() {
   SetSelection(item_to_select, SELECTION_UPDATE_IMMEDIATELY);
 }
 
+namespace {
+
+// Asks the delegate to switch to an adjacent top-level menu. Works from any
+// depth because GetDelegate() returns the root menu's delegate.
+bool RequestSiblingMenuSwitch(MenuItemView* const selected, const bool next) {
+  return selected && selected->GetDelegate() &&
+         selected->GetDelegate()->SwitchToSiblingMenu(next);
+}
+
+}  // namespace
+
+void MenuController::OpenSubmenuOrSwitchSiblingMenu() {
+  MenuItemView* const selected = pending_state_.item;
+  // Like native Win32 menu bars: open the selected item's submenu if it has an
+  // enabled one, otherwise switch to the next menu from any depth. The root,
+  // which is selected in a mouse-opened menu, already shows its submenu, so it
+  // switches too.
+  const bool can_open_submenu = selected && selected->GetParentMenuItem() &&
+                                selected->HasSubmenu() &&
+                                selected->GetEnabled();
+  if (can_open_submenu || !RequestSiblingMenuSwitch(selected, /*next=*/true)) {
+    OpenSubmenuChangeSelectionIfCan();
+  }
+}
+
+void MenuController::CloseSubmenuOrSwitchSiblingMenu() {
+  MenuItemView* item = state_.item;
+  // Use state_ here because CloseSubmenu() acts on state_.item, so this
+  // matches whether it has a submenu to close.
+  const bool can_close_submenu =
+      item && item->GetParentMenuItem() &&
+      (item->SubmenuIsShowing() ||
+       item->GetParentMenuItem()->GetParentMenuItem());
+  // Like native Win32 menu bars: close a nested submenu if there is one,
+  // otherwise switch to the previous menu, even if the selected item has a
+  // submenu that isn't open.
+  // Use pending_state_: keyboard selection may defer state_ updates.
+  if (can_close_submenu ||
+      !RequestSiblingMenuSwitch(pending_state_.item, /*next=*/false)) {
+    CloseSubmenu();
+  }
+}
+
 MenuController::SelectByCharDetails MenuController::FindChildForMnemonic(
     MenuItemView* parent,
     char16_t key,
