index 0ba76195469d1c0ed3ca7e70b23d51ca29e694f4..8355a7ff42296d6a00c64f34031271f5f99156a1 100644
--- a/ui/views/controls/menu/menu_delegate.h
+++ b/ui/views/controls/menu/menu_delegate.h
@@ -207,6 +207,13 @@ class VIEWS_EXPORT MenuDelegate {
                                        bool* has_mnemonics,
                                        MenuButton** button);
 
+  // Invoked when the user presses the left/right arrow keys in a menu (e.g. a
+  // drop-down from an application menu bar) and there is no submenu to open
+  // or close in that direction. |next| is true to switch to the next
+  // sibling menu and false for the previous one. Returns true if the delegate
+  // handled the request by switching menus.
+  virtual bool SwitchToSiblingMenu(bool next);
+
   // Returns the max width menus can grow to be.
   virtual int GetMaxWidthForMenu(MenuItemView* menu);
 
