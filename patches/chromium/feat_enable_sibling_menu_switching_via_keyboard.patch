   // If possible, closes the submenu.
   void CloseSubmenu();
 
+  // Like OpenSubmenuChangeSelectionIfCan(), but if the selected item has no
+  // enabled submenu to open, asks the delegate to switch to the next sibling
+  // menu, from any depth.
+  void OpenSubmenuOrSwitchSiblingMenu();
+
+  // Like CloseSubmenu(), but if there is no nested submenu to close, asks the
+  // delegate to switch to the previous sibling menu.
+  void CloseSubmenuOrSwitchSiblingMenu();
