   std::optional<mojom::TrustTokenOperationStatus> status_;
+  bool operation_failed_due_to_cross_origin_redirect_ = false;
   base::WeakPtrFactory<TrustTokenUrlLoaderInterceptor> weak_ptr_factory_{this};
 };
 
