+                              0x00, 0x00, 0xFF, 0xFF, 0x00, 0x00, 0xFF, 0xFF});
+
+  // Level 0: 64x64 (256 blocks = 4096 bytes) solid red.
+  constexpr int kLevel0Width = 64;
+  constexpr int kLevel0Height = 64;
