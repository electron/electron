diff --git a/third_party/blink/renderer/modules/accessibility/ax_object.cc b/third_party/blink/renderer/modules/accessibility/ax_object.cc
index 1f6f99636872776bf85fe3ffc66bcfaba1e85238..37991792ed034543e65fb778d411186fc3e88248 100644
--- a/third_party/blink/renderer/modules/accessibility/ax_object.cc
+++ b/third_party/blink/renderer/modules/accessibility/ax_object.cc
@@ -6934,6 +6934,12 @@ void AXObject::UpdateChildrenIfNecessary() {
     return;
   }
 
+  // A loop up the stack is walking children_. Leave them dirty, so a later call
+  // rebuilds them.
+  if (children_guarded_) {
+    return;
+  }
+
   if (AXObjectCache().IsFrozen()) {
     // TODO(crbug.com/500793607): Investigate and convert to CHECK.
     DCHECK(!AXObjectCache().IsFrozen())
@@ -6959,6 +6965,10 @@ void AXObject::UpdateChildrenIfNecessary() {
   }
 
   ClearChildren();
+  // Clearing the children can remove |this|.
+  if (IsDetached()) {
+    return;
+  }
   AddChildren();
   CHECK(!children_dirty_);
   CHECK(!child_cached_values_need_update_);
@@ -7110,8 +7120,14 @@ void AXObject::ClearChildren() {
       << this;
 #endif
 
+  // A loop up the stack is walking children_ to detach or remove them.
+  // Clearing them here would free the vector under that loop.
+  if (children_guarded_) {
+    return;
+  }
+
   // Detach included children from their parent (this).
-  for (const auto& child : children_) {
+  for (const auto& child : GuardedCachedChildrenIncludingIgnored()) {
     // Check parent first, as the child might be several levels down if there
     // are unincluded nodes in between, in which case the cached parent will
     // also be a descendant (unlike children_, parent_ does not skip levels).
@@ -7124,6 +7140,11 @@ void AXObject::ClearChildren() {
 
   children_.clear();
 
+  // Detaching the children can remove |this|.
+  if (IsDetached()) {
+    return;
+  }
+
   Node* node = GetNode();
   if (!node) {
     return;
diff --git a/third_party/blink/renderer/modules/accessibility/ax_object.h b/third_party/blink/renderer/modules/accessibility/ax_object.h
index 667aade5e8742e75135a4a161b2b255d89df1d3f..b529c18e89403be52f3794d36f443607892f08f4 100644
--- a/third_party/blink/renderer/modules/accessibility/ax_object.h
+++ b/third_party/blink/renderer/modules/accessibility/ax_object.h
@@ -34,6 +34,7 @@
 #include <ostream>
 #include <utility>
 
+#include "base/auto_reset.h"
 #include "base/containers/span.h"
 #include "base/dcheck_is_on.h"
 #include "base/gtest_prod_util.h"
@@ -1285,6 +1286,31 @@ class MODULES_EXPORT AXObject : public GarbageCollected<AXObject> {
     return children_;
   }
 
+  // Range adapter for `AXObject::children_`, sets `AXObject::children_guarded_`
+  // while alive to avoid re-entrant modification of `children_`.
+  class GuardedChildren {
+    STACK_ALLOCATED();
+
+   public:
+    explicit GuardedChildren(AXObject& object)
+        : children_(object.children_),
+          guarded_(&object.children_guarded_, true) {}
+
+    auto begin() const { return children_.begin(); }
+    auto end() const { return children_.end(); }
+
+   private:
+    const AXObjectVector& children_;
+    base::AutoReset<bool> guarded_;
+  };
+
+  // Like CachedChildrenIncludingIgnored(), but holds a reentrancy guard on this
+  // object for the loop, so nested calls can't clear or rebuild its children_
+  // while the loop runs.
+  GuardedChildren GuardedCachedChildrenIncludingIgnored() {
+    return GuardedChildren(*this);
+  }
+
   // Sets the parent AXObject directly. If the parent of this object is known,
   // this can be faster than using ComputeParent().
   void SetParent(AXObject* new_parent);
@@ -1588,6 +1614,8 @@ class MODULES_EXPORT AXObject : public GarbageCollected<AXObject> {
   // When true, actions may use more expensive layout-based computations.
   // e.g. DefaultActionVerb::kClickInHitTest.
   bool use_layout_based_action_ = false;
+  // While true children_ is being walked and must not be cleared or rebuilt.
+  bool children_guarded_ = false;
 
   // The final role, taking into account the ARIA role and native role.
   ax::mojom::blink::Role role_;
diff --git a/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc b/third_party/blink/renderer/modules/accessibility/ax_object_cache_impl.cc
