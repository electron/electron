From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Freed <masonf@chromium.org>
Date: Mon, 28 Sep 2026 12:03:11 -0700
Subject: Avoid stale entry reference in ReconstructTheActiveFormattingElements

HTMLConstructionSite::ReconstructTheActiveFormattingElements() held an
Entry& into active_formatting_elements_ across AttachOrFosterParent().
Because DOM insertion is synchronous, script executed during attachment
(e.g. via DOMFocusOut from fieldset child changes) can re-enter the
parser through document.write() and reallocate
active_formatting_elements_. The loop would then write through the
stale reference.

This CL updates ReconstructTheActiveFormattingElements() to avoid
holding references across AttachOrFosterParent(). It stores the
HTMLStackItem pointer before attachment and safely looks up the entry
again after attachment before calling ReplaceElement(). The loop is
also converted to check IndexOfFirstUnopenFormattingElement() on each
iteration so modifications made during re-entrancy are handled safely.

Fixed: 566136674,563673584
Change-Id: I30f0ff76deb6a0462c84d12e6db8a4f4bc1e5c96
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8469828
Reviewed-by: David Baron <dbaron@chromium.org>
Commit-Queue: Mason Freed <masonf@chromium.org>
Auto-Submit: Mason Freed <masonf@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1706325}

Electron adaptation notes (44-x-y):
On M152 ReconstructTheActiveFormattingElements() attaches the reconstructed
element with AttachLater(CurrentInsertionLocation(), ...) followed by
open_elements_.Push(); the AttachOrFosterParent() helper used by upstream
main does not exist on this branch, so those two statements replace the
single helper call. The while-loop structure, the avoidance of holding an
Entry reference across the attach, and the re-find/ReplaceElement logic
are unchanged from upstream. The upstream M152 merge attempt (CL 8508005)
was uploaded with unresolved conflict markers in this function.

diff --git a/third_party/blink/renderer/core/html/parser/html_construction_site.cc b/third_party/blink/renderer/core/html/parser/html_construction_site.cc
index 4aef66b121833221259b6a17cfa060d396ba0795..3e67a23962ed7baf41f40118814c8f10bafec064 100644
--- a/third_party/blink/renderer/core/html/parser/html_construction_site.cc
+++ b/third_party/blink/renderer/core/html/parser/html_construction_site.cc
@@ -1571,21 +1571,27 @@ bool HTMLConstructionSite::IndexOfFirstUnopenFormattingElement(
 
 void HTMLConstructionSite::ReconstructTheActiveFormattingElements() {
   unsigned first_unopen_element_index;
-  if (!IndexOfFirstUnopenFormattingElement(first_unopen_element_index)) {
-    return;
-  }
-
-  unsigned unopen_entry_index = first_unopen_element_index;
-  DCHECK_LT(unopen_entry_index, active_formatting_elements_.size());
-  for (; unopen_entry_index < active_formatting_elements_.size();
-       ++unopen_entry_index) {
-    HTMLFormattingElementList::Entry& unopened_entry =
-        active_formatting_elements_.at(unopen_entry_index);
-    HTMLStackItem* reconstructed =
-        CreateElementFromSavedToken(unopened_entry.StackItem());
+  while (IndexOfFirstUnopenFormattingElement(first_unopen_element_index)) {
+    HTMLStackItem* unopened_item =
+        active_formatting_elements_.at(first_unopen_element_index).StackItem();
+    HTMLStackItem* reconstructed = CreateElementFromSavedToken(unopened_item);
+    // Attaching the reconstructed element can execute script synchronously
+    // (e.g. via blur handlers on foster parenting), which might re-enter the
+    // parser and reallocate active_formatting_elements_. Avoid holding
+    // references to an HTMLFormattingElementList::Entry across the call and
+    // re-find the entry afterwards.
     AttachLater(CurrentInsertionLocation(), reconstructed->GetNode());
     open_elements_.Push(reconstructed);
-    unopened_entry.ReplaceElement(reconstructed);
+    if (first_unopen_element_index < active_formatting_elements_.size() &&
+        active_formatting_elements_.at(first_unopen_element_index)
+                .StackItem() == unopened_item) {
+      active_formatting_elements_.at(first_unopen_element_index)
+          .ReplaceElement(reconstructed);
+    } else if (HTMLFormattingElementList::Entry* entry =
+                   active_formatting_elements_.Find(
+                       unopened_item->GetElement())) {
+      entry->ReplaceElement(reconstructed);
+    }
   }
 }
 
diff --git a/third_party/blink/web_tests/wpt_internal/html/syntax/parsing/reconstruct-active-formatting-reentrant-document-write.html b/third_party/blink/web_tests/wpt_internal/html/syntax/parsing/reconstruct-active-formatting-reentrant-document-write.html
new file mode 100644
index 0000000000000000000000000000000000000000..5fab4ad594e70ae154827066631cda41d95a19ee
--- /dev/null
+++ b/third_party/blink/web_tests/wpt_internal/html/syntax/parsing/reconstruct-active-formatting-reentrant-document-write.html
@@ -0,0 +1,60 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://html.spec.whatwg.org/multipage/parsing.html#reconstruct-the-active-formatting-elements">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+
+<script>
+if (window.testRunner) {
+  testRunner.setWindowFocus(true);
+}
+
+function parseInIframe(t, html) {
+  const iframe = document.createElement("iframe");
+  document.documentElement.appendChild(iframe);
+  t.add_cleanup(() => iframe.remove());
+  return new Promise((resolve) => {
+    iframe.onload = () => resolve(iframe);
+    const doc = iframe.contentDocument;
+    doc.open();
+    doc.write(html);
+    doc.close();
+  });
+}
+
+promise_test(async (t) => {
+  const iframe = await parseInIframe(
+    t,
+    `<!DOCTYPE html>
+    <fieldset>
+      <legend><input id="inp"></legend>
+      <table>
+        <b>
+        <script>
+        window.focusOutFired = false;
+        const inp = document.getElementById("inp");
+        inp.addEventListener("focusout", () => {
+          window.focusOutFired = true;
+          let s = "";
+          for (let i = 0; i < 50; ++i) {
+            s += "<b a" + i + ">";
+          }
+          document.write(s);
+        }, { once: true });
+        window.focus();
+        inp.focus();
+        inp.disabled = true;
+        <\/script>
+        <tbody>
+        <img>
+      </table>
+    </fieldset>`,
+  );
+
+  const doc = iframe.contentDocument;
+  const win = iframe.contentWindow;
+  assert_true(win.focusOutFired, "focusout should have fired during foster-parented element attachment");
+  assert_equals(doc.querySelectorAll("[a0]").length, 1, "Injected formatting elements should not be duplicated");
+}, "ReconstructTheActiveFormattingElements reentrancy check, via document.write");
+</script>
