+  FILE_SYSTEM,
+  ELECTRON_FULLSCREEN,
+  HID,
+  OPEN_EXTERNAL,
+  SERIAL,
+  USB,
+  ELECTRON_LAST = USB,  // Always keep this at the end.
   NUM,
   MIN_VALUE = MIDI_SYSEX,
 };
