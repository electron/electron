+TEST_F(DedicatedWorkerTest,
+       NestedErrorEventFromMutedScriptSanitizedOnWorkerObject) {
+  // Script must run for the worker global scope to dispatch events.
+  StartWorker();
+  WaitUntilWorkerIsRunning();
+
+  base::RunLoop run_loop;
