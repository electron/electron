+  assert_equals(JSON.stringify(receivedMessages), JSON.stringify([
+    { frameId: 'child', type: 'pointerover', relatedTargetIsNull: true },
+    { frameId: 'child', type: 'pointerenter', relatedTargetIsNull: true },
