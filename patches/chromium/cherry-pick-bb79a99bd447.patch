+    { frameId: 'child', type: 'pointerleave', relatedTargetIsNull: true }
+  ]), 'receivedMessages should match expected child events');
+}, 'Parent to iframe: relatedTarget in outer document is iframe, inner document is null');
+
+promise_test(async t => {
