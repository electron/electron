+    "pointerout from outer-iframe,pointerleave from outer-iframe"
+  );
+
+  assert_equals(JSON.stringify(receivedMessages), JSON.stringify([
+    { frameId: 'deep', type: 'pointerover', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerenter', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerout', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerleave', relatedTargetIsNull: true }
+  ]), 'receivedMessages should match expected deep child events');
+}, 'Nested iframes: relatedTarget in outer document is outermost iframe, inner document is null');
+</script>
+</body>
