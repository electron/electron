+  }
+</style>
+<body>
+<button id="done">Done</button>
+<script>
+'use strict';
+
+const hostInfo = get_host_info();
+const REMOTE_ORIGIN = hostInfo.HTTP_REMOTE_ORIGIN;
+const REMOTE_ORIGIN_2 = hostInfo.HTTP_REMOTE_ORIGIN_WITH_DIFFERENT_PORT;
+const CHILD_PAGE = '/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html';
+
+let receivedMessages = [];
+window.addEventListener('message', e => {
+  if (e.data && e.data.source === 'boundary-event-test' && e.data.type !== 'child-ready') {
+    receivedMessages.push({
+      frameId: e.data.frameId,
+      type: e.data.type,
+      relatedTargetIsNull: e.data.relatedTargetIsNull
+    });
+  }
+});
+
+function loadChildFrame(iframe, src, readyFrameId) {
+  return new Promise(resolve => {
+    function onMsg(e) {
+      if (e.data && e.data.source === 'boundary-event-test' && e.data.type === 'child-ready' && e.data.frameId === readyFrameId) {
+        window.removeEventListener('message', onMsg);
+        resolve();
+      }
+    }
+    window.addEventListener('message', onMsg);
+    iframe.src = src;
+  });
+}
+
+async function tapDoneButton() {
+  const doneButton = document.getElementById('done');
+  const donePromise = new Promise(resolve => {
+    const onDone = () => {
+      doneButton.removeEventListener('pointerup', onDone);
+      doneButton.removeEventListener('click', onDone);
+      resolve();
+    };
+    doneButton.addEventListener('pointerup', onDone);
+    doneButton.addEventListener('click', onDone);
+  });
+  await new test_driver.Actions()
+    .addPointer('touchPointerDone', 'touch')
+    .pointerMove(0, 0, {origin: doneButton})
+    .pointerDown()
+    .pointerUp()
+    .send();
+  await donePromise;
+}
+
+promise_test(async t => {
+  receivedMessages = [];
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  t.add_cleanup(() => container.remove());
+
+  const parentTarget = document.createElement('div');
+  parentTarget.id = 'parent-target';
+  parentTarget.className = 'target';
+  container.appendChild(parentTarget);
+
+  const iframe = document.createElement('iframe');
+  iframe.id = 'iframe';
+  container.appendChild(iframe);
+
+  const childSrc = `${REMOTE_ORIGIN}${CHILD_PAGE}?frame_id=child&target_id=child-target`;
+  await loadChildFrame(iframe, childSrc, 'child');
+
+  let parentEvents = [];
+  parentTarget.addEventListener('pointerdown', e => {
+    e.target.releasePointerCapture(e.pointerId);
+  });
+  ['pointerout', 'pointerleave'].forEach(type => {
