+<!doctype html>
+<meta charset="utf-8">
+<title>Pointer boundary events across same-origin documents (tentative)</title>
+<!--
+
+Issue: https://github.com/w3c/pointerevents/issues/656
+
+This test is tentative because I'm not sure whether it's the correct behavior.
+It's possible that cross-document should be treated the same as cross-origin.
+
+pointerevent_boundary_events_cross_origin.html tests that the cross-origin
+cases do not expose the true relatedTarget node (which is required for
+security).  This test tests that the same-origin but cross-document cases do
+expose the relatedTarget node.
+
+-->
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script src="/resources/testdriver.js"></script>
+<script src="/resources/testdriver-actions.js"></script>
+<script src="/resources/testdriver-vendor.js"></script>
+<style>
+  html, body {
+    margin: 0;
+    padding: 0;
+    touch-action: none;
+  }
+  .target {
+    width: 100px;
+    height: 100px;
+    background: blue;
+    touch-action: none;
+  }
+  iframe {
+    width: 100px;
+    height: 100px;
+    border: none;
+    display: block;
+  }
+  #done {
+    display: block;
+    margin-top: 10px;
+    touch-action: none;
+  }
+</style>
+<body>
+<button id="done">Done</button>
+<script>
+'use strict';
+
+function loadIframe(iframe) {
+  return new Promise(resolve => {
+    iframe.srcdoc = `<!doctype html>
+      <style>
+        html, body { margin: 0; padding: 0; touch-action: none; }
+        #child-target { width: 100px; height: 100px; background: green; touch-action: none; }
+      </style>
+      <div id="child-target"></div>`;
+    iframe.onload = resolve;
+  });
+}
+
+async function tapDoneButton() {
+  const doneButton = document.getElementById('done');
+  const donePromise = new Promise(resolve => {
+    const onDone = () => {
+      doneButton.removeEventListener('pointerup', onDone);
+      doneButton.removeEventListener('click', onDone);
+      resolve();
+    };
+    doneButton.addEventListener('pointerup', onDone);
+    doneButton.addEventListener('click', onDone);
+  });
+  await new test_driver.Actions()
+    .addPointer('touchPointerDone', 'touch')
+    .pointerMove(0, 0, {origin: doneButton})
+    .pointerDown()
+    .pointerUp()
+    .send();
+  await donePromise;
+}
+
+promise_test(async t => {
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  t.add_cleanup(() => container.remove());
+
+  const parentTarget = document.createElement('div');
+  parentTarget.id = 'parent-target';
+  parentTarget.className = 'target';
+  container.appendChild(parentTarget);
+
+  const iframe = document.createElement('iframe');
+  iframe.id = 'iframe';
+  container.appendChild(iframe);
+
+  await loadIframe(iframe);
+  const childDoc = iframe.contentDocument;
+  const childTarget = childDoc.getElementById('child-target');
+
+  let parentEvents = [];
+  let childEvents = [];
+
+  parentTarget.addEventListener('pointerdown', e => {
+    e.target.releasePointerCapture(e.pointerId);
+  });
+  parentTarget.addEventListener('pointerout', e => {
+    parentEvents.push({ type: e.type, relatedTarget: e.relatedTarget });
+  });
+  parentTarget.addEventListener('pointerleave', e => {
+    parentEvents.push({ type: e.type, relatedTarget: e.relatedTarget });
+  });
+
+  childTarget.addEventListener('pointerover', e => {
+    childEvents.push({ type: e.type, relatedTarget: e.relatedTarget });
+  });
+  childTarget.addEventListener('pointerenter', e => {
+    childEvents.push({ type: e.type, relatedTarget: e.relatedTarget });
+  });
+
+  await new test_driver.Actions()
+    .addPointer('touchPointer', 'touch')
+    .pointerMove(0, 0, {origin: parentTarget})
+    .pointerDown()
+    .pointerMove(0, 0, {origin: iframe})
+    .pointerUp()
+    .send();
+
+  await tapDoneButton();
+
+  assert_equals(
+    parentEvents.map(e => `${e.type} from ${e.relatedTarget.id}`).join(),
+    "pointerout from child-target,pointerleave from child-target"
+  );
+
+  assert_equals(
+    childEvents.map(e => `${e.type} from ${e.relatedTarget.id}`).join(),
+    "pointerover from parent-target,pointerenter from parent-target"
+  );
+}, 'Parent to same-origin iframe: relatedTarget is exposed across documents');
