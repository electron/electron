diff --git a/device/base/device_monitor_win_unittest.cc b/device/base/device_monitor_win_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7f7a0a8693b3b526883e185dba6e38610840ea5e
--- /dev/null
+++ b/device/base/device_monitor_win_unittest.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/base/device_monitor_win.h"
+
+#include <memory>
+
+#include "base/scoped_observation.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace device {
+
+namespace {
+
+// Observer that, like SerialDeviceEnumeratorWin's UI thread helper, may
+// outlive the monitor it observes and stops observing when told the monitor is
+// going away.
+class TestObserver : public DeviceMonitorWin::Observer {
+ public:
+  void Observe(DeviceMonitorWin* monitor) { observation_.Observe(monitor); }
+
+  bool IsObserving() const { return observation_.IsObserving(); }
+  int destroying_count() const { return destroying_count_; }
+
+  // DeviceMonitorWin::Observer:
+  void OnDeviceMonitorDestroying(DeviceMonitorWin* monitor) override {
+    ++destroying_count_;
+    EXPECT_TRUE(observation_.IsObservingSource(monitor));
+    observation_.Reset();
+  }
+
+ private:
+  int destroying_count_ = 0;
+  base::ScopedObservation<DeviceMonitorWin, DeviceMonitorWin::Observer>
+      observation_{this};
+};
+
+}  // namespace
+
+// Destroying a DeviceMonitorWin must notify its observers so that they can
+// stop observing it, rather than being left with a dangling pointer to it.
+// Without the notification, `observer1` and `observer2` would call
+// RemoveObserver() on the freed monitor when they are destroyed.
+TEST(DeviceMonitorWinTest, NotifiesObserversOnDestruction) {
+  TestObserver observer1;
+  TestObserver observer2;
+
+  std::unique_ptr<DeviceMonitorWin> monitor =
+      DeviceMonitorWin::CreateForTesting();
+  observer1.Observe(monitor.get());
+  observer2.Observe(monitor.get());
+  ASSERT_TRUE(observer1.IsObserving());
+  ASSERT_TRUE(observer2.IsObserving());
+
+  monitor.reset();
+
+  EXPECT_EQ(1, observer1.destroying_count());
+  EXPECT_FALSE(observer1.IsObserving());
+  EXPECT_EQ(1, observer2.destroying_count());
+  EXPECT_FALSE(observer2.IsObserving());
+}
+
+}  // namespace device
diff --git a/services/device/serial/serial_device_enumerator_win.cc b/services/device/serial/serial_device_enumerator_win.cc
index 62c92e4dde2d092b2d25a879d600093149b587f3..b46c8d161d7297a1deefc4a8b43ebfbd22d947cf 100644
--- a/services/device/serial/serial_device_enumerator_win.cc
+++ b/services/device/serial/serial_device_enumerator_win.cc
@@ -486,6 +486,16 @@ class SerialDeviceEnumeratorWin::UiThreadHelper
                                   enumerator_, device_path));
   }
 
+  void OnDeviceMonitorDestroying(DeviceMonitorWin* monitor) override {
+    // In the browser, DeviceService is destroyed after the ThreadPool has shut
+    // down, so the task that would delete the SerialPortManagerImpl that owns
+    // the enumerator (and in turn this helper) never runs. The helper is
+    // therefore still alive when an AtExitManager callback destroys
+    // `monitor`. By then the UI thread's task scheduler has been torn down, so
+    // `sequence_checker_` is not checked here.
+    device_observation_.Reset();
+  }
+
  private:
   SEQUENCE_CHECKER(sequence_checker_);
 
