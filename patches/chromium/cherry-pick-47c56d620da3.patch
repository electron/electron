+bool Env::IsLeftMouseButtonDown() const {
+  return input_state_lookup_.get()
+             ? input_state_lookup_->IsLeftMouseButtonDown()
+             : (mouse_button_flags_ & ui::EF_LEFT_MOUSE_BUTTON) != 0;
+}
