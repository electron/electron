Date: Fri, 16 Oct 2026 01:17:57 -0700
Subject: Stop all matching clients in `VideoCaptureController::StopSession`.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Previously, `VideoCaptureController::StopSession` used
`FindClient(session_id)`, which returned only the first
`ControllerClient` matching the session ID. If multiple clients were
registered under the same session ID with distinct controller IDs,
closing the session left the remaining clients open. While this is not
known to be a real problem under normal circumstances, this adds
additional security in the event that a Renderer process is compromised.

Update `StopSession` to iterate over all clients in
`controller_clients_` matching the given `session_id`, mark each as
`session_closed,` and notify its event handler via `OnEnded`.

Bug: chromium:561412049, chromium:514409956
Change-Id: Ic6545480236140796d5d5c1e73966dbbd194ba7a
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8579997
Reviewed-by: Guido Urdaneta <guidou@chromium.org>
Commit-Queue: Henrik Boström <hbos@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1720496}

diff --git a/content/browser/renderer_host/media/video_capture_controller.cc b/content/browser/renderer_host/media/video_capture_controller.cc
index 03d3f86df5437fd86ca05a02a1adfc56ac3eed53..821cee55739ee20ec1992bfb038d2ac0fa50dc04 100644
--- a/content/browser/renderer_host/media/video_capture_controller.cc
+++ b/content/browser/renderer_host/media/video_capture_controller.cc
@@ -393,11 +393,11 @@ void VideoCaptureController::StopSession(
                 << session_id;
   EmitLogMessage(string_stream.str(), 1);
 
-  ControllerClient* client = FindClient(session_id);
-
-  if (client) {
-    client->session_closed = true;
-    client->event_handler->OnEnded(client->controller_id);
+  for (const auto& client : controller_clients_) {
+    if (client->session_id == session_id && !client->session_closed) {
+      client->session_closed = true;
+      client->event_handler->OnEnded(client->controller_id);
+    }
   }
 }
 
@@ -822,15 +822,6 @@ VideoCaptureController::ControllerClient* VideoCaptureController::FindClient(
   return nullptr;
 }
 
-VideoCaptureController::ControllerClient* VideoCaptureController::FindClient(
-    const base::UnguessableToken& session_id) {
-  for (const auto& client : controller_clients_) {
-    if (client->session_id == session_id)
-      return client.get();
-  }
-  return nullptr;
-}
-
 std::vector<VideoCaptureController::BufferContext>::iterator
 VideoCaptureController::FindBufferContextFromBufferContextId(
     int buffer_context_id) {
