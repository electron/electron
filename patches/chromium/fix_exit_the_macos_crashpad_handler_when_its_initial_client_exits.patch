+//! \brief Stops an ExceptionHandlerServer when its initial client exits.
+//!
+//! The server normally stops once the last send right to its exception port
+//! has been deallocated, but task exception ports are inherited by every
+//! descendant of the client, so a long-lived grandchild (such as a shell or a
+//! daemon spawned by the client) keeps the handler alive long after the client
+//! itself has exited. This monitor watches the client with `kqueue()` and calls
+//! ExceptionHandlerServer::Stop() when it exits, matching the behavior of the
+//! Linux and Windows handlers, which exit along with their initial client.
+class InitialClientExitMonitor : public Thread {
+ public:
+  InitialClientExitMonitor(ExceptionHandlerServer* server, pid_t pid)
+      : Thread(), server_(server), pid_(pid), kqueue_(), started_(false) {}
+
+  InitialClientExitMonitor(const InitialClientExitMonitor&) = delete;
+  InitialClientExitMonitor& operator=(const InitialClientExitMonitor&) = delete;
+
+  ~InitialClientExitMonitor() { DCHECK(!started_); }
+
+  //! \brief Begins monitoring the initial client.
+  //!
+  //! If the client has already exited, the server is stopped right away and no
+  //! thread is started. If monitoring can’t be set up, a message is logged and
+  //! the server keeps its default lifetime.
+  void StartMonitoring() {
+    kqueue_.reset(kqueue());
+    if (!kqueue_.is_valid()) {
+      PLOG(WARNING) << "kqueue";
+      return;
+    }
+
+    // Registering with an empty event list reports failures through the return
+    // value and errno instead of through EV_ERROR entries.
+    struct kevent changes[2];
+    EV_SET(&changes[0],
+           static_cast<uintptr_t>(pid_),
+           EVFILT_PROC,
+           EV_ADD | EV_ONESHOT,
+           NOTE_EXIT,
+           0,
+           nullptr);
+    EV_SET(&changes[1],
+           kShutdownIdent,
+           EVFILT_USER,
+           EV_ADD | EV_CLEAR,
+           0,
+           0,
+           nullptr);
+    if (kevent(kqueue_.get(), changes, 2, nullptr, 0, nullptr) != 0) {
+      if (errno == ESRCH) {
+        LOG(INFO) << "initial client " << pid_ << " has already exited";
+        server_->Stop();
+      } else {
+        PLOG(WARNING) << "kevent";
+      }
+      kqueue_.reset();
+      return;
+    }
+
+    Start();
+    started_ = true;
+  }
+
+  //! \brief Stops monitoring and joins the monitor thread if it was started.
+  void StopMonitoring() {
+    if (!started_) {
+      return;
+    }
+
+    struct kevent change;
+    EV_SET(&change, kShutdownIdent, EVFILT_USER, 0, NOTE_TRIGGER, 0, nullptr);
+    PCHECK(kevent(kqueue_.get(), &change, 1, nullptr, 0, nullptr) == 0)
+        << "kevent";
+
+    Join();
+    started_ = false;
+  }
+
+ private:
+  static constexpr uintptr_t kShutdownIdent = 1;
+
+  // Thread:
+
+  void ThreadMain() override {
+    struct kevent event;
+    int rv =
+        HANDLE_EINTR(kevent(kqueue_.get(), nullptr, 0, &event, 1, nullptr));
+    if (rv < 0) {
+      PLOG(ERROR) << "kevent";
+      return;
+    }
+    if (rv != 1) {
+      LOG(ERROR) << "kevent: unexpected result " << rv;
+      return;
+    }
+
+    if (event.filter == EVFILT_PROC && (event.fflags & NOTE_EXIT)) {
+      server_->Stop();
+    }
+  }
+
+  ExceptionHandlerServer* server_;  // weak
+  pid_t pid_;
+  base::ScopedFD kqueue_;
+  bool started_;
+};
+
 }  // namespace
 
