-      promise_behavior, std::move(callback), script_injector_id);
+      promise_behavior, std::move(callback), std::move(raw_callback),
+      script_injector_id);
 }
 
 void LocalFrame::SetEvictCachedSessionStorageOnFreezeOrUnload() {
