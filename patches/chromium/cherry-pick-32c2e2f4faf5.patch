From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Freed <masonf@chromium.org>
Date: Thu, 22 Oct 2026 17:22:08 -0700
Subject: Copy ListedElements before iterating in ConstructEntryList

HTMLFormElement::ConstructEntryList and BuildSearchString iterate over
ListedElements() while calling AppendToFormData() on each control. For
<textarea>, AppendToFormData() forces a synchronous style and layout
update, which can mutate the DOM and clear listed_elements_ mid-loop.
Copy ListedElements() before iterating, matching HTMLFormElement::reset
and the HTML specification.

Also guard ImageInputType::EnsurePrimaryContent() with InStyleRecalc(),
matching ImageInputType::SetUseFallbackContent(), so synchronous cached
image completion during layout tree attachment does not mutate the UA
shadow tree during style recalc.

Fixed: 569286605
Change-Id: Ide74cfb742e8df43258883b11caf219e15d02d76
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8613243
Reviewed-by: David Baron <dbaron@chromium.org>
Auto-Submit: Mason Freed <masonf@chromium.org>
Commit-Queue: Mason Freed <masonf@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1725339}
(cherry picked from commit 32c2e2f4faf5f5c2caec109387500407924e52bc)

diff --git a/third_party/blink/renderer/core/exported/web_searchable_form_data.cc b/third_party/blink/renderer/core/exported/web_searchable_form_data.cc
index b8478b8e2c1f99ea8156fdc4db9a6273ef6cbb07..a345c565a7bce49fd8dbd01a0acbebf54ed760d0 100644
--- a/third_party/blink/renderer/core/exported/web_searchable_form_data.cc
+++ b/third_party/blink/renderer/core/exported/web_searchable_form_data.cc
@@ -186,7 +186,8 @@ bool BuildSearchString(const HTMLFormElement& form,
                        const TextEncoding& encoding,
                        const HTMLInputElement* text_element) {
   bool is_element_found = false;
-  for (ListedElement* item : form.ListedElements()) {
+  ListedElement::List elements(form.ListedElements());
+  for (ListedElement* item : elements) {
     auto* control = DynamicTo<HTMLFormControlElement>(item);
     if (!control)
       continue;
diff --git a/third_party/blink/renderer/core/html/forms/html_form_element.cc b/third_party/blink/renderer/core/html/forms/html_form_element.cc
index 10ca0a5407ba6d6d16e1b8be0399aac1f6e587cf..6093c76705fb428c4b5792cade9cfd772e64e10c 100644
--- a/third_party/blink/renderer/core/html/forms/html_form_element.cc
+++ b/third_party/blink/renderer/core/html/forms/html_form_element.cc
@@ -1023,6 +1023,7 @@ void HTMLFormElement::ScheduleFormSubmission(const Event* event,
       target_frame->ScheduleFormSubmission(scheduler, form_submission);
 }
 
+// https://html.spec.whatwg.org/multipage/#constructing-the-form-data-set
 FormData* HTMLFormElement::ConstructEntryList(Element* submitter,
                                               const TextEncoding& encoding) {
   if (is_constructing_entry_list_) {
@@ -1035,7 +1036,10 @@ FormData* HTMLFormElement::ConstructEntryList(Element* submitter,
     submitter->SetActivatedSubmit(true);
   }
 
-  for (ListedElement* control : ListedElements()) {
+  // Copy the element list because |AppendToFormData()| can update DOM
+  // structure.
+  ListedElement::List elements(ListedElements());
+  for (ListedElement* control : elements) {
     DCHECK(control);
     HTMLElement& element = control->ToHTMLElement();
     if (!element.IsDisabledFormControl())
diff --git a/third_party/blink/renderer/core/html/forms/image_input_type.cc b/third_party/blink/renderer/core/html/forms/image_input_type.cc
index 496634ffc9cb1e807cf4cb3c7bd422aa760a64b5..61bd1550df98edb1d217e8ff8f4228886d40e766 100644
--- a/third_party/blink/renderer/core/html/forms/image_input_type.cc
+++ b/third_party/blink/renderer/core/html/forms/image_input_type.cc
@@ -247,6 +247,9 @@ void ImageInputType::EnsurePrimaryContent() {
   if (!HasCreatedShadowSubtree()) {
     return;
   }
+  if (GetElement().GetDocument().InStyleRecalc()) {
+    return;
+  }
   if (ShadowRoot* root = GetElement().UserAgentShadowRoot())
     root->RemoveChildren();
   CreateShadowSubtree();
