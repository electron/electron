version (test-only). intersection_observer_test.cc applies as upstream.

diff --git a/third_party/blink/renderer/core/frame/frame_view.cc b/third_party/blink/renderer/core/frame/frame_view.cc
index 5a4990d7b2a5fb0f90cef9a605799200b648fe28..606a99573bf7fc60987a53613c4f1911fd982884 100644
--- a/third_party/blink/renderer/core/frame/frame_view.cc
+++ b/third_party/blink/renderer/core/frame/frame_view.cc
@@ -46,6 +46,15 @@ bool FrameView::CanThrottleRenderingForPropagation() const {
 
 bool FrameView::DisplayLockedInParentFrame() {
   Frame& frame = GetFrame();
+  // If the parent frame is display locked, then this frame does not get
+  // lifecycle updates either, regardless of whether the owner element has a
+  // layout object (e.g. if it is display:none).
+  if (Frame* parent_frame = frame.Tree().Parent()) {
+    if (FrameView* parent_view = parent_frame->View();
+        parent_view && parent_view->IsDisplayLocked()) {
+      return true;
+    }
+  }
   LayoutEmbeddedContent* owner = frame.OwnerLayoutObject();
   if (!owner)
     return false;
diff --git a/third_party/blink/renderer/core/intersection_observer/intersection_observer_test.cc b/third_party/blink/renderer/core/intersection_observer/intersection_observer_test.cc
index c7f4d5a453ae81c34db16b892ed72f4bee06d68b..0dad938b94b33d532b27480d27a3e5f62dad7373 100644
