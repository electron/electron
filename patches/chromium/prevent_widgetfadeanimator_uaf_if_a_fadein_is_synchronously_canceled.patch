From: Tommy Steimel <steimel@chromium.org>
Date: Thu, 17 Sep 2026 14:23:17 -0700
Subject: Prevent WidgetFadeAnimator UAF if a FadeIn is synchronously canceled

When showing a widget in WidgetFadeAnimator::FadeIn(), native visibility
notifications or observer callbacks can run synchronously. If an
observer destroys the animator or cancels the animation re-entrantly,
WidgetFadeAnimator continues executing on a freed or cancelled instance
once Show()/ShowInactive() returns, causing a UAF.

This CL:
1. Adds a base::WeakPtr check in WidgetFadeAnimator::FadeIn() after
   showing the widget, ensuring the animator is still alive and still
   fading in before accessing member state and starting the animation.
2. Moves `++fade_in_calls_count_` in
   PictureInPictureWidgetFadeAnimator::AnimateShowWindow() before the
   call to FadeIn() so that no member state is read if the animator
   was reset or destroyed during FadeIn().
3. Adds regression unit tests in widget_fade_animator_unittest and
   picture_in_picture_widget_fade_animator_unittest.

Bug: 562174487
Change-Id: Iade6bad08172099d5ea24dad2e2947474d1fc1e6
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8412520
Commit-Queue: Tommy Steimel <steimel@chromium.org>
Reviewed-by: Keren Zhu <kerenzhu@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1700133}

Electron adaptation notes (42-x-y):
WidgetFadeAnimator::FadeIn() has no SetBoundsForSliding() call on this
branch (slide support landed later), so that context line was dropped;
the weak_this check is inserted before fade_animation_.Start() as
upstream.

diff --git a/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator.cc b/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator.cc
index 4b0db5d91a024b7806e4b233c71a4ed7c9062f5a..896796d5ecac516f7f798c75d1489a9d34299f04 100644
--- a/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator.cc
+++ b/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator.cc
@@ -30,8 +30,8 @@ void PictureInPictureWidgetFadeAnimator::AnimateShowWindow(
   fade_animator_->set_fade_in_duration(base::Milliseconds(kFadeInDurationMs));
   fade_animator_->set_show_type(show_type);
 
-  fade_animator_->FadeIn();
   ++fade_in_calls_count_;
+  fade_animator_->FadeIn();
 }
 
 void PictureInPictureWidgetFadeAnimator::CancelAndReset() {
diff --git a/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator_unittest.cc b/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator_unittest.cc
index 2e3db6c4f47e1103efec8dd3e77d69b68aa7751a..63c9d865eb7620cceae187e9762b2cfb78906f86 100644
--- a/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator_unittest.cc
+++ b/chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator_unittest.cc
@@ -4,12 +4,14 @@
 
 #include "chrome/browser/picture_in_picture/picture_in_picture_widget_fade_animator.h"
 
+#include "base/memory/raw_ptr.h"
 #include "base/test/task_environment.h"
 #include "ui/compositor/layer.h"
 #include "ui/gfx/scoped_animation_duration_scale_mode.h"
 #include "ui/views/animation/widget_fade_animator.h"
 #include "ui/views/test/views_test_base.h"
 #include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
 
 namespace {
 
@@ -261,3 +263,38 @@ TEST_F(
       PictureInPictureWidgetFadeAnimator::WidgetShowType::kShowActive);
   EXPECT_EQ(1, fade_animator()->GetFadeInCallsCountForTesting());
 }
+
+namespace {
+
+class ResetAnimatorOnVisibilityChangeObserver : public views::WidgetObserver {
+ public:
+  explicit ResetAnimatorOnVisibilityChangeObserver(
+      PictureInPictureWidgetFadeAnimator* fade_animator)
+      : fade_animator_(fade_animator) {}
+
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override {
+    if (visible && fade_animator_) {
+      fade_animator_->CancelAndReset();
+    }
+  }
+
+ private:
+  raw_ptr<PictureInPictureWidgetFadeAnimator> fade_animator_;
+};
+
+}  // namespace
+
+TEST_F(PictureInPictureWidgetFadeAnimatorTest,
+       CancelAndResetDuringAnimateShowWindowDoesNotCrash) {
+  ResetAnimatorOnVisibilityChangeObserver observer(fade_animator());
+  widget()->AddObserver(&observer);
+
+  fade_animator()->AnimateShowWindow(
+      widget(),
+      PictureInPictureWidgetFadeAnimator::WidgetShowType::kShowInactive);
+
+  EXPECT_EQ(nullptr, fade_animator()->GetWidgetFadeAnimatorForTesting());
+  EXPECT_EQ(1, fade_animator()->GetFadeInCallsCountForTesting());
+
+  widget()->RemoveObserver(&observer);
+}
diff --git a/ui/views/animation/widget_fade_animator.cc b/ui/views/animation/widget_fade_animator.cc
index 66a9c14412db4bf11931ab9839eba04eacd2f0c2..c1452b1eb332da65caeafb5fc3858cac4b49fa8b 100644
--- a/ui/views/animation/widget_fade_animator.cc
+++ b/ui/views/animation/widget_fade_animator.cc
@@ -29,6 +29,7 @@ void WidgetFadeAnimator::FadeIn() {
   // Widgets cannot be shown when visible and fully transparent.
   widget_->SetOpacity(0.01f);
 
+  base::WeakPtr<WidgetFadeAnimator> weak_this = weak_factory_.GetWeakPtr();
   switch (show_type_) {
     case WidgetShowType::kNone:
       break;
@@ -40,6 +41,12 @@ void WidgetFadeAnimator::FadeIn() {
       break;
   }
 
+  // Showing the widget can synchronously invoke native or observer callbacks
+  // that might destroy this animator or cancel the animation.
+  if (!weak_this || !IsFadingIn()) {
+    return;
+  }
+
   fade_animation_.Start();
 }
 
