 #include "base/test/bind.h"
 #include "base/time/time.h"
 #include "ui/gfx/animation/animation_test_api.h"
@@ -307,4 +309,65 @@ TEST_F(WidgetFadeAnimatorTest, FadeInShowTypeNone) {
