+  EXPECT_TRUE(success);
+  EXPECT_FALSE(callback_run);
+
+  // Now simulate the GPU process completing the operation by writing to shared
+  // memory.
+  auto* result =
+      reinterpret_cast<cmds::ReadbackARGBImagePixelsINTERNALImmediate::Result*>(
