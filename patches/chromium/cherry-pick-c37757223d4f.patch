diff --git a/third_party/blink/renderer/core/dom/element.cc b/third_party/blink/renderer/core/dom/element.cc
index 70cd411dac83cde528f01f6c51d551ad3446ec20..8f09cbf2ee8a6054ce7283be90c453511e52d079 100644
--- a/third_party/blink/renderer/core/dom/element.cc
+++ b/third_party/blink/renderer/core/dom/element.cc
@@ -4302,8 +4302,11 @@ Node::InsertionNotificationRequest Element::InsertedInto(
     return kInsertionDone;
   }
 
-  const AtomicString& id_value = GetIdAttribute();
+  const AtomicString id_value = GetIdAttribute();
   if (!id_value.IsNull()) {
+    // UpdateId() notifies id observers, which can update style and layout.
+    // That can synchronize the lazy style attribute, which can reallocate the
+    // attribute storage, invalidating references from GetIdAttribute().
     UpdateId(scope, g_null_atom, id_value);
   }
 
@@ -4454,9 +4457,11 @@ void Element::RemovedFrom(ContainerNode& insertion_point) {
 
   SetSavedLayerScrollOffset(ScrollOffset());
 
-  const AtomicString& id_value = GetIdAttribute();
+  const AtomicString id_value = GetIdAttribute();
   if (insertion_point.IsInTreeScope() && GetTreeScope() == document) {
     if (!id_value.IsNull()) {
+      // UpdateId() can invalidate references from GetIdAttribute(). See the
+      // comment in InsertedInto().
       UpdateId(insertion_point.GetTreeScope(), id_value, g_null_atom);
     }
 
diff --git a/third_party/blink/web_tests/external/wpt/html/semantics/forms/the-datalist-element/list-id-insertion-crash.html b/third_party/blink/web_tests/external/wpt/html/semantics/forms/the-datalist-element/list-id-insertion-crash.html
new file mode 100644
index 0000000000000000000000000000000000000000..77823aeb67e4e5f1fdf3b3f038465ea1049d4bd2
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/html/semantics/forms/the-datalist-element/list-id-insertion-crash.html
@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://crbug.com/567638392">
+
+<datalist id="list">
+  <option value="value" disabled></option>
+</datalist>
+<input list="list">
+<svg>
+  <use href="#target"></use>
+</svg>
+
+<script>
+  const input = document.querySelector('input');
+  document.body.offsetTop;
+  input.focus();
+  // This makes the datalist usable, but doesn't notify the input.
+  document.querySelector('option').disabled = false;
+
+  const target = document.createElementNS('http://www.w3.org/2000/svg', 'g');
+  target.id = 'target';
+  const object = document.createElement('object');
+  object.id = 'list';
+  // Fill the attribute storage to (Chromium) capacity, so that adding the
+  // style attribute reallocates it.
+  for (let i = 0; i < 7; ++i) {
+    object.setAttribute(`data-${i}`, '');
+  }
+  object.style.color = 'green';
+  target.appendChild(object);
+  // This test passes if this doesn't crash:
+  document.querySelector('svg').appendChild(target);
+</script>
