 void RenderWidgetHostViewAura::ShowImpl(PageVisibilityState page_visibility) {
-  // OnShowWithPageVisibility will not call NotifyHostAndDelegateOnWasShown,
-  // which updates `visibility_`, unless the host is hidden. Make sure no update
-  // is needed.
-  CHECK(host()->IsHidden() || visibility_ == Visibility::VISIBLE);
+  // With background throttling disabled, the host stays shown while the view
+  // is hidden. Restore visibility_ here since OnShowWithPageVisibility skips
+  // NotifyHostAndDelegateOnWasShown for an already shown host.
+  const bool already_showing = !host()->IsHidden();
+  if (already_showing)
+    visibility_ = Visibility::VISIBLE;
+
+#if BUILDFLAG(IS_WIN)
+  base::WeakPtr<RenderWidgetHostViewAura> weak_this(
+      weak_ptr_factory_.GetWeakPtr());
+#endif
+
   OnShowWithPageVisibility(page_visibility);
+
+#if BUILDFLAG(IS_WIN)
+  if (!weak_this)
+    return;
+
+  // HideImpl and kHiddenButPainting hide the input HWND even if the host stays
+  // shown. Restore it only when the page becomes visible.
+  if (already_showing && page_visibility == PageVisibilityState::kVisible) {
+    UpdateLegacyWin();
+    // WARNING: Do not add any code after this line, since the last call can
+    // potentially destroy `this`.
+  }
+#endif
 }
 
