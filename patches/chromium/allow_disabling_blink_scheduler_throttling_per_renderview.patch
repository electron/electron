+// Check the input HWND's own style: IsWindowVisible() also depends on the
+// visibility of the test root window.
+TEST_F(RenderWidgetHostViewAuraTest,
+       LegacyRenderWidgetHostHWNDVisibilityAfterHideOrOcclusion) {
+  MockWindowEventTarget event_target;
+  auto prop_window_target = std::make_unique<ui::ViewProp>(
+      parent_view_->GetHostWindowHWND(),
+      ui::WindowEventTarget::kWin32InputEventTarget,
+      static_cast<ui::WindowEventTarget*>(&event_target));
+
+  InitViewForFrame(nullptr);
+  ParentHostView(view_, parent_view_);
+  view_->ShowWithVisibility(PageVisibilityState::kVisible);
+
+  ASSERT_TRUE(legacy_render_widget_host_HWND());
+  HWND hwnd = legacy_render_widget_host_HWND()->hwnd();
+  ASSERT_TRUE(::GetWindowLongPtr(hwnd, GWL_STYLE) & WS_VISIBLE);
+
+  for (bool disable_hidden : {false, true}) {
+    widget_host_->disable_hidden_ = disable_hidden;
+    for (bool occluded : {false, true}) {
+      SCOPED_TRACE(testing::Message() << "disable_hidden=" << disable_hidden
+                                      << ", occluded=" << occluded);
+      if (occluded) {
+        view_->WasOccluded();
+      } else {
+        view_->Hide();
+      }
+      EXPECT_EQ(!disable_hidden, widget_host_->IsHidden());
+      EXPECT_FALSE(::GetWindowLongPtr(hwnd, GWL_STYLE) & WS_VISIBLE);
+
+      view_->ShowWithVisibility(PageVisibilityState::kVisible);
+      EXPECT_FALSE(widget_host_->IsHidden());
+      EXPECT_TRUE(::GetWindowLongPtr(hwnd, GWL_STYLE) & WS_VISIBLE);
+      EXPECT_EQ(view_->GetHostWindowHWND(), ::GetParent(hwnd));
+    }
+  }
+}
+
