diff --git a/third_party/blink/renderer/modules/breakout_box/frame_queue_transferring_optimizer.cc b/third_party/blink/renderer/modules/breakout_box/frame_queue_transferring_optimizer.cc
index 91ff4a3f3bd7b33ff9a969f3b6f5a43195db1fb2..93ebed162efb5bf77829a8d9c7124634c257298f 100644
--- a/third_party/blink/renderer/modules/breakout_box/frame_queue_transferring_optimizer.cc
+++ b/third_party/blink/renderer/modules/breakout_box/frame_queue_transferring_optimizer.cc
@@ -35,14 +35,25 @@ UnderlyingSourceBase*
 FrameQueueTransferringOptimizer<NativeFrameType>::PerformInProcessOptimization(
     ScriptState* script_state) {
   ExecutionContext* context = ExecutionContext::From(script_state);
-
-  scoped_refptr<base::SingleThreadTaskRunner> current_runner =
-      context->GetTaskRunner(TaskType::kInternalMediaRealTime);
-
   auto host = host_.Lock();
   if (!host)
     return nullptr;
 
+  // A source created on a destroyed context would never get
+  // `ContextDestroyed()`, so the host would keep forwarding frames to a dead
+  // heap. Treat this like a transferred source whose context was destroyed.
+  if (!context || context->IsContextDestroyed()) {
+    if (transferred_source_destroyed_callback_) {
+      std::move(transferred_source_destroyed_callback_).Run();
+    }
+    PostCrossThreadTask(
+        *host_runner_, FROM_HERE,
+        CrossThreadBindOnce(&FrameQueueHost::Close, std::move(host)));
+    return nullptr;
+  }
+  scoped_refptr<base::SingleThreadTaskRunner> current_runner =
+      context->GetTaskRunner(TaskType::kInternalMediaRealTime);
+
   auto* source = MakeGarbageCollected<
       TransferredFrameQueueUnderlyingSource<NativeFrameType>>(
       script_state, host, host_runner_,
