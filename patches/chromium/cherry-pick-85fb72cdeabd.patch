Electron adaptation notes (43-x-y): this branch predates the
offset-based CharAllocator refactor (crbug.com/549161451), so
cc/base/list_container_helper.cc still addresses elements by raw
pointer. The new CHECKs were ported onto that representation:
InnerList::Erase(char* position) now does CHECK_GT(size, 0u) and
CHECK_LE(position, LastElement()) (upstream: CHECK_LE(position_offset,
LastElementOffset())), and CharAllocator::Erase() gains the same
CHECK_GT(size_, 0u) / CHECK_GT(list.size, 0u) guards before the
pointer-based LastElement() comparison. The list_container_unittest.cc
hunk only adds the three ListContainerDeathTest cases; the unrelated
RefactorInternalAllocatorPointersRegression test that the 3-way merge
pulled in as context was not taken. The viz overlay_processor and
overlay_unittest hunks applied verbatim.

diff --git a/cc/base/list_container_helper.cc b/cc/base/list_container_helper.cc
index 7b33e836ed7ce2d95956692c71bf0f2c1c14c25a..84ac854a2f653f0dc0adf65ec851e901bb48a3f8 100644
--- a/cc/base/list_container_helper.cc
+++ b/cc/base/list_container_helper.cc
@@ -57,7 +57,11 @@ class ListContainerHelper::CharAllocator {
       // Confident that destructor is called by caller of this function. Since
       // CharAllocator does not handle construction after
       // allocation, it doesn't handle desctrution before deallocation.
-      DCHECK_LE(position, LastElement());
+      // Enforced in all builds: erasing from an empty list or erasing a
+      // past-the-end position underflows the std::copy below into a wild
+      // memmove (~2^64 bytes) and corrupts size/capacity bookkeeping.
+      CHECK_GT(size, 0u);
+      CHECK_LE(position, LastElement());
       DCHECK_GE(position, Begin());
       char* start = UNSAFE_TODO(position + step);
       std::copy(start, End(), position);
@@ -190,9 +194,11 @@ class ListContainerHelper::CharAllocator {
 
   void Erase(PositionInCharAllocator* position) {
     DCHECK_EQ(this, position->ptr_to_container);
+    CHECK_GT(size_, 0u);
 
     // Update |position| to point to the element after the erased element.
     InnerList& list = storage_[position->vector_index];
+    CHECK_GT(list.size, 0u);
     char* item_iterator = position->item_iterator;
     if (item_iterator == list.LastElement())
       position->Increment();
diff --git a/cc/base/list_container_unittest.cc b/cc/base/list_container_unittest.cc
index d2bbd9e57517e063a8ef2270e1bb8033fd4e211d..e0f6b12a76d4cbf5cb8606f0018ca9515496b9ae 100644
--- a/cc/base/list_container_unittest.cc
