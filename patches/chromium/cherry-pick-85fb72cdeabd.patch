+// Test-only processor that accepts every tested candidate combination,
+// simulating DRM hardware whose atomic TEST commit accepts the proposed
+// plane set (e.g. >=5 universal planes on recent Intel devices).
+class AllHandledMultiSingleOnTopProcessor : public MultiOverlayProcessorBase {
+ public:
+  AllHandledMultiSingleOnTopProcessor() {
+    strategies_.push_back(std::make_unique<OverlayStrategySingleOnTop>(this));
+  }
+
+  void CheckOverlaySupportImpl(
+      const std::optional<OverlayCandidate>& primary_plane,
+      OverlayCandidateList* surfaces) override {
+    for (auto& candidate : *surfaces) {
+      candidate.overlay_handled = true;
+    }
+  }
+};
+
+using MultiOverlayDoubleCommitTest =
+    UseMultipleOverlaysTest<AllHandledMultiSingleOnTopProcessor>;
+
+// Regression test for a duplicate rounded-display-mask candidate commit:
+// MaybeAppendOccludingMaskCandidates() appends a mask candidate to the test
+// candidate list once per SingleOnTop candidate it occludes. A single mask
+// quad whose two corner mask squares overlap two different promoted
+// SingleOnTop candidates is therefore appended -- and, if the plane set is
+// accepted, committed -- twice. Committing runs back-to-front by quad index,
+// so both copies of the mask candidate erase the same (index 0) QuadList
+// position last. The second erase runs against an already emptied inner
+// list: cc::ListContainerHelper's InnerList::Erase computes
+// std::copy(position + step, End(), position) with End() == position, whose
+// length underflows to ~2^64 bytes and turns into a wild forward memmove
+// over the heap of the viz process. AddressSanitizer reports it as a
+// negative-size-param on the memmove; without ASan this linearly overwrites
+// the heap until an unmapped page is hit.
+TEST_F(MultiOverlayDoubleCommitTest, MaskOccludingTwoCandidatesDoubleErase) {
+  // A full-width, 32px-tall strip at the top of the display. With mask radii
+  // of 16, its two corner mask squares are (0,0 16x16) and (240,0 16x16).
+  const gfx::Rect kMaskRect(0, 0, 256, 32);
+  // Two non-overlapping SingleOnTop candidates, each intersecting exactly
+  // one of the two corner mask squares.
+  const gfx::Rect kCandLeft(kOverlayTopLeftRect);
+  const gfx::Rect kCandRight(kOverlayTopRightRect);
+
+  auto pass = CreateRenderPass();
+  SurfaceDamageRectList surface_damage_rect_list;
+
+  const auto kMaskInfo =
+      RoundedDisplayMasksInfo::CreateRoundedDisplayMasksInfo(16, 16);
+
+  // Quad index 0: the top-most quad carrying the rounded-display masks.
+  CreateCandidateWithRoundedDisplayMasksAt(pass->shared_quad_state_list.back(),
+                                           pass.get(), kMaskRect, kMaskInfo);
+  // Quad index 1: occluded by the origin (top-left) mask square.
+  CreateCandidateQuadAt(pass->shared_quad_state_list.back(), pass.get(),
+                        kCandLeft);
+  // Quad index 2: occluded by the other (top-right) mask square.
+  CreateCandidateQuadAt(pass->shared_quad_state_list.back(), pass.get(),
+                        kCandRight);
+
+  OverlayCandidateList candidate_list;
+  AggregatedRenderPassList pass_list;
+  pass_list.push_back(std::move(pass));
+
+  overlay_processor_->ProcessForOverlays(
+      resource_provider(), &pass_list, GetIdentityColorMatrix(),
+      std::move(surface_damage_rect_list), GetDefaultPrimaryPlane(),
+      &candidate_list, &damage_rect_);
+
+  // With the duplicate append fixed, the mask candidate is promoted exactly
+  // once and every quad in the pass has been committed to an overlay.
+  EXPECT_EQ(test::NumOverlaysExcludingPrimaryPlane(candidate_list), 3u);
+  EXPECT_TRUE(pass_list.back()->quad_list.empty());
+}
