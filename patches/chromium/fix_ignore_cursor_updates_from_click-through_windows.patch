+#if BUILDFLAG(IS_WIN)
+TEST_F(DesktopNativeWidgetAuraTest, IgnoreCursorUpdatesPreservesSharedCursor) {
+  Widget widget_a;
+  widget_a.Init(CreateParams(Widget::InitParams::CLIENT_OWNS_WIDGET,
+                             Widget::InitParams::TYPE_WINDOW));
+  Widget widget_b;
+  widget_b.Init(CreateParams(Widget::InitParams::CLIENT_OWNS_WIDGET,
+                             Widget::InitParams::TYPE_WINDOW));
+
+  aura::Window* root_a = widget_a.GetNativeView()->GetRootWindow();
+  aura::Window* root_b = widget_b.GetNativeView()->GetRootWindow();
+  auto* cursor_client = aura::client::GetCursorClient(root_a);
+  ASSERT_EQ(cursor_client, aura::client::GetCursorClient(root_b));
+  ASSERT_TRUE(cursor_client);
+  cursor_client->UpdateSystemCursorVisibilityForTest(true);
+
+  widget_a.SetCursor(ui::mojom::CursorType::kHand);
+  EXPECT_EQ(ui::mojom::CursorType::kHand, cursor_client->GetCursor().type());
+
+  cursor_client->LockCursor();
+  root_b->SetProperty(aura::client::kIgnoreCursorUpdatesKey, true);
+  aura::client::GetCursorClient(root_b)->UnlockCursor();
+  EXPECT_FALSE(cursor_client->IsCursorLocked());
+
+  widget_b.SetCursor(ui::mojom::CursorType::kCross);
+  EXPECT_EQ(ui::mojom::CursorType::kHand, cursor_client->GetCursor().type());
+  EXPECT_EQ(ui::mojom::CursorType::kCross,
+            widget_b.GetNativeView()->GetCursor(gfx::Point()).type());
+
+  widget_a.SetCursor(ui::mojom::CursorType::kIBeam);
+  EXPECT_EQ(ui::mojom::CursorType::kIBeam, cursor_client->GetCursor().type());
+
+  root_b->SetProperty(aura::client::kIgnoreCursorUpdatesKey, false);
+  widget_b.SetCursor(ui::mojom::CursorType::kCross);
+  EXPECT_EQ(ui::mojom::CursorType::kCross, cursor_client->GetCursor().type());
+}
