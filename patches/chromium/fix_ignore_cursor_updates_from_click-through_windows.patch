 typedef aura::test::AuraTestBase CompoundEventFilterTest;
 
+TEST_F(CompoundEventFilterTest, IgnoreCursorUpdatesPreservesMouseEvents) {
+  CompoundEventFilter compound_filter;
+  aura::Env::GetInstance()->AddPreTargetHandler(&compound_filter);
+  aura::test::EventCountDelegate delegate;
+  auto window = aura::test::CreateTestWindow({.delegate = &delegate,
+                                              .parent = root_window(),
+                                              .bounds = {5, 5, 100, 100}});
+  window->Show();
+  aura::test::TestCursorClient cursor_client(root_window());
+  ui::test::EventGenerator generator(root_window());
+
+  generator.MoveMouseTo(10, 10);
+  EXPECT_GT(cursor_client.calls_to_set_cursor(), 0);
+
+  root_window()->SetProperty(aura::client::kIgnoreCursorUpdatesKey, true);
+  generator.MoveMouseTo(150, 150);
+  delegate.GetMouseMotionCountsAndReset();
+  cursor_client.reset_calls_to_set_cursor();
+
+  generator.MoveMouseTo(10, 10);
+  EXPECT_EQ(0, cursor_client.calls_to_set_cursor());
+  EXPECT_EQ("1 1 0", delegate.GetMouseMotionCountsAndReset());
+  EXPECT_EQ(&cursor_client, aura::client::GetCursorClient(root_window()));
+  EXPECT_TRUE(cursor_client.IsMouseEventsEnabled());
+
+  root_window()->SetProperty(aura::client::kIgnoreCursorUpdatesKey, false);
+  generator.MoveMouseTo(11, 10);
+  EXPECT_GT(cursor_client.calls_to_set_cursor(), 0);
+  EXPECT_EQ("0 1 0", delegate.GetMouseMotionCountsAndReset());
+
+  aura::Env::GetInstance()->RemovePreTargetHandler(&compound_filter);
+}
