@@ -3081,6 +3083,34 @@ TEST_F(RenderWidgetHostViewAuraTest, CursorVisibilityChange) {
   cursor_client.RemoveObserver(view_);
 }
 
+TEST_F(RenderWidgetHostViewAuraTest,
+       IgnoreCursorUpdatesPreservesRendererCursor) {
+  InitViewForFrame(nullptr);
+  ParentHostView(view_, parent_view_);
+  view_->SetBounds(gfx::Rect(60, 60, 100, 100));
+  view_->ShowWithVisibility(PageVisibilityState::kVisible);
+
+  aura::Window* root = view_->GetNativeView()->GetRootWindow();
+  aura::test::TestCursorClient cursor_client(root);
+  aura::Env::GetInstance()->SetLastMouseLocation(gfx::Point(110, 110));
+
+  view_->DisplayCursor(ui::mojom::CursorType::kHand);
+  EXPECT_EQ(1, cursor_client.calls_to_set_cursor());
+
+  root->SetProperty(aura::client::kIgnoreCursorUpdatesKey, true);
+  cursor_client.reset_calls_to_set_cursor();
+  view_->DisplayCursor(ui::mojom::CursorType::kCross);
+  EXPECT_EQ(0, cursor_client.calls_to_set_cursor());
+  EXPECT_EQ(ui::mojom::CursorType::kCross,
+            view_->GetNativeView()->GetCursor(gfx::Point()).type());
+
+  root->SetProperty(aura::client::kIgnoreCursorUpdatesKey, false);
+  view_->UpdateCursorIfOverSelf();
+  EXPECT_EQ(1, cursor_client.calls_to_set_cursor());
+  EXPECT_EQ(ui::mojom::CursorType::kCross,
+            view_->GetNativeView()->GetCursor(gfx::Point()).type());
+}
+
 TEST_F(RenderWidgetHostViewAuraTest, UpdateCursorIfOverSelf) {
   InitViewForFrame(nullptr);
   ParentHostView(view_, parent_view_);
