Electron adaptation notes (45-x-y):
Electron's refactor_expose_file_system_access_blocklist.patch moves the
kBlockPaths table out of chrome_file_system_access_permission_context.cc into
chrome_file_system_access_permission_context.h (GenerateBlockPaths), which is
the copy Electron compiles via shell/browser/file_system_access. The upstream
.cc hunk therefore has no counterpart here; the /run rule is added at the same
position in the header's kBlockPaths table instead. The unittest hunk applies
as-is.

diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
index 53eb33076332cc9ff7dfb0b75387fabff239bf67..214970b4f1e44dd6533c1b7526c2e4674e4ad269 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
@@ -709,6 +709,11 @@ class ChromeFileSystemAccessPermissionContext
                                   BlockType::kBlockAllChildren),
         BlockPath::CreateAbsolute(FILE_PATH_LITERAL("/etc"),
                                   BlockType::kBlockAllChildren),
+        // And runtime data in /run, including per-session runtime directories
+        // (/run/user/<uid>, the default $XDG_RUNTIME_DIR), see
+        // crbug.com/577376424.
+        BlockPath::CreateAbsolute(FILE_PATH_LITERAL("/run"),
+                                  BlockType::kBlockAllChildren),
         // Block ~/.dbus as well, just in case, although there probably isn't much
         // a website can do with access to that directory and its contents.
         BlockPath::CreateRelative(base::DIR_HOME, FILE_PATH_LITERAL(".dbus"),
diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc b/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
index 02c2dc957af4bd966ba2b79693ca7d89db985da8..2470bcabc9559cc2588263b971195aa2fa2d39f7 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
@@ -917,6 +917,29 @@ TEST_F(ChromeFileSystemAccessPermissionContextTest,
                 permission_context(), PathInfo(FILE_PATH_LITERAL("/dev")),
                 HandleType::kDirectory, AccessTrigger::kProgrammaticWrite),
             SensitiveDirectoryResult::kAbort);
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+  // /run and its children should be blocked across access triggers.
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(), PathInfo(FILE_PATH_LITERAL("/run")),
+                HandleType::kDirectory, AccessTrigger::kOpen),
+            SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(
+      ConfirmSensitiveEntryAccessSync(
+          permission_context(), PathInfo(FILE_PATH_LITERAL("/run/user/1000")),
+          HandleType::kDirectory, AccessTrigger::kOpen),
+      SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(
+      ConfirmSensitiveEntryAccessSync(
+          permission_context(), PathInfo(FILE_PATH_LITERAL("/run/user/1000")),
+          HandleType::kDirectory, AccessTrigger::kProgrammaticWrite),
+      SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(),
+                PathInfo(temp_dir_.GetPath().AppendASCII("run")),
+                HandleType::kDirectory, AccessTrigger::kOpen),
+            SensitiveDirectoryResult::kAllowed);
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) ||
+        // BUILDFLAG(IS_ANDROID)
 #elif BUILDFLAG(IS_WIN)
   EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
                 permission_context(),
@@ -2246,6 +2269,7 @@ TEST_F(ChromeFileSystemAccessPermissionContextTest,
       {kNoBasePathKey, FILE_PATH_LITERAL("/sys"), true, false},
       {kNoBasePathKey, FILE_PATH_LITERAL("/boot"), true, false},
       {kNoBasePathKey, FILE_PATH_LITERAL("/etc"), true, false},
+      {kNoBasePathKey, FILE_PATH_LITERAL("/run"), true, false},
       {base::DIR_HOME, FILE_PATH_LITERAL(".dbus"), true, false},
       {base::DIR_HOME, FILE_PATH_LITERAL(".local/share"), true, false},
       {base::DIR_HOME, FILE_PATH_LITERAL(".fonts.conf"), true, false},
