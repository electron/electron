     active_format_.reset();
 
     // Generate the av1c.
@@ -211,13 +215,17 @@ bool VideoToolboxAV1Accelerator::ProcessFormat(
     std::unique_ptr<uint8_t[]> av1c =
         libgav1::ObuParser::GetAV1CodecConfigurationBox(
