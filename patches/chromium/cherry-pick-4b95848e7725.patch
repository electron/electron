From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mason Freed <masonf@chromium.org>
Date: Wed, 28 Oct 2026 08:52:24 -0700
Subject: Avoid dangling AtomicString refs across WillModifyAttribute

When Element::DidMoveToNewDocument moves an element between documents
with different quirks modes, GetIdAttribute() and GetClassAttribute()
return const AtomicString& references into the element's
AttributeVector backing buffer. If a DevTools attribute-modified DOM
breakpoint pauses execution inside WillModifyAttribute and script
mutates the element's attributes, AttributeVector can reallocate and
leave new_value dangling in SetAttributeInternal and
DidModifyAttribute.

Copy the attribute values in DidMoveToNewDocument and
SetAttributeInternal before calling WillModifyAttribute, and
re-validate the attribute index after WillModifyAttribute in the
modified-value branch.

Fixed: 574789298
Bug: 574789298
Change-Id: I8ca5944e9ea420fb33625909f6f39acafd3f92e2
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8633078
Reviewed-by: Joey Arhar <jarhar@chromium.org>
Auto-Submit: Mason Freed <masonf@chromium.org>
Commit-Queue: Mason Freed <masonf@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1729189}

diff --git a/third_party/blink/renderer/core/dom/element.cc b/third_party/blink/renderer/core/dom/element.cc
index a3a7d037426dcad8387b9cf4740acebcf9f737c1..087377ca76ef776db5e4d917c48e36c365535ef7 100644
--- a/third_party/blink/renderer/core/dom/element.cc
+++ b/third_party/blink/renderer/core/dom/element.cc
@@ -13712,18 +13712,26 @@ ALWAYS_INLINE void Element::SetAttributeInternal(
       GetElementData()->Attributes().at(index);
   QualifiedName existing_attribute_name = existing_attribute.GetName();
 
+  // `new_value` may be a reference into `ElementData::Attributes()`, which can
+  // be reallocated if `WillModifyAttribute()` pauses in the debugger and script
+  // mutates attributes. Copy it here (rather than taking `new_value` by value
+  // in `SetAttributeInternal`, which would add refcount churn to the
+  // `AppendAttributeInternal` fast path).
   if (new_value == existing_attribute.Value()) {
     if (reason !=
         AttributeModificationReason::kBySynchronizationOfLazyAttribute) {
-      WillModifyAttribute(existing_attribute_name, new_value, new_value);
-      DidModifyAttribute(existing_attribute_name, new_value, new_value, reason);
+      AtomicString value_copy = new_value;
+      WillModifyAttribute(existing_attribute_name, value_copy, value_copy);
+      DidModifyAttribute(existing_attribute_name, value_copy, value_copy,
+                         reason);
     }
   } else {
     AtomicString existing_attribute_value = existing_attribute.Value();
+    AtomicString value_copy = new_value;
     if (reason !=
         AttributeModificationReason::kBySynchronizationOfLazyAttribute) {
       WillModifyAttribute(existing_attribute_name, existing_attribute_value,
-                          new_value);
+                          value_copy);
     }
     MutableAttributeCollection mutable_attributes =
         EnsureUniqueElementData().Attributes();
@@ -13734,14 +13742,14 @@ ALWAYS_INLINE void Element::SetAttributeInternal(
       index = mutable_attributes.FindIndex(existing_attribute_name);
     }
     if (index != kNotFound) {
-      mutable_attributes[index].SetValue(new_value);
+      mutable_attributes[index].SetValue(value_copy);
     } else {
-      mutable_attributes.Append(existing_attribute_name, new_value);
+      mutable_attributes.Append(existing_attribute_name, value_copy);
     }
     if (reason !=
         AttributeModificationReason::kBySynchronizationOfLazyAttribute) {
       DidModifyAttribute(existing_attribute_name, existing_attribute_value,
-                         new_value, reason);
+                         value_copy, reason);
     }
   }
 }
diff --git a/third_party/blink/web_tests/inspector-protocol/debugger/domdebugger-adopt-node-attr-modified-crash-expected.txt b/third_party/blink/web_tests/inspector-protocol/debugger/domdebugger-adopt-node-attr-modified-crash-expected.txt
