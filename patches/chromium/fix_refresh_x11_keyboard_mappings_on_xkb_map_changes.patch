+TEST(X11ConnectionTest, XkbEventsUseSubtype) {
+  Connection connection;
+  ASSERT_TRUE(connection.Ready());
+  auto extension = connection.QueryExtension("XKEYBOARD").Sync();
+  ASSERT_TRUE(extension);
+  if (!extension->present) {
+    GTEST_SKIP() << "XKB is not available";
+  }
+
+  auto check_type = [&]<typename T>() {
+    SCOPED_TRACE(T::opcode);
+    for (bool send_event : {false, true}) {
+      std::vector<uint8_t> data(sizeof(xcb_generic_event_t), 0);
+      data[0] = extension->first_event | (send_event ? 0x80 : 0);
+      data[1] = T::opcode;
+      Event event(ThrowAwaySizeRefCountedMemory::From(std::move(data)),
+                  &connection);
+      EXPECT_NE(event.As<T>(), nullptr);
+      EXPECT_EQ(event.send_event(), send_event);
+    }
+  };
+  check_type.operator()<Xkb::NewKeyboardNotifyEvent>();
+  check_type.operator()<Xkb::MapNotifyEvent>();
+  check_type.operator()<Xkb::StateNotifyEvent>();
+  check_type.operator()<Xkb::ControlsNotifyEvent>();
+  check_type.operator()<Xkb::IndicatorStateNotifyEvent>();
+  check_type.operator()<Xkb::IndicatorMapNotifyEvent>();
+  check_type.operator()<Xkb::NamesNotifyEvent>();
+  check_type.operator()<Xkb::CompatMapNotifyEvent>();
+  check_type.operator()<Xkb::BellNotifyEvent>();
+  check_type.operator()<Xkb::ActionMessageEvent>();
+  check_type.operator()<Xkb::AccessXNotifyEvent>();
+  check_type.operator()<Xkb::ExtensionDeviceNotifyEvent>();
+
+  std::vector<uint8_t> data(sizeof(xcb_generic_event_t), 0);
+  data[0] = extension->first_event;
+  data[1] = 0xff;
+  Event unknown(ThrowAwaySizeRefCountedMemory::From(std::move(data)),
+                &connection);
+  EXPECT_EQ(unknown.As<Xkb::NewKeyboardNotifyEvent>(), nullptr);
+}
+
+TEST(X11ConnectionTest, XkbMapNotifyRefreshesKeyboardMapping) {
+  Connection connection;
+  ASSERT_TRUE(connection.Ready());
+  if (!connection.xkb().present()) {
+    GTEST_SKIP() << "XKB is not available";
+  }
+  Connection mutator;
+  ASSERT_TRUE(mutator.Ready());
+  const KeyCode keycode = connection.setup().max_keycode;
+  auto original = mutator.GetKeyboardMapping({keycode, 1}).Sync();
+  ASSERT_TRUE(original);
+  ASSERT_GT(original->keysyms_per_keycode, 0);
+  const uint32_t before = connection.KeycodeToKeysym(keycode, 0);
+  const uint32_t replacement = before == XK_F35 ? XK_F34 : XK_F35;
+
+  // Use a separate connection and do not dispatch the mapping notifications
+  // queued for `connection`: only the explicit XKB event below may refresh it.
+  auto changed =
+      mutator
+          .ChangeKeyboardMapping({
+              .keycode_count = 1,
+              .first_keycode = keycode,
+              .keysyms_per_keycode = original->keysyms_per_keycode,
+              .keysyms = std::vector<KeySym>(original->keysyms.size(),
+                                             static_cast<KeySym>(replacement)),
+          })
+          .Sync();
+  EXPECT_FALSE(changed.error);
+  EXPECT_EQ(connection.KeycodeToKeysym(keycode, 0), before);
+  connection.DispatchEvent(Event(false, Xkb::MapNotifyEvent{}));
+  EXPECT_EQ(connection.KeycodeToKeysym(keycode, 0), replacement);
+
+  // Keep all checks after the mutation nonfatal so that restoration runs even
+  // when the cache-refresh expectation fails on the unpatched implementation.
+  auto restored = mutator
+                      .ChangeKeyboardMapping({
+                          .keycode_count = 1,
+                          .first_keycode = keycode,
+                          .keysyms_per_keycode = original->keysyms_per_keycode,
+                          .keysyms = original->keysyms,
+                      })
+                      .Sync();
+  EXPECT_FALSE(restored.error);
+  connection.DispatchEvent(Event(false, Xkb::MapNotifyEvent{}));
+  EXPECT_EQ(connection.KeycodeToKeysym(keycode, 0), before);
+}
+
