-        FILE_PATH_LITERAL("ORIG_HEAD"),
-        FILE_PATH_LITERAL("ORIG_HEAD.lock"),
-        FILE_PATH_LITERAL("FETCH_HEAD"),
-        FILE_PATH_LITERAL("MERGE_HEAD"),
-        FILE_PATH_LITERAL("CHERRY_PICK_HEAD"),
-        FILE_PATH_LITERAL("REVERT_HEAD"),
