-      (IsLocalUNCServer(components[1]) ||
-       components[1] == FILE_PATH_LITERAL("127.0.0.1") ||
-       components[1] == FILE_PATH_LITERAL(".") ||
-       components[1] == FILE_PATH_LITERAL("?") ||
-       ContainsInvalidDNSCharacter(components[1]))) {
-    return true;
-  }
