-                                                 FILE_PATH_LITERAL("IPC$")) ||
-          base::FilePath::CompareEqualIgnoreCase(component,
-                                                 FILE_PATH_LITERAL("PRINT$")) ||
-          base::FilePath::CompareEqualIgnoreCase(component,
-                                                 FILE_PATH_LITERAL("FAX$"))) {
