From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Samuel Attard <sam@electronjs.org>
Date: Fri, 18 Sep 2026 08:30:00 +0000
Subject: diag: trace VisualProperties handshake

DIAGNOSTIC ONLY, not for merge. Logs the RenderWidgetHostImpl
VisualProperties send/skip/ack decisions for top-level widgets to stderr
when ELECTRON_DIAG_WCO contains 'l'. Used to investigate
https://github.com/electron/electron/issues/54025.

diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -11,6 +11,9 @@
 #include <set>
 #include <tuple>
 #include <utility>
+
+#include <cstdio>
+#include <cstdlib>
 #include <vector>
 
 #include "base/auto_reset.h"
@@ -40,6 +43,28 @@
 #include "base/time/time.h"
 #include "base/trace_event/optional_trace_event.h"
 #include "base/trace_event/trace_event.h"
+
+// DIAGNOSTIC ONLY (electron/electron#54025): trace the VisualProperties
+// handshake for top-level widgets when ELECTRON_DIAG_WCO contains 'l'.
+namespace {
+bool WcoDiagEnabled() {
+  static const bool enabled = [] {
+    const char* v = std::getenv("ELECTRON_DIAG_WCO");
+    return v && std::string(v).find('l') != std::string::npos;
+  }();
+  return enabled;
+}
+}  // namespace
+#define WCO_DIAG(...)                            \
+  do {                                           \
+    if (WcoDiagEnabled() && !self_owned_ &&      \
+        !(view_ && view_->IsRenderWidgetHostViewChildFrame())) { \
+      std::fprintf(stderr, "[wco-diag] rwh%p ", static_cast<void*>(this)); \
+      std::fprintf(stderr, __VA_ARGS__);         \
+      std::fprintf(stderr, "\n");                \
+      std::fflush(stderr);                       \
+    }                                            \
+  } while (0)
 #include "build/build_config.h"
 #include "cc/base/switches.h"
 #include "cc/input/browser_controls_offset_tag_modifications.h"
@@ -767,6 +792,9 @@ void RenderWidgetHostImpl::RendererWidgetCreated(bool for_frame_widget) {
   CHECK(GetProcess()->IsInitializedAndNotDead());
 
   renderer_widget_created_ = true;
+  WCO_DIAG("RendererWidgetCreated for_frame=%d hidden=%d view=%d "
+           "waiting_for_init=%d",
+           for_frame_widget, is_hidden_, !!view_, waiting_for_init_);
 
