+    status_ = status;
+  }
+  void NotifyEncoderInfoChange(const VideoEncoderInfo& info) override {}
+
+  EncoderStatus GetLastStatus() const { return status_; }
+
+ private:
+  EncoderStatus status_ = EncoderStatus::Codes::kOk;
+};
