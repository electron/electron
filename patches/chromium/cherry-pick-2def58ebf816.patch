diff --git a/third_party/blink/renderer/core/animation/compositor_animations.cc b/third_party/blink/renderer/core/animation/compositor_animations.cc
index 28cff618fd1c6fcf6ce891bf857b04977b63108e..1c3376ff87b8f3b714f32a4e5203725d3bceeba9 100644
--- a/third_party/blink/renderer/core/animation/compositor_animations.cc
+++ b/third_party/blink/renderer/core/animation/compositor_animations.cc
@@ -416,7 +416,15 @@ CompositorAnimations::CheckCanStartEffectOnCompositor(
           break;
         case CSSPropertyID::kBackdropFilter:
           // Backdrop-filter pixel moving filters do not change the layer bounds
-          // like regular filters do, so they can still be composited.
+          // like regular filters do, so they can still be composited. However,
+          // reference filters cannot be interpolated or composited.
+          if (keyframe->GetCompositorKeyframeValue() &&
+              To<CompositorKeyframeFilterOperations>(
+                  keyframe->GetCompositorKeyframeValue())
+                  ->Operations()
+                  .HasReferenceFilter()) {
+            DefaultToUnsupportedProperty(state, property);
+          }
           break;
         case CSSPropertyID::kBackgroundColor:
         case CSSPropertyID::kClipPath:
@@ -875,6 +883,7 @@ void AddKeyframeToCurve(cc::KeyframedFilterAnimationCurve& curve,
   CompositorFilterOperations operations = builder.BuildFilterOperations(
       To<CompositorKeyframeFilterOperations>(value)->Operations(),
       is_backdrop_filter);
+  DCHECK(!operations.HasReferenceFilter());
   std::unique_ptr<cc::FilterKeyframe> filter_keyframe =
       cc::FilterKeyframe::Create(base::Seconds(keyframe->Offset()),
                                  operations.ReleaseCcFilterOperations(),
diff --git a/third_party/blink/renderer/core/animation/compositor_animations_test.cc b/third_party/blink/renderer/core/animation/compositor_animations_test.cc
index 694fd5e0fac44d85cb5a69a9c62eb4232427d9fe..1003e9a92d36b3be13837a3b5f4d13dbe8794379 100644
--- a/third_party/blink/renderer/core/animation/compositor_animations_test.cc
+++ b/third_party/blink/renderer/core/animation/compositor_animations_test.cc
@@ -1464,6 +1464,35 @@ TEST_P(AnimationCompositorAnimationsTest,
                CompositorAnimations::kTargetHasInvalidCompositingState));
 }
 
+TEST_P(AnimationCompositorAnimationsTest,
+       CanStartElementOnCompositorEffectBackdropFilter) {
+  // Pixel-moving filters (such as blur) on backdrop-filter do not change layer
+  // bounds and can be composited.
+  StringKeyframeEffectModel* effect1 = CreateKeyframeEffectModel(
+      CreateReplaceOpKeyframe(CSSPropertyID::kBackdropFilter, "none", 0),
+      CreateReplaceOpKeyframe(CSSPropertyID::kBackdropFilter, "blur(10px)",
+                              1.0));
+  auto* keyframe_effect1 =
+      MakeGarbageCollected<KeyframeEffect>(element_.Get(), effect1, timing_);
+  Animation* animation1 = timeline_->Play(keyframe_effect1);
+  UpdateAllLifecyclePhasesForTest();
+  EXPECT_EQ(CheckCanStartEffectOnCompositor(timing_, *element_.Get(),
+                                            animation1, *effect1),
+            CompositorAnimations::kNoFailure);
+
+  // Reference filters on backdrop-filter cannot be interpolated or composited.
+  StringKeyframeEffectModel* effect2 = CreateKeyframeEffectModel(
+      CreateReplaceOpKeyframe(CSSPropertyID::kBackdropFilter, "none", 0),
+      CreateReplaceOpKeyframe(CSSPropertyID::kBackdropFilter, "url(#f)", 1.0));
+  auto* keyframe_effect2 =
+      MakeGarbageCollected<KeyframeEffect>(element_.Get(), effect2, timing_);
+  Animation* animation2 = timeline_->Play(keyframe_effect2);
+  UpdateAllLifecyclePhasesForTest();
+  EXPECT_TRUE(CheckCanStartEffectOnCompositor(timing_, *element_.Get(),
+                                              animation2, *effect2) &
+              CompositorAnimations::kUnsupportedCSSProperty);
+}
