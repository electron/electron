   // TODO(crbug.com/704136): Make it a Member.
-  raw_ptr<WebRtcAudioRendererSource> source_;
+  raw_ptr<WebRtcAudioRendererSource> source_ GUARDED_BY(lock_);
 
   // Protects access to |state_|, |source_|, |audio_fifo_|,
