Electron adaptation notes (42-x-y):
Chromium 148 still carries the legacy (SvgPartitionSVGDocumentResourcesInMemoryCache
disabled) code path in DisposeUnobserved() and SVGResourceDocumentContent::Fetch(). The
feature is 'stable' on this branch, so the upstream reordering (remove from
tracked_resources_ first, then Dispose() from the local list) was applied to the enabled
path only; the legacy entries_ branch is untouched. The IsDisposed() early-return was
inserted directly after the tracker is obtained, ahead of the branch's cache-key lookup.

diff --git a/third_party/blink/renderer/core/svg/svg_document_resource_tracker.cc b/third_party/blink/renderer/core/svg/svg_document_resource_tracker.cc
index d39ae84ea782f3157716c64dc099183f401b905b..e06e28178af1882ce264dea0ac07760f1ee6ebb5 100644
--- a/third_party/blink/renderer/core/svg/svg_document_resource_tracker.cc
+++ b/third_party/blink/renderer/core/svg/svg_document_resource_tracker.cc
@@ -84,11 +84,14 @@ void SVGDocumentResourceTracker::WillBeDestroyed() {
 }
 
 void SVGDocumentResourceTracker::Dispose() {
-  for (const auto& resource : tracked_resources_) {
+  is_disposed_ = true;
+
+  HeapHashSet<Member<SVGDocumentResource>> to_dispose;
+  to_dispose.swap(tracked_resources_);
+  for (const auto& resource : to_dispose) {
     resource->GetContent()->Dispose();
   }
   MemoryCache::Get()->EvictResourcesForCacheIdentifier(cache_identifier_);
-  tracked_resources_.clear();
 }
 
 void SVGDocumentResourceTracker::DisposeUnobserved() {
@@ -99,12 +102,17 @@ void SVGDocumentResourceTracker::DisposeUnobserved() {
     HeapVector<Member<SVGDocumentResource>> to_remove;
     for (const auto& resource : tracked_resources_) {
       if (!resource->GetContent()->HasObservers()) {
-        resource->GetContent()->Dispose();
         to_remove.push_back(resource);
         MemoryCache::Get()->Remove(resource);
       }
     }
     tracked_resources_.RemoveAll(to_remove);
+
+    // Perform disposal from `to_remove` since Dispose() may cause additional
+    // resources to be added (i.e mutate `tracked_resources_`).
+    for (const auto& resource : to_remove) {
+      resource->GetContent()->Dispose();
+    }
   } else {
     Vector<CacheKey> to_remove;
     for (auto& entry : entries_) {
@@ -165,6 +173,7 @@ void SVGDocumentResourceTracker::Trace(Visitor* visitor) const {
 }
 
 void SVGDocumentResourceTracker::AddResource(SVGDocumentResource* resource) {
+  CHECK(!is_disposed_);
   tracked_resources_.insert(resource);
 }
 
diff --git a/third_party/blink/renderer/core/svg/svg_document_resource_tracker.h b/third_party/blink/renderer/core/svg/svg_document_resource_tracker.h
index 2b29a86a1b0891cb21ebd3080a6bc953a4076d8e..99e813094e290c4e26f59c1e10a151aa4f207ced 100644
--- a/third_party/blink/renderer/core/svg/svg_document_resource_tracker.h
+++ b/third_party/blink/renderer/core/svg/svg_document_resource_tracker.h
@@ -57,6 +57,7 @@ class CORE_EXPORT SVGDocumentResourceTracker final
   void WillBeDestroyed();
 
   void Dispose();
+  bool IsDisposed() const { return is_disposed_; }
 
   void Trace(Visitor*) const;
 
@@ -75,6 +76,7 @@ class CORE_EXPORT SVGDocumentResourceTracker final
   HeapHashSet<Member<SVGDocumentResource>> tracked_resources_;
   scoped_refptr<base::SingleThreadTaskRunner> dispose_task_runner_;
   bool dispose_task_pending_ = false;
+  bool is_disposed_ = false;
   String cache_identifier_;
 };
 
diff --git a/third_party/blink/renderer/core/svg/svg_resource_document_content.cc b/third_party/blink/renderer/core/svg/svg_resource_document_content.cc
index 6931b720eaf408161b7708ad74dd8a6c20672c97..71d22e30cac612084175141dc610f41187d2ef58 100644
--- a/third_party/blink/renderer/core/svg/svg_resource_document_content.cc
+++ b/third_party/blink/renderer/core/svg/svg_resource_document_content.cc
@@ -301,6 +301,9 @@ SVGResourceDocumentContent* SVGResourceDocumentContent::Fetch(
 
   Page* page = document.GetPage();
   auto& cache = page->GetSVGDocumentResourceTracker();
+  if (cache.IsDisposed()) {
+    return nullptr;
+  }
   const SVGDocumentResourceTracker::CacheKey key =
       SVGDocumentResourceTracker::MakeCacheKey(params);
 
