--- a/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html
+++ b/third_party/blink/web_tests/external/wpt/css/cssom/adoptedstylesheets-observablearray.html
@@ -100,4 +100,37 @@ test(function() {
   delete Array.prototype["1"];
   assert_equals(backing, null);
 }, "adoptedStyleSheets should not expose its backing object via prototype");
+
+test(function() {
+  // A prototype-less descriptor keeps Object.defineProperty() below working
+  // once Object.prototype.get is a number.
+  const numeric = Object.create(null);
+  numeric.value = 1;
+  numeric.writable = true;
+  numeric.configurable = true;
+  const descriptor = new Proxy(Object.create(null), {
+    has(target, key) {
+      if (key === "set") {
+        // Runs while the descriptor is being converted, after the initial
+        // conversion has already looked up "get".
+        Object.defineProperty(Object.prototype, "get", numeric);
+        Object.defineProperty(Object.prototype, "set", numeric);
+      }
+      return false;
+    },
+  });
+  try {
+    assert_throws_js(TypeError, () => {
+      Reflect.defineProperty(document.adoptedStyleSheets, "reentrantAccessor",
+                             descriptor);
+    });
+  } finally {
+    delete Object.prototype.get;
+    delete Object.prototype.set;
+  }
+  assert_equals(
+      Object.getOwnPropertyDescriptor(document.adoptedStyleSheets,
+                                      "reentrantAccessor"),
+      undefined);
+}, "adoptedStyleSheets defineProperty should reject accessors that become non-callable during descriptor conversion");
 </script>
