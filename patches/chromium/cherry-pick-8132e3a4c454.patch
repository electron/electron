Electron adaptation notes (43-x-y):
This branch's DidFail() had no ERR_BLOCKED_BY_ORB handling at all (the earlier upstream change that records set_is_cors_cross_origin(true) on an ORB block is not on this branch), so the whole upstream post-fix block (record cross-origin, Fail(), return) was inserted; net::ERR_BLOCKED_BY_ORB and UrlData::set_is_cors_cross_origin() already exist here. The unit test hunk did not merge and was dropped (test-only).

diff --git a/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc b/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
index cfa32f824d80f77f2d9818bdede7a1b0694e07f6..abfe58236b226e4aefdd89190dd59d25c4616e3b 100644
--- a/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
+++ b/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
@@ -525,6 +525,16 @@ void ResourceMultiBufferDataProvider::DidFail(const WebURLError& error) {
   DCHECK(active_loader_.get());
   active_loader_.reset();
 
+  // ORB only blocks cross-origin no-cors responses, which are opaque. Record
+  // this so that the failure is not distinguishable from other opaque
+  // failures (e.g. via error messages exposed by the media element). An ORB
+  // block is also deterministic, so fail immediately rather than retrying.
+  if (error.reason() == net::ERR_BLOCKED_BY_ORB) {
+    url_data_->set_is_cors_cross_origin(true);
+    url_data_->Fail();
+    return;  // "this" may be deleted now.
+  }
+
   if (url_data_->url_index() && retries_ < kMaxRetries && pos_ != 0) {
     retries_++;
     task_runner_->PostDelayedTask(
