From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vivek Galatage <vivekg@chromium.org>
Date: Mon, 5 Oct 2026 05:04:15 -0700
Subject: Use C++20 std::numbers::e and std::numbers::sqrt2 in blink

The CL https://chromium-review.googlesource.com/c/chromium/src/+/8465423
removed the inclusion of <math.h> on Windows as part of the larger
change of using the C++20 std::numbers across blink code. (see
third_party/blink/renderer/platform/wtf/math_extras.h)

Due to this removal, the windows build is broken in certain
configurations e.g. using ccache and not using pre-compiled headers.

Bug: 40256226
Change-Id: Iad118b6ef3be92c530be191dc5da8d214482c826
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8510323
Reviewed-by: Kent Tamura <tkent@chromium.org>
Commit-Queue: Vivek Galatage <vivekg@chromium.org>
Reviewed-by: Morten Stenshorne <mstensho@chromium.org>
Reviewed-by: Takuto Ikuta <tikuta@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1711172}
(cherry picked from commit 937b57ac49225eb16015467f082274d70ee8503d)
Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/third_party/blink/renderer/core/css/css_math_expression_node.cc b/third_party/blink/renderer/core/css/css_math_expression_node.cc
index 39f0956de69af88b5a8ce0104599b1b5ee86ddec..fbad7daa33a955d333c2f71f9c6234a1015ff701 100644
--- a/third_party/blink/renderer/core/css/css_math_expression_node.cc
+++ b/third_party/blink/renderer/core/css/css_math_expression_node.cc
@@ -4919,7 +4919,7 @@ class CSSMathExpressionNodeParser {
     if (token.Id() == CSSValueID::kE) {
       context_.Count(WebFeature::kCSSCalcConstants);
       return CSSMathExpressionNumericLiteral::Create(
-          M_E, CSSPrimitiveValue::UnitType::kNumber);
+          std::numbers::e, CSSPrimitiveValue::UnitType::kNumber);
     }
     if (state.allow_size_keyword && token.Id() == CSSValueID::kSize) {
       return CSSMathExpressionKeywordLiteral::Create(
diff --git a/third_party/blink/renderer/core/layout/svg/layout_svg_shape.cc b/third_party/blink/renderer/core/layout/svg/layout_svg_shape.cc
index 2a0e8c05b850b3a71b8dfb04f2e5e49000b0ceb6..370bbae130e26416764d1681978c3f6e203aa7c2 100644
--- a/third_party/blink/renderer/core/layout/svg/layout_svg_shape.cc
+++ b/third_party/blink/renderer/core/layout/svg/layout_svg_shape.cc
@@ -222,12 +222,13 @@ gfx::RectF LayoutSVGShape::ApproximateStrokeBoundingBox(
     const ComputedStyle& style = StyleRef();
     if (CanHaveMiters(geometry_type_) && HasMiterJoinStyle(style)) {
       const float miter = style.StrokeMiterLimit();
-      if (miter < M_SQRT2 && HasSquareCapStyle(style))
-        delta *= M_SQRT2;
-      else
+      if (miter < std::numbers::sqrt2 && HasSquareCapStyle(style)) {
+        delta *= std::numbers::sqrt2;
+      } else {
         delta *= std::max(miter, 1.0f);
+      }
     } else if (HasSquareCapStyle(style)) {
-      delta *= M_SQRT2;
+      delta *= std::numbers::sqrt2;
     }
   }
   stroke_box.Outset(delta);
