@@ -385,12 +400,18 @@ void GlobalAcceleratorListenerLinux::BindShortcuts(std::string parent_handle) {
   }
 
   const base::flat_set<std::string> ids_to_bind = GetIdsToBind();
+  pending_bind_groups_.clear();
