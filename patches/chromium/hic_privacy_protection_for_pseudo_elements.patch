+<!DOCTYPE HTML>
+<html>
+<head>
+  <title>drawElementImage does not reveal visited link colors in first-line</title>
+  <link rel="stylesheet" type="text/css" href="/fonts/ahem.css" />
+  <script src='/resources/testharness.js'></script>
+  <script src='/resources/testharnessreport.js'></script>
+  <script src="/html/canvas/resources/wait-for-canvas-paint.js"></script>
+  <style>
+    .link {
+      color: green;
+      display: block;
+      width: 50px;
+    }
+    .link::first-line {
+      background-color: blue;
+      color: blue;
+    }
+    .link:visited {
+      color: red;
+    }
+    .link:visited::first-line {
+      background-color: red;
+      color: red;
+    }
+  </style>
+</head>
+<body>
+  <canvas id="canvas" width="100" height="100" layoutsubtree>
+    <div id=child>
+    </div>
+  </canvas>
+  <a id=grandchild class=link href="">Enough text for multiple lines.</a>
+
+  <script>
+    window.onload = () => {
+      promise_test(async function(t) {
+        await waitForCanvasPaint(canvas);
+
+        child.moveBefore(grandchild, null);
+
+        await waitForCanvasPaint(canvas);
+
+        var context = canvas.getContext("2d");
+
+        // Draw the element image
+        context.drawElementImage(child, 0, 0);
+
+        // The canvas should NOT reflect the visited state (red), it should paint the unvisited state (green).
+        let pixel = context.getImageData(10, 10, 1, 1).data;
+        assert_false(pixel[0] > 0, "The canvas should not reflect the visited state.");
+        assert_false(pixel[1] > 0, "The canvas should not reflect the visited state.");
+        assert_true(pixel[2] > 0, "The canvas should not reflect the visited state.");
+      });
+    };
+  </script>
+</body>
+</html>
