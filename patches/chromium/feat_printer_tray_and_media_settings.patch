+TEST(PrintSettingsConversionTest, CupsMediaCollectionCarriesSelectionsAndSize) {
+  PrintSettings settings;
+  settings.set_input_tray("tray-2");
+  settings.set_media_type("labels");
+  PrintSettings::RequestedMedia media;
+  media.size_microns = gfx::Size(210000, 297000);
+  settings.set_requested_media(media);
+  auto job = EncodeMediaCollection(settings);
+  auto* attribute =
+      ippFindAttribute(job.get(), "media-col", IPP_TAG_BEGIN_COLLECTION);
+  ASSERT_TRUE(attribute);
+  ipp_t* collection = ippGetCollection(attribute, 0);
+  ASSERT_TRUE(collection);
+  EXPECT_STREQ(ippGetString(ippFindAttribute(collection, "media-source",
+                                             IPP_TAG_KEYWORD),
+                            0, nullptr),
+               "tray-2");
+  EXPECT_STREQ(
+      ippGetString(ippFindAttribute(collection, "media-type", IPP_TAG_KEYWORD),
+                   0, nullptr),
+      "labels");
+  ipp_t* size = ippGetCollection(
+      ippFindAttribute(collection, "media-size", IPP_TAG_BEGIN_COLLECTION), 0);
+  ASSERT_TRUE(size);
+  EXPECT_EQ(
+      ippGetInteger(ippFindAttribute(size, "x-dimension", IPP_TAG_INTEGER), 0),
+      21000);
+  EXPECT_EQ(
+      ippGetInteger(ippFindAttribute(size, "y-dimension", IPP_TAG_INTEGER), 0),
+      29700);
+}
+
+TEST(PrintSettingsConversionTest,
+     CupsMediaCollectionPreservesUnspecifiedFields) {
+  PrintSettings settings;
+  EXPECT_TRUE(PrintSettingsToCupsMediaCollection(settings).empty());
+  settings.set_input_tray("tray-2");
+  auto job = EncodeMediaCollection(settings);
+  auto* attribute =
+      ippFindAttribute(job.get(), "media-col", IPP_TAG_BEGIN_COLLECTION);
+  ASSERT_TRUE(attribute);
+  ipp_t* collection = ippGetCollection(attribute, 0);
+  ASSERT_TRUE(collection);
+  EXPECT_FALSE(ippFindAttribute(collection, "media-type", IPP_TAG_ZERO));
+  EXPECT_FALSE(ippFindAttribute(collection, "media-size", IPP_TAG_ZERO));
+}
+
+TEST(PrintSettingsConversionTest, CupsMediaCollectionEscapesOptionValues) {
+  PrintSettings settings;
+  const std::string value = "tray\\\" media-type=labels";
+  settings.set_input_tray(value);
+  auto job = EncodeMediaCollection(settings);
+  auto* attribute =
+      ippFindAttribute(job.get(), "media-col", IPP_TAG_BEGIN_COLLECTION);
+  ASSERT_TRUE(attribute);
+  ipp_t* collection = ippGetCollection(attribute, 0);
+  ASSERT_TRUE(collection);
+  EXPECT_STREQ(ippGetString(ippFindAttribute(collection, "media-source",
+                                             IPP_TAG_KEYWORD),
+                            0, nullptr),
+               value.c_str());
+  EXPECT_FALSE(ippFindAttribute(collection, "media-type", IPP_TAG_ZERO));
+}
