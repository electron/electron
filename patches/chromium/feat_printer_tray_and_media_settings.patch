+template <typename Id>
+bool IsPrinterMediaIdSupported(const wchar_t* printer,
+                               const wchar_t* port,
+                               WORD capability,
+                               std::string_view requested_id,
+                               const DEVMODE* dev_mode) {
+  if (requested_id.empty()) {
+    return true;
+  }
+  unsigned id = 0;
+  if (!base::StringToUint(requested_id, &id) || id == 0 ||
+      id > std::numeric_limits<Id>::max()) {
+    return false;
+  }
+  const int count =
+      DeviceCapabilitiesW(printer, port, capability, nullptr, dev_mode);
+  if (count <= 0 || count > 65536) {
+    return false;
+  }
+  // Match the capability enumeration's padding for drivers whose counts change
+  // between the size and data queries. Reject an inconsistent result.
+  std::vector<Id> ids(count * 2);
+  if (DeviceCapabilitiesW(printer, port, capability,
+                          reinterpret_cast<wchar_t*>(ids.data()),
+                          dev_mode) != count) {
+    return false;
+  }
+  ids.resize(count);
+  return std::ranges::contains(ids, static_cast<Id>(id));
+}
+
 PrinterBasicInfo InitializePrinterInfo(LPTSTR name, LPTSTR comment) {
   PrinterBasicInfo printer_info;
 
@@ -576,6 +610,64 @@ bool PrinterHasValidPaperSize(const wchar_t* name, const wchar_t* port) {
   return DeviceCapabilities(name, port, DC_PAPERSIZE, nullptr, nullptr) > 0;
 }
 
+bool PrinterSupportsMediaSettings(HANDLE printer,
+                                  std::string_view input_tray,
+                                  std::string_view media_type,
+                                  const DEVMODE* dev_mode) {
+  if (input_tray.empty() && media_type.empty()) {
+    return true;
+  }
+  PrinterInfo5 info;
+  if (!info.Init(printer)) {
+    return false;
+  }
+  return IsPrinterMediaIdSupported<WORD>(info.get()->pPrinterName,
+                                         info.get()->pPortName, DC_BINS,
+                                         input_tray, dev_mode) &&
+         IsPrinterMediaIdSupported<DWORD>(info.get()->pPrinterName,
+                                          info.get()->pPortName, DC_MEDIATYPES,
+                                          media_type, dev_mode);
+}
+
+bool ApplyPrinterMediaSettings(std::string_view input_tray,
+                               std::string_view media_type,
+                               DEVMODE& dev_mode) {
+  unsigned tray_id = 0;
+  unsigned media_id = 0;
+  if ((!input_tray.empty() &&
+       (!base::StringToUint(input_tray, &tray_id) || tray_id == 0 ||
+        tray_id > std::numeric_limits<WORD>::max())) ||
+      (!media_type.empty() &&
+       (!base::StringToUint(media_type, &media_id) || media_id == 0))) {
+    return false;
+  }
+  if (!input_tray.empty()) {
+    dev_mode.dmFields |= DM_DEFAULTSOURCE;
+    // DC_BINS returns WORD IDs, while DEVMODE stores the same bits in a short.
+    dev_mode.dmDefaultSource = std::bit_cast<short>(static_cast<WORD>(tray_id));
+  }
+  if (!media_type.empty()) {
+    dev_mode.dmFields |= DM_MEDIATYPE;
+    dev_mode.dmMediaType = media_id;
+  }
+  return true;
+}
+
+bool PrinterMediaSettingsMatch(std::string_view input_tray,
+                               std::string_view media_type,
+                               const DEVMODE& dev_mode) {
+  DEVMODE requested = dev_mode;
+  if (!ApplyPrinterMediaSettings(input_tray, media_type, requested)) {
+    return false;
+  }
+  return (input_tray.empty() ||
+          ((dev_mode.dmFields & DM_DEFAULTSOURCE) &&
+           dev_mode.dmDefaultSource == requested.dmDefaultSource)) &&
+         (media_type.empty() ||
+          ((dev_mode.dmFields & DM_MEDIATYPE) &&
+           dev_mode.dmMediaType == requested.dmMediaType));
+}
