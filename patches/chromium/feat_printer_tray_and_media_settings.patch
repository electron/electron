diff --git a/printing/backend/win_helper_unittest.cc b/printing/backend/win_helper_unittest.cc
index 055bf2e28fb63a154bf397528218df8401e5a192..12e61bff14c26d89b7bf78d293784a2866173ac2 100644
--- a/printing/backend/win_helper_unittest.cc
+++ b/printing/backend/win_helper_unittest.cc
@@ -21,4 +21,51 @@ TEST(WinHelperTest, GetDriverVersionString) {
             "4660.22136.4951.9320");
 }
 
+TEST(WinHelperTest, PrinterMediaPreservesUnspecifiedDefaults) {
+  DEVMODE dev_mode = {};
+  dev_mode.dmFields = DM_DEFAULTSOURCE | DM_MEDIATYPE | DM_COPIES;
+  dev_mode.dmDefaultSource = 258;
+  dev_mode.dmMediaType = 257;
+  dev_mode.dmCopies = 3;
+  ASSERT_TRUE(ApplyPrinterMediaSettings("", "", dev_mode));
+  EXPECT_EQ(dev_mode.dmDefaultSource, 258);
+  EXPECT_EQ(dev_mode.dmMediaType, 257u);
+  EXPECT_EQ(dev_mode.dmCopies, 3);
+  EXPECT_EQ(dev_mode.dmFields,
+            DWORD{DM_DEFAULTSOURCE | DM_MEDIATYPE | DM_COPIES});
+
+  ASSERT_TRUE(ApplyPrinterMediaSettings("259", "", dev_mode));
+  EXPECT_EQ(dev_mode.dmDefaultSource, 259);
+  EXPECT_EQ(dev_mode.dmMediaType, 257u);
+  ASSERT_TRUE(ApplyPrinterMediaSettings("", "258", dev_mode));
+  EXPECT_EQ(dev_mode.dmDefaultSource, 259);
+  EXPECT_EQ(dev_mode.dmMediaType, 258u);
+}
+
+TEST(WinHelperTest, PrinterMediaRejectsInvalidIdentifiersAtomically) {
+  for (const auto* invalid : {"0", "-1", "65536", "tray2", "4294967296"}) {
+    DEVMODE dev_mode = {};
+    EXPECT_FALSE(ApplyPrinterMediaSettings(invalid, "257", dev_mode));
+    EXPECT_EQ(dev_mode.dmFields, 0u);
+  }
+  for (const auto* invalid : {"0", "-1", "glossy", "4294967296"}) {
+    DEVMODE dev_mode = {};
+    EXPECT_FALSE(ApplyPrinterMediaSettings("258", invalid, dev_mode));
+    EXPECT_EQ(dev_mode.dmFields, 0u);
+  }
+}
+
+TEST(WinHelperTest, PrinterMediaDetectsDriverSubstitution) {
+  DEVMODE dev_mode = {};
+  ASSERT_TRUE(ApplyPrinterMediaSettings("65535", "4294967295", dev_mode));
+  EXPECT_EQ(static_cast<WORD>(dev_mode.dmDefaultSource), 65535);
+  EXPECT_EQ(dev_mode.dmMediaType, 4294967295u);
+  EXPECT_TRUE(PrinterMediaSettingsMatch("65535", "4294967295", dev_mode));
+  EXPECT_FALSE(PrinterMediaSettingsMatch("258", "4294967295", dev_mode));
+  EXPECT_FALSE(PrinterMediaSettingsMatch("65535", "257", dev_mode));
+  dev_mode.dmFields &= ~DM_DEFAULTSOURCE;
+  EXPECT_FALSE(PrinterMediaSettingsMatch("65535", "4294967295", dev_mode));
+  EXPECT_TRUE(PrinterMediaSettingsMatch("", "", dev_mode));
+}
+
 }  // namespace printing
