+bool PrintingContextMac::SetPrinterMediaInPrintSettings() {
+  const std::string collection = PrintSettingsToCupsMediaCollection(*settings_);
+  if (collection.empty()) {
+    return true;
+  }
+
+  PMPrintSettings print_settings =
+      static_cast<PMPrintSettings>([print_info_ PMPrintSettings]);
+  // Clear conflicting per-job PPD/paper-feed choices inherited from a preset.
+  if (!settings_->input_tray().empty()) {
+    for (CFStringRef key : {CFSTR("InputSlot"), CFSTR("AP_D_InputSlot"),
+                            kPMPrimaryPaperFeedKey, kPMSecondaryPaperFeedKey}) {
+      if (PMPrintSettingsSetValue(print_settings, key, nullptr, false) !=
+          noErr) {
+        return false;
+      }
+    }
+  }
+  if (!settings_->media_type().empty() &&
+      PMPrintSettingsSetValue(print_settings, CFSTR("MediaType"), nullptr,
+                              false) != noErr) {
+    return false;
+  }
+  return SetKeyValue("media-col", collection);
+}
