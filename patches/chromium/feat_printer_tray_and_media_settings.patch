+TEST(PrintSettingsConversionTest, PrinterMediaSettings) {
+  auto job = base::test::ParseJsonDict(kPrinterSettings);
+  job.Set("inputTray", "258");
+  job.Set("mediaType", "257");
+  auto settings = PrintSettingsFromJobSettings(job);
+  ASSERT_TRUE(settings);
+  EXPECT_EQ(settings->input_tray(), "258");
+  EXPECT_EQ(settings->media_type(), "257");
+
+  job.Set("inputTray", 258);
+  EXPECT_FALSE(PrintSettingsFromJobSettings(job));
+}
