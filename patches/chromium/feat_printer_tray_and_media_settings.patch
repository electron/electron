+std::string PrintSettingsToCupsMediaCollection(const PrintSettings& settings) {
+  if (settings.input_tray().empty() && settings.media_type().empty()) {
+    return {};
+  }
+
+  std::string collection = "{";
+  const auto append_keyword = [&collection](std::string_view key,
+                                            std::string_view value) {
+    if (value.empty()) {
+      return;
+    }
+    base::StrAppend(&collection, {key, "=\""});
+    // CUPS collection values use its option-string quoting rules.
+    for (char character : value) {
+      if (character == '\\' || character == '"') {
+        collection += '\\';
+      }
+      collection += character;
+    }
+    collection += "\" ";
+  };
+  append_keyword("media-source", settings.input_tray());
+  append_keyword("media-type", settings.media_type());
+
+  // A media-col takes precedence over the separate paper-size option. Preserve
+  // an explicitly requested size in the collection (IPP units are 0.01 mm).
+  const gfx::Size& size = settings.requested_media().size_microns;
+  if (!size.IsEmpty()) {
+    base::StrAppend(
+        &collection,
+        {"media-size={x-dimension=", base::NumberToString(size.width() / 10),
+         " y-dimension=", base::NumberToString(size.height() / 10), "} "});
+  }
+  collection.back() = '}';
+  return collection;
+}
