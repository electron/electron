From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gyuyoung Kim <qkim@google.com>
Date: Fri, 30 Oct 2026 03:57:56 +0000
Subject: [M150-LTS] Force media controls pseudo-elements to be read-only

Author CSS can match `-webkit-media-controls*`,
`audio::-webkit-media-text-track-container`, and
`::-internal-media-controls-overlay-cast-button` pseudo-elements and set
`-webkit-user-modify: read-write`, making internal UA shadow DOM nodes
editable. Add `-webkit-user-modify: read-only !important` to these UA
stylesheet rules so author styles cannot make media controls editable.

Bug: 578691880
Change-Id: I6c2d9840a97f1611424043a80d127d78c52b39e0
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8677038
Reviewed-by: Sangwhan Moon <sxm@chromium.org>
Commit-Queue: Tommy Steimel <steimel@chromium.org>
Commit-Queue: Sangwhan Moon <sxm@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1729648}
(cherry picked from commit 0282207e83eefc4074b6902b64951e73c663d15f)

diff --git a/third_party/blink/renderer/modules/media_controls/media_controls_impl_test.cc b/third_party/blink/renderer/modules/media_controls/media_controls_impl_test.cc
index 9e4a435bd06e8813c2199063c4be2b84584004eb..c1d4b1f81bc34a5bf96d32c532bb20a0461a6ea8 100644
--- a/third_party/blink/renderer/modules/media_controls/media_controls_impl_test.cc
+++ b/third_party/blink/renderer/modules/media_controls/media_controls_impl_test.cc
@@ -1783,4 +1783,120 @@ TEST_F(MediaControlsImplTest, TextTrackElementsAreReadOnly) {
   }
 }
 
+TEST_F(MediaControlsImplTest, MediaControlElementsAreReadOnly) {
+  GetDocument().head()->SetInnerHTMLWithoutTrustedTypes(R"HTML(
+    <style>
+      audio::-webkit-media-controls,
+      video::-webkit-media-controls,
+      audio::-webkit-media-controls-enclosure,
+      video::-webkit-media-controls-enclosure,
+      audio::-webkit-media-controls-panel,
+      video::-webkit-media-controls-panel,
+      audio::-webkit-media-controls-overlay-enclosure,
+      video::-webkit-media-controls-overlay-enclosure,
+      video::-webkit-media-controls-overlay-play-button,
+      audio::-webkit-media-controls-play-button,
+      video::-webkit-media-controls-play-button,
+      audio::-webkit-media-controls-mute-button,
+      video::-webkit-media-controls-mute-button,
+      audio::-webkit-media-controls-fullscreen-button,
+      video::-webkit-media-controls-fullscreen-button,
+      audio::-webkit-media-controls-toggle-closed-captions-button,
+      video::-webkit-media-controls-toggle-closed-captions-button,
+      audio::-webkit-media-controls-timeline,
+      video::-webkit-media-controls-timeline,
+      audio::-webkit-media-controls-volume-control-container,
+      video::-webkit-media-controls-volume-control-container,
+      audio::-webkit-media-controls-volume-control-hover-background,
+      video::-webkit-media-controls-volume-control-hover-background,
+      audio::-webkit-media-controls-volume-slider,
+      video::-webkit-media-controls-volume-slider,
+      audio::-webkit-media-controls-current-time-display,
+      video::-webkit-media-controls-current-time-display,
+      audio::-webkit-media-controls-time-remaining-display,
+      video::-webkit-media-controls-time-remaining-display,
+      audio::-webkit-media-text-track-container,
+      audio::-internal-media-controls-overlay-cast-button,
+      video::-internal-media-controls-overlay-cast-button {
+        -webkit-user-modify: read-write;
+      }
+    </style>
+  )HTML");
+
+  GetDocument().body()->AppendChild(
+      GetDocument().CreateRawElement(html_names::kAudioTag));
+  auto& audio = To<HTMLMediaElement>(*QuerySelector("audio"));
+  audio.SetBooleanAttribute(html_names::kControlsAttr, true);
+  audio.UpdateTextTrackDisplay();
+
+  LoadMediaWithDuration(10.0);
+  SetReady();
+  UpdateAllLifecyclePhasesForTest();
+
+  ShadowRoot* video_shadow_root =
+      MediaControls().MediaElement().UserAgentShadowRoot();
+  ASSERT_TRUE(video_shadow_root);
+
+  for (const char* pseudo_id :
+       {"-webkit-media-controls", "-webkit-media-controls-enclosure",
+        "-webkit-media-controls-panel",
+        "-webkit-media-controls-overlay-enclosure",
+        "-webkit-media-controls-volume-control-container",
+        "-webkit-media-controls-volume-control-hover-background",
+        "-webkit-media-controls-current-time-display",
+        "-webkit-media-controls-time-remaining-display"}) {
+    Element* element =
+        GetElementByShadowPseudoId(*video_shadow_root, pseudo_id);
+    ASSERT_TRUE(element) << pseudo_id;
+    const ComputedStyle* style = element->EnsureComputedStyle();
+    ASSERT_TRUE(style) << pseudo_id;
+    EXPECT_EQ(style->UsedUserModify(), EUserModify::kReadOnly) << pseudo_id;
+    EXPECT_FALSE(element->IsFocusable()) << pseudo_id;
+  }
+
+  for (const char* pseudo_id :
+       {"-webkit-media-controls-overlay-play-button",
+        "-webkit-media-controls-play-button",
+        "-webkit-media-controls-mute-button",
+        "-webkit-media-controls-fullscreen-button",
+        "-webkit-media-controls-toggle-closed-captions-button",
+        "-webkit-media-controls-timeline",
+        "-webkit-media-controls-volume-slider",
+        "-internal-media-controls-overlay-cast-button"}) {
+    Element* element =
+        GetElementByShadowPseudoId(*video_shadow_root, pseudo_id);
+    ASSERT_TRUE(element) << pseudo_id;
+    const ComputedStyle* style = element->EnsureComputedStyle();
+    ASSERT_TRUE(style) << pseudo_id;
+    EXPECT_EQ(style->UsedUserModify(), EUserModify::kReadOnly) << pseudo_id;
+  }
+
+  ShadowRoot* audio_shadow_root = audio.UserAgentShadowRoot();
+  ASSERT_TRUE(audio_shadow_root);
+
+  for (const char* pseudo_id :
+       {"-webkit-media-controls", "-webkit-media-controls-enclosure",
+        "-webkit-media-controls-panel",
+        "-webkit-media-controls-overlay-enclosure",
+        "-webkit-media-controls-play-button",
+        "-webkit-media-controls-mute-button",
+        "-webkit-media-controls-fullscreen-button",
+        "-webkit-media-controls-toggle-closed-captions-button",
+        "-webkit-media-controls-timeline",
+        "-webkit-media-controls-volume-control-container",
+        "-webkit-media-controls-volume-control-hover-background",
+        "-webkit-media-controls-volume-slider",
+        "-webkit-media-controls-current-time-display",
+        "-webkit-media-controls-time-remaining-display",
+        "-webkit-media-text-track-container",
+        "-internal-media-controls-overlay-cast-button"}) {
+    Element* element =
+        GetElementByShadowPseudoId(*audio_shadow_root, pseudo_id);
+    ASSERT_TRUE(element) << pseudo_id;
+    const ComputedStyle* style = element->EnsureComputedStyle();
+    ASSERT_TRUE(style) << pseudo_id;
+    EXPECT_EQ(style->UsedUserModify(), EUserModify::kReadOnly) << pseudo_id;
+  }
+}
+
 }  // namespace blink
