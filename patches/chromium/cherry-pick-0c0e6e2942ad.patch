diff --git a/content/browser/file_system_access/file_system_access_file_handle_impl.cc b/content/browser/file_system_access/file_system_access_file_handle_impl.cc
index 1e22ccc5dafd4c1e48233a6581b5532104c5c661..fe968fdbd26ec8188e9a65bada5f0d94369e4d9d 100644
--- a/content/browser/file_system_access/file_system_access_file_handle_impl.cc
+++ b/content/browser/file_system_access/file_system_access_file_handle_impl.cc
@@ -121,6 +121,18 @@ bool HasWritePermission(const base::FilePath& path) {
 // already exists. Must be called on a sequence which allows blocking.
 base::File::Error CreateCowSwapFile(const storage::FileSystemURL& source_url,
                                     const storage::FileSystemURL& swap_url) {
+  // `clonefile()` operates directly on raw paths and follows symlinks when
+  // `flags` is 0, whereas `LocalFileUtil` hides symlinks by mapping them to
+  // `FILE_ERROR_NOT_FOUND`. Reject symlinks on `source_url` as not found, and
+  // treat a symlink (including a dangling symlink) at `swap_url` as an
+  // existing file so swap creation advances to the next candidate swap name
+  // instead of creating the clone at the symlink's target.
+  if (base::IsLink(source_url.path())) {
+    return base::File::Error::FILE_ERROR_NOT_FOUND;
+  }
+  if (base::IsLink(swap_url.path())) {
+    return base::File::Error::FILE_ERROR_EXISTS;
+  }
   return clonefile(source_url.path().value().c_str(),
                    swap_url.path().value().c_str(),
                    /*flags=*/0) == 0
diff --git a/content/browser/file_system_access/file_system_access_file_handle_impl_unittest.cc b/content/browser/file_system_access/file_system_access_file_handle_impl_unittest.cc
index 8852e45c508c9551f81ad0fa9c4f0e32f3c80b8e..38dec716fef5740abb93ebf5f738907fb4e05a2f 100644
--- a/content/browser/file_system_access/file_system_access_file_handle_impl_unittest.cc
+++ b/content/browser/file_system_access/file_system_access_file_handle_impl_unittest.cc
@@ -1336,6 +1336,65 @@ TEST_F(FileSystemAccessFileHandleSwapFileCloningTest, HandleCloneFailure) {
   EXPECT_TRUE(writer_remote.is_valid());
   EXPECT_EQ(GetCloneFileResult(handle_), CloneFileResult::kAttemptedAndAborted);
 }
+
+TEST_F(FileSystemAccessFileHandleSwapFileCloningTest,
+       HandleDanglingSymlinkSwapFile) {
+  const base::FilePath swap_path = dir_.GetPath().AppendASCII("test.crswap");
+  const base::FilePath symlink_target =
+      dir_.GetPath().AppendASCII("symlink_target");
+  ASSERT_TRUE(base::CreateSymbolicLink(symlink_target, swap_path));
+  ASSERT_FALSE(base::PathExists(symlink_target));
+
+  // A dangling symlink at `test.crswap` passes `FileExists` as NOT_FOUND
+  // because `LocalFileUtil` hides symlinks, so `CreateCowSwapFile` must reject
+  // the symlink rather than letting `clonefile()` follow it and create
+  // `symlink_target`, and advance to `test.1.crswap`.
+  base::test::TestFuture<
+      blink::mojom::FileSystemAccessErrorPtr,
+      mojo::PendingRemote<blink::mojom::FileSystemAccessFileWriter>>
+      future;
+  handle_->CreateFileWriter(
+      /*keep_existing_data=*/true,
+      /*auto_close=*/false,
+      blink::mojom::FileSystemAccessWritableFileStreamLockMode::kSiloed,
+      future.GetCallback());
+  blink::mojom::FileSystemAccessErrorPtr result;
+  mojo::PendingRemote<blink::mojom::FileSystemAccessFileWriter> writer_remote;
+  std::tie(result, writer_remote) = future.Take();
+  EXPECT_EQ(result->status, FileSystemAccessStatus::kOk);
+  EXPECT_TRUE(writer_remote.is_valid());
+  EXPECT_EQ(GetCloneFileResult(handle_),
+            CloneFileResult::kAttemptedAndCompletedAsExpected);
+  EXPECT_FALSE(base::PathExists(symlink_target));
+  EXPECT_TRUE(base::IsLink(swap_path));
+  EXPECT_TRUE(base::PathExists(dir_.GetPath().AppendASCII("test.1.crswap")));
+}
+
+TEST_F(FileSystemAccessFileHandleSwapFileCloningTest, SymlinkSourceFileFails) {
+  const base::FilePath other_path = dir_.GetPath().AppendASCII("other");
+  ASSERT_TRUE(base::WriteFile(other_path, "secret"));
+  ASSERT_TRUE(base::DeleteFile(test_file_url_.path()));
+  ASSERT_TRUE(base::CreateSymbolicLink(other_path, test_file_url_.path()));
+
+  base::test::TestFuture<
+      blink::mojom::FileSystemAccessErrorPtr,
+      mojo::PendingRemote<blink::mojom::FileSystemAccessFileWriter>>
+      future;
+  handle_->CreateFileWriter(
+      /*keep_existing_data=*/true,
+      /*auto_close=*/false,
+      blink::mojom::FileSystemAccessWritableFileStreamLockMode::kSiloed,
+      future.GetCallback());
+  blink::mojom::FileSystemAccessErrorPtr result;
+  mojo::PendingRemote<blink::mojom::FileSystemAccessFileWriter> writer_remote;
+  std::tie(result, writer_remote) = future.Take();
+  EXPECT_EQ(result->status, FileSystemAccessStatus::kFileError);
+  EXPECT_EQ(result->file_error, base::File::FILE_ERROR_NOT_FOUND);
+  EXPECT_FALSE(writer_remote.is_valid());
+  EXPECT_EQ(handle_->get_swap_file_clone_result_for_testing(),
+            base::File::Error::FILE_ERROR_NOT_FOUND);
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("test.crswap")));
+}
 #endif  // BUILDFLAG(IS_MAC)
 
