diff --git a/third_party/blink/web_tests/http/tests/inspector-protocol/issues/deprecation-view-transition-prevent-svg-filter-paint.js b/third_party/blink/web_tests/http/tests/inspector-protocol/issues/deprecation-view-transition-prevent-svg-filter-paint.js
