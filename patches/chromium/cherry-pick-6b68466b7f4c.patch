   if (compositor_thread_default_task_runner_) {
     // Mojo channel bound on compositor thread.
     compositor_thread_default_task_runner_->PostTask(
@@ -532,8 +538,8 @@ void WidgetInputHandlerManager::FindScrollTargetOnMainThread(
