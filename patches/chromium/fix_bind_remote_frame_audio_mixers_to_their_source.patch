+TEST_F(AudioRendererMixerManagerTest,
+       RemoteMainFrameDefaultDeviceMixersFollowSourceFrames) {
+  media::AudioParameters params(
+      AudioParameters::AUDIO_PCM_LINEAR,
+      media::ChannelLayoutConfig::FromLayout<kChannelLayout>(), kSampleRate,
+      kBufferSize);
+  const LocalFrameToken first_source_frame_token;
+  const LocalFrameToken second_source_frame_token;
+  const FrameToken remote_main_frame_token = RemoteFrameToken();
+  media::FakeAudioRenderCallback first_callback(0, kSampleRate);
+  media::FakeAudioRenderCallback alias_callback(1, kSampleRate);
+  media::FakeAudioRenderCallback second_callback(2, kSampleRate);
+
+  mock_sink_ = CreateNormalSink();
+  EXPECT_CALL(*mock_sink_, Start()).Times(1);
+  auto first_input =
+      CreateInputHelper(first_source_frame_token, remote_main_frame_token,
+                        base::UnguessableToken(), kDefaultDeviceId,
+                        AudioLatency::Type::kPlayback, params, &first_callback);
+
+  mock_sink_ = CreateNormalSink(std::string());
+  EXPECT_CALL(*mock_sink_, Start()).Times(0);
+  auto alias_input =
+      CreateInputHelper(first_source_frame_token, remote_main_frame_token,
+                        base::UnguessableToken(), std::string(),
+                        AudioLatency::Type::kPlayback, params, &alias_callback);
+
+  mock_sink_ = CreateNormalSink();
+  EXPECT_CALL(*mock_sink_, Start()).Times(1);
+  auto second_input = CreateInputHelper(
+      second_source_frame_token, remote_main_frame_token,
+      base::UnguessableToken(), kDefaultDeviceId, AudioLatency::Type::kPlayback,
+      params, &second_callback);
+
+  first_input->Start();
+  EXPECT_EQ(1u, mixer_count());
+  alias_input->Start();
+  EXPECT_EQ(1u, mixer_count());
+  second_input->Start();
+  EXPECT_EQ(2u, mixer_count());
+
+  alias_input->Stop();
+  EXPECT_EQ(2u, mixer_count());
+  first_input->Stop();
+  EXPECT_EQ(1u, mixer_count());
+  second_input->Stop();
+  EXPECT_EQ(0u, mixer_count());
+}
