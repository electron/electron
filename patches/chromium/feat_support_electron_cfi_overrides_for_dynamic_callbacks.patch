From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: deepak1556 <hop2deep@gmail.com>
Date: Mon, 28 Sep 2026 09:59:31 +0000
Subject: feat: support Electron CFI overrides for dynamic callbacks

1) Electron links independently built native addons alongside CFI
instrumented Chromium and needs a separate, scoped CFI ignorelist without
modifying existing suppressions list.

2) Emit unchecked pointer types for opted-in generated dlopen loaders so other
indirect calls keep CFI checks. Should be upstreamed.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/build/config/sanitizers/BUILD.gn b/build/config/sanitizers/BUILD.gn
index 1354d18e31482de958da3639ffa88f550dccbe57..ab393d64d1c30f0111f495c0b45aded7ba1351c8 100644
--- a/build/config/sanitizers/BUILD.gn
+++ b/build/config/sanitizers/BUILD.gn
@@ -406,6 +406,11 @@ config("cfi_flags") {
       "-fsanitize=cfi-vcall",
       "-fsanitize-ignorelist=$cfi_ignorelist_path",
     ]
+    if (defined(is_electron_build) && is_electron_build) {
+      cflags +=
+          [ "-fsanitize-ignorelist=" +
+            rebase_path("//electron/build/cfi/ignorelist.txt", root_build_dir) ]
+    }
 
     if (toolchain_supports_rust_thin_lto) {
       # sanitize=cfi implies -fsplit-lto-unit, and Rust needs to match
diff --git a/tools/generate_library_loader/generate_library_loader.gni b/tools/generate_library_loader/generate_library_loader.gni
index 6c1c2508051c66120efafa76b65123f63578e7ae..68a1b44ba9e9f8d494ff25e68dcd44125b818a22 100644
--- a/tools/generate_library_loader/generate_library_loader.gni
+++ b/tools/generate_library_loader/generate_library_loader.gni
@@ -11,6 +11,7 @@
 # functions: List of strings for functions to process.
 # config: (optional) Label of the config generated by pkgconfig.
 # bundled_header: (optional)
+# cfi_unchecked_callee: (optional) Calls into a dlopen'd library without CFI.
 template("generate_library_loader") {
   output_h = "$root_gen_dir/library_loaders/" + invoker.output_h
   output_cc = "$root_gen_dir/library_loaders/" + invoker.output_cc
@@ -50,6 +51,9 @@ template("generate_library_loader") {
         invoker.bundled_header,
       ]
     }
+    if (defined(invoker.cfi_unchecked_callee) && invoker.cfi_unchecked_callee) {
+      args += [ "--cfi-unchecked-callee" ]
+    }
     args += invoker.functions
   }
 
diff --git a/tools/generate_library_loader/generate_library_loader.py b/tools/generate_library_loader/generate_library_loader.py
index 4a10c448411d4a700f81acffa5d5eecddee78e9e..cbe34c2517cf4e4d3e1c641942d8ae6a2ba2570f 100755
--- a/tools/generate_library_loader/generate_library_loader.py
+++ b/tools/generate_library_loader/generate_library_loader.py
@@ -30,6 +30,7 @@ HEADER_TEMPLATE = """// This is generated file. Do not modify directly.
 
 #include <string>
 
+%(cfi_unchecked_callee_define)s
 class %(class_name)s {
  public:
   %(class_name)s();
@@ -56,11 +57,12 @@ class %(class_name)s {
   void operator=(const %(class_name)s&);
 };
 
+%(cfi_unchecked_callee_undef)s
 #endif  // %(unique_prefix)s
 """
 
 
-HEADER_MEMBER_TEMPLATE = """  decltype(&::%(function_name)s) %(function_name)s;
+HEADER_MEMBER_TEMPLATE = """  decltype(&::%(function_name)s) %(function_name)s%(cfi_unchecked_callee)s;
 """
 
 
@@ -144,6 +146,8 @@ def main():
   parser.add_option('--bundled-header')
   parser.add_option('--use-extern-c', action='store_true', default=False)
   parser.add_option('--link-directly', type=int, default=0)
+  parser.add_option('--cfi-unchecked-callee', action='store_true',
+                    default=False)
 
   options, args = parser.parse_args()
 
@@ -172,10 +176,14 @@ def main():
   member_decls = []
   member_init = []
   member_cleanup = []
+  cfi_unchecked_callee = (
+    ' %s_CFI_UNCHECKED_CALLEE' % unique_prefix
+    if options.cfi_unchecked_callee else ''
+  )
   for fn in args:
     member_decls.append(
       HEADER_MEMBER_TEMPLATE
-      % {'function_name': fn, 'unique_prefix': unique_prefix}
+      % {'function_name': fn, 'cfi_unchecked_callee': cfi_unchecked_callee}
     )
     member_init.append(
       IMPL_MEMBER_INIT_TEMPLATE
@@ -221,6 +229,21 @@ def main():
     'wrapped_header_include': wrapped_header_include,
     'class_name': options.name,
     'member_decls': ''.join(member_decls),
+    'cfi_unchecked_callee_define': (
+      '#if defined(__clang__)\n'
+      '#if !__has_attribute(cfi_unchecked_callee)\n'
+      '#error cfi_unchecked_callee requires a newer Clang\n'
+      '#endif\n'
+      '#define %s_CFI_UNCHECKED_CALLEE [[clang::cfi_unchecked_callee]]\n'
+      '#else\n'
+      '#define %s_CFI_UNCHECKED_CALLEE\n'
+      '#endif\n' % (unique_prefix, unique_prefix)
+      if options.cfi_unchecked_callee else ''
+    ),
+    'cfi_unchecked_callee_undef': (
+      '#undef %s_CFI_UNCHECKED_CALLEE' % unique_prefix
+      if options.cfi_unchecked_callee else ''
+    ),
   }
 
   impl_contents = IMPL_TEMPLATE % {
