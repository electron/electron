-  if (picker) {
+  if (picker &&
+      desktop_id.id_type == DesktopMediaID::IdType::kNativePickerSession) {
     device_out = picker->CreateDevice(desktop_id);
     if (device_out) {
       return kNativeMacOSPickerCaptureDevice;
diff --git a/content/browser/renderer_host/media/video_capture_manager.cc b/content/browser/renderer_host/media/video_capture_manager.cc
index a9c53964a931f19889d60f0c5f3b3a9919acd3e7..902e95264549b2005ffe6ef32a0a29aaa2026bc6 100644
--- a/content/browser/renderer_host/media/video_capture_manager.cc
+++ b/content/browser/renderer_host/media/video_capture_manager.cc
@@ -939,8 +939,11 @@ void VideoCaptureManager::DestroyControllerIfNoClients(
 
     // Close the native OS picker as the associated VideoCaptureDevice is being
     // closed.
-    CloseNativeScreenCapturePicker(
-        DesktopMediaID::Parse(controller->device_id()));
+    const DesktopMediaID desktop_id =
+        DesktopMediaID::Parse(controller->device_id());
+    if (desktop_id.id_type == DesktopMediaID::IdType::kNativePickerSession) {
+      CloseNativeScreenCapturePicker(desktop_id);
+    }
 
     // The VideoCaptureController is removed from |controllers_| immediately.
     // The controller is deleted immediately, and the device is freed
