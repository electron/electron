From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Newport <kethinov@gmail.com>
Date: Fri, 31 Jul 2026 18:22:15 -0400
Subject: fix: source the Linux portal accent color via OsSettingsProvider

Cherry-pick of the merged upstream Chromium fix, backported ahead of the
Chromium roll that will carry it into Electron main.

On Linux the system accent color (org.freedesktop.portal.Settings
"accent-color") had two independent writers to NativeTheme::user_color():
DarkModeManagerLinux::SetAccentColor() wrote it directly, while
NativeTheme::UpdateVariablesForToolkitSettings() wrote it from
OsSettingsProvider::AccentColor(), which was unimplemented on Linux and
returned nullopt. Whichever ran last won, so the toolkit-settings update
intermittently clobbered the real accent color back to nullopt. This was
observable via systemPreferences.getAccentColor() returning an empty
string on some launches.

The fix gives the toolkit OsSettingsProviders a real accent color, making
UpdateVariablesForToolkitSettings() the single source of truth, and drops
the direct write in DarkModeManagerLinux.

This patch can be removed once Electron rolls to a Chromium that includes
the upstream change.

Upstream: https://chromium-review.googlesource.com/c/chromium/src/+/8178167
Bug: https://issues.chromium.org/issues/536445418

diff --git a/chrome/browser/ui/views/dark_mode_manager_linux.cc b/chrome/browser/ui/views/dark_mode_manager_linux.cc
index 01e5f00d3387966963c3b4619a3039556fadd43a..759902dcb37122c467f80326dc205ba609b1b815 100644
--- a/chrome/browser/ui/views/dark_mode_manager_linux.cc
+++ b/chrome/browser/ui/views/dark_mode_manager_linux.cc
@@ -227,13 +227,15 @@ void DarkModeManagerLinux::SetAccentColor(dbus_utils::Variant variant) {
     accent_color = SkColorSetRGB(r * 255, g * 255, b * 255);
   }
 
+  // Push the accent color into the toolkit UI. Each toolkit routes it through
+  // its `OsSettingsProvider` (`OsSettingsProviderGtk`/`OsSettingsProviderQt`),
+  // which updates `NativeTheme::user_color()` via
+  // `UpdateVariablesForToolkitSettings()` and notifies observers. Writing
+  // `user_color` directly here would race with that provider-sourced write and
+  // could be clobbered back to `nullopt` (crbug.com/536445418).
   for (ui::LinuxUiTheme* linux_ui_theme : *linux_ui_themes_) {
     linux_ui_theme->SetAccentColor(accent_color);
   }
-
-  auto* const native_theme = NativeTheme::GetInstanceForNativeUi();
-  native_theme->set_user_color(accent_color);
-  native_theme->NotifyOnNativeThemeUpdated();
 }
 
 }  // namespace ui
diff --git a/ui/gtk/gtk_ui.cc b/ui/gtk/gtk_ui.cc
index 441a77db1f20138fff05c877382a00b9f36af56d..794823a482d082967298937c563b4dd123596998 100644
--- a/ui/gtk/gtk_ui.cc
+++ b/ui/gtk/gtk_ui.cc
@@ -693,7 +693,11 @@ void GtkUi::SetDarkTheme(bool dark) {
 
 void GtkUi::SetAccentColor(std::optional<SkColor> accent_color) {
   accent_color_ = accent_color;
-  native_theme_->NotifyOnNativeThemeUpdated();
+  // Route the accent color through the OS settings provider. This updates
+  // `NativeTheme::user_color()` (via `UpdateVariablesForToolkitSettings()`) and
+  // notifies all observing native themes, which re-runs the native color mixer
+  // using the freshly-set `accent_color_`.
+  os_settings_provider_->SetAccentColor(accent_color);
 }
 
 bool GtkUi::AnimationsEnabled() const {
diff --git a/ui/gtk/os_settings_provider_gtk.cc b/ui/gtk/os_settings_provider_gtk.cc
index 884b6815d0c5a8c37e471c7b584a2726f2f57c5e..eed6bef8388a4afacd88be96f49db7c5e9d32904 100644
--- a/ui/gtk/os_settings_provider_gtk.cc
+++ b/ui/gtk/os_settings_provider_gtk.cc
@@ -76,6 +76,18 @@ base::TimeDelta OsSettingsProviderGtk::CaretBlinkInterval() const {
                       : base::TimeDelta();
 }
 
+std::optional<SkColor> OsSettingsProviderGtk::AccentColor() const {
+  return accent_color_;
+}
+
+void OsSettingsProviderGtk::SetAccentColor(std::optional<SkColor> accent_color) {
+  if (accent_color_ == accent_color) {
+    return;
+  }
+  accent_color_ = accent_color;
+  NotifyOnSettingsChanged();
+}
+
 ScopedGSignal OsSettingsProviderGtk::ConnectSignal(const gchar* name) {
   return ScopedGSignal(gtk_settings_get_default(), name,
                        base::BindRepeating(&OsSettingsProviderGtk::OnSignal,
