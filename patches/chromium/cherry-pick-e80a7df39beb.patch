Electron adaptation notes (45-x-y): MenuItemView::AddMenuItemViewImpl() on
45-x-y still takes the item as a raw pointer and inserts it with
AddChildViewAt(item, index) (the unique_ptr/insert_index signature landed
after the M156 branch), so the base::AutoReset guard is placed in front of
that call; the destructor CHECK and the inserting_into_menu_ member are
unchanged from upstream.

diff --git a/ui/views/controls/menu/menu_item_view.cc b/ui/views/controls/menu/menu_item_view.cc
index 6b4595a80ef88fd97129335deb2828fc8b709bc0..fcb6f08e43f505f0c4e5188cd2a8a3220a0d472e 100644
--- a/ui/views/controls/menu/menu_item_view.cc
+++ b/ui/views/controls/menu/menu_item_view.cc
@@ -131,6 +131,10 @@ MenuItemView::MenuItemView(MenuDelegate* delegate)
                    delegate) {}
 
 MenuItemView::~MenuItemView() {
+  CHECK(!inserting_into_menu_)
+      << "A menu item was synchronously destroyed while being inserted into a "
+         "menu, possibly by some consumer of the accessibility API. This "
+         "should never happen.";
   SetAnchorView(nullptr);
   // Only the root item holds `controller_`, so walk up to the root to also
   // cover destruction of a non-root subtree (e.g. via RemoveMenuItem()). This
@@ -454,6 +458,7 @@ MenuItemView* MenuItemView::AddMenuItemAt(
     item->SetVisible(false);
   }
 
+  base::AutoReset inserting_auto_reset(&item->inserting_into_menu_, true);
   auto* added_item = submenu_->AddChildViewAt(item, index);
 
   added_item->UpdateTooltipText();
diff --git a/ui/views/controls/menu/menu_item_view.h b/ui/views/controls/menu/menu_item_view.h
index 5d05df9b8ec5c873e28a99156b7955620ff57802..9b6343c7ab6f333d2f4e269b92d1f6189367ff55 100644
--- a/ui/views/controls/menu/menu_item_view.h
+++ b/ui/views/controls/menu/menu_item_view.h
@@ -810,6 +810,12 @@ class VIEWS_EXPORT MenuItemView : public View, public LayoutDelegate {
   // and SetIconView() explicitly calls UpdateSelectionBasedStateIfChanged().
   bool update_selection_based_state_in_view_herarchy_changed_ = true;
 
+  // There are cases where menu insertions can lead to synchronous accessibility
+  // events, which can in turn lead to a miscalibrated or malicious
+  // accessibility tool attempting to close the menu mid-insertion. Guard
+  // against the item being destroyed while it is being added.
+  bool inserting_into_menu_ = false;
+
   std::optional<ui::ColorId> foreground_color_id_;
   std::optional<MenuItemBackground> menu_item_background_;
   std::optional<ui::ColorId> selected_color_id_;
