From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eriko Kurimoto <elkurin@chromium.org>
Date: Thu, 22 Oct 2026 07:46:24 -0700
Subject: [CacheStorage] Persist has_range_requested on cached responses

Previously, CacheStorageCache::PutDidCreateEntry did not persist
FetchAPIResponse::has_range_requested in proto::CacheResponse, and
CreateResponse checked whether the response headers contained a Range
header (which is a request header and never present on responses). As a
result, cached responses returned by CacheStorage always had
has_range_requested reset to false.

When an opaque 206 Partial Content or 416 Range Not Satisfiable
response was stored in CacheStorage and later returned by a Service
Worker, ResourceLoader::DidReceiveResponseInternal skipped the check
that rejects opaque range responses for non-range requests.

Persist has_range_requested in proto::CacheResponse, and ensure
CreateResponse also treats opaque 206 and 416 responses as
range-requested even if the stored proto field is unset or false.

Bug: 568894475
Change-Id: I9c4d1f2a3e8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8618165
Commit-Queue: Eriko Kurimoto <elkurin@chromium.org>
Reviewed-by: Mingyu Lei <leimy@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1724757}

Electron adaptation notes (43-x-y):
- M150 does not have the timing_allow_passed proto field (18) or the
  CreateResponse()/PutDidCreateEntry() plumbing for it; only the
  has_range_requested field (19) and its set/read sites are carried.
- M150's CreateResponse() has no local response_type variable, so one is
  introduced (ProtoResponseTypeToFetchResponseType(...)) right before the
  has_range_requested computation that uses it.
- cache_storage_cache_unittest.cc: only the HasRangeRequested test is carried
  (the TimingAllowPassed test depends on the missing field).
- web_tests sw.https.window.js is left at the branch version (test only;
  its context has drifted). range-sw.js and sw-416.https.window.js applied.

diff --git a/content/browser/cache_storage/cache_storage.proto b/content/browser/cache_storage/cache_storage.proto
index 534a5349a67c31ecd18979830ef4baceb4c4683a..ae1c02b209102162d5a454cbc13ea9b2eac54be6 100644
--- a/content/browser/cache_storage/cache_storage.proto
+++ b/content/browser/cache_storage/cache_storage.proto
@@ -80,6 +80,7 @@ message CacheResponse {
   optional int64 padding = 15;
   optional int64 side_data_padding = 16;
   optional bool request_include_credentials = 17;
+  optional bool has_range_requested = 19;
 }
 
 message CacheMetadata {
diff --git a/content/browser/cache_storage/cache_storage_cache.cc b/content/browser/cache_storage/cache_storage_cache.cc
index c5b746bee7162ffa6c61bc007c4100cecab5be7e..fe2abda92d6300649a211288d5e3763537d270c0 100644
--- a/content/browser/cache_storage/cache_storage_cache.cc
+++ b/content/browser/cache_storage/cache_storage_cache.cc
@@ -485,9 +485,19 @@ blink::mojom::FetchAPIResponsePtr CreateResponse(
           ? metadata.response().request_include_credentials()
           : true;
 
-  // While we block most partial responses from being stored, we can have
-  // partial responses for bgfetch or opaque responses.
-  bool has_range_requested = headers.contains(net::HttpRequestHeaders::kRange);
+  network::mojom::FetchResponseType response_type =
+      ProtoResponseTypeToFetchResponseType(metadata.response().response_type());
+
+  // The stored `has_range_requested` bit is supplied by the renderer via
+  // `cache.put()`, and entries written before the proto field was added do not
+  // have it set. Treat opaque 206 and 416 responses as range-requested so
+  // they cannot be replayed to non-range requests.
+  bool has_range_requested =
+      metadata.response().has_range_requested() ||
+      (response_type == network::mojom::FetchResponseType::kOpaque &&
+       (metadata.response().status_code() == net::HTTP_PARTIAL_CONTENT ||
+        metadata.response().status_code() ==
+            net::HTTP_REQUESTED_RANGE_NOT_SATISFIABLE));
 
   return blink::mojom::FetchAPIResponse::New(
       url_list, metadata.response().status_code(),
@@ -2027,6 +2037,8 @@ void CacheStorageCache::PutDidCreateEntry(
   response_metadata->set_side_data_padding(side_data_padding);
   response_metadata->set_request_include_credentials(
       put_context->response->request_include_credentials);
+  response_metadata->set_has_range_requested(
+      put_context->response->has_range_requested);
 
   // Get a temporary copy of the entry pointer before passing it in base::Bind.
   disk_cache::Entry* temp_entry_ptr = put_context->cache_entry.get();
diff --git a/content/browser/cache_storage/cache_storage_cache_unittest.cc b/content/browser/cache_storage/cache_storage_cache_unittest.cc
index ad5f24f8fde011ede9482ce356c85d70ee44acf5..b964d15778bfbd2eefff2fdacaa66bd58f715b70 100644
--- a/content/browser/cache_storage/cache_storage_cache_unittest.cc
+++ b/content/browser/cache_storage/cache_storage_cache_unittest.cc
@@ -61,6 +61,7 @@
 #include "net/base/url_util.h"
 #include "net/disk_cache/disk_cache.h"
 #include "net/http/http_connection_info.h"
+#include "net/http/http_status_code.h"
 #include "storage/browser/blob/blob_storage_context.h"
 #include "storage/browser/quota/quota_manager_proxy.h"
 #include "storage/browser/test/blob_test_utils.h"
@@ -2914,6 +2915,46 @@ TEST_P(CacheStorageCacheTestP, PutFailWriteHeaders) {
                 ->second);
 }
 
+TEST_P(CacheStorageCacheTestP, HasRangeRequested) {
+  EXPECT_TRUE(Keys());
+
+  // Put a response with `has_range_requested = false`.
+  blink::mojom::FetchAPIResponsePtr response = CreateNoBodyResponse();
+  response->has_range_requested = false;
+  EXPECT_TRUE(Put(no_body_request_, std::move(response)));
+
+  // Match the response and verify `has_range_requested` is preserved as
+  // `false`.
+  EXPECT_TRUE(Match(no_body_request_));
+  ASSERT_TRUE(callback_response_);
+  EXPECT_FALSE(callback_response_->has_range_requested);
+
+  // Put a response with `has_range_requested = true`.
+  blink::mojom::FetchAPIResponsePtr response2 = CreateBlobBodyResponse();
+  response2->has_range_requested = true;
+  EXPECT_TRUE(Put(body_request_, std::move(response2)));
+
+  // Match the response and verify `has_range_requested` is preserved as `true`.
+  EXPECT_TRUE(Match(body_request_));
+  ASSERT_TRUE(callback_response_);
+  EXPECT_TRUE(callback_response_->has_range_requested);
+
+  // Opaque 206 and 416 responses force `has_range_requested = true` even if
+  // stored with `has_range_requested = false`.
+  for (int status_code :
+       {net::HTTP_PARTIAL_CONTENT, net::HTTP_REQUESTED_RANGE_NOT_SATISFIABLE}) {
+    blink::mojom::FetchAPIResponsePtr opaque_partial = CreateBlobBodyResponse();
+    opaque_partial->response_type = network::mojom::FetchResponseType::kOpaque;
+    opaque_partial->status_code = status_code;
+    opaque_partial->has_range_requested = false;
+    EXPECT_TRUE(Put(body_request_, std::move(opaque_partial)));
+
+    EXPECT_TRUE(Match(body_request_));
+    ASSERT_TRUE(callback_response_);
+    EXPECT_TRUE(callback_response_->has_range_requested);
+  }
+}
+
 INSTANTIATE_TEST_SUITE_P(CacheStorageCacheTest,
                          CacheStorageCacheTestP,
                          ::testing::Values(false, true));
diff --git a/third_party/blink/web_tests/external/wpt/fetch/range/resources/range-sw.js b/third_party/blink/web_tests/external/wpt/fetch/range/resources/range-sw.js
index dfa537a20a58e5a788a0baa48383a7b9b2405f34..2f25f72e77e6e298781e0d55b15f0c42527afdda 100644
--- a/third_party/blink/web_tests/external/wpt/fetch/range/resources/range-sw.js
+++ b/third_party/blink/web_tests/external/wpt/fetch/range/resources/range-sw.js
@@ -31,6 +31,12 @@ addEventListener('fetch', async event => {
     case 'use-stored-ranged-response':
       useStoredRangeResponse(event);
       return;
+    case 'cache-ranged-response':
+      cacheRangedResponse(event);
+      return;
+    case 'use-cached-ranged-response':
+      useCachedRangeResponse(event);
+      return;
     case 'broadcast-accept-encoding':
       broadcastAcceptEncoding(event);
       return;
@@ -148,6 +154,32 @@ function useStoredRangeResponse(event) {
   }());
 }
 
+const RANGE_CACHE_NAME = 'range-response-cache';
+const RANGE_CACHE_KEY = 'cached-ranged-response';
+
+function cacheRangedResponse(event) {
+  /** @type Request */
+  const request = event.request;
+  const id = new URL(request.url).searchParams.get('id');
+
+  event.waitUntil((async () => {
+    const response = await fetch(event.request);
+    const cache = await caches.open(RANGE_CACHE_NAME);
+    await cache.put(RANGE_CACHE_KEY, response);
+    broadcast({ id });
+  })());
+
+  // Just send back any response, it isn't important for the test.
+  event.respondWith(new Response(''));
+}
+
+function useCachedRangeResponse(event) {
+  event.respondWith((async () => {
+    const cache = await caches.open(RANGE_CACHE_NAME);
+    return cache.match(RANGE_CACHE_KEY);
+  })());
+}
+
 function broadcastAcceptEncoding(event) {
   /** @type Request */
   const request = event.request;
