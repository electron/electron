+TEST_F(IsolatedWorldOriginLockCorsURLLoaderFactoryTest,
+       OpaqueIsolatedWorldOriginOnDefaultFactoryAllowed) {
+  SetUpFactory(/*ignore_isolated_world_origin=*/true, std::nullopt);
