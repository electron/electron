         FileSystemAccessStatus::kInvalidState,
@@ -251,6 +261,16 @@ void FileSystemAccessFileWriterImpl::CloseImpl(CloseCallback callback) {
   }
 
   close_callback_ = std::move(callback);
+  MaybeStartClose();
+}
