+  same_document_navigation->CommitSameDocument();
+  ASSERT_EQ(child, same_document_navigation->GetFinalRenderFrameHost());
+
+  EXPECT_TRUE(old_weak_ptr);
+  EXPECT_EQ(old_id, driver->GetId());
+}
