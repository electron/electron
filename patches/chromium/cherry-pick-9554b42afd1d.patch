+  ASSERT_EQ(prerender_rfh, main_rfh());
+  ASSERT_EQ(driver, GetDriver(prerender_rfh));
+
+  EXPECT_TRUE(old_weak_ptr);
+  EXPECT_EQ(old_id, driver->GetId());
+}
