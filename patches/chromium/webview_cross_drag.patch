From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anonymous <anonymous@electronjs.org>
Date: Thu, 20 Sep 2018 17:47:04 -0700
Subject: feat: allow dragging and dropping between <webview>s.

WebContentsViewDragSecurityInfo::IsValidDragTarget blocks drops onto a
widget whose SiteInstanceGroup differs from the drag source when the drag was
initiated by the same top-level WebContentsView (the browser-side half of
https://crbug.com/59081). Inner WebContents such as <webview> guests drag
through their outermost view, so drags between two guests, or between a guest
and its embedder, are blocked as if they were cross-site drags within one
page. Allow the drop when the source and target widgets belong to different
WebContents and at least one of them is a guest, and keep the
SiteInstanceGroup check otherwise.

Originally landed in https://github.com/electron/libchromiumcontent/pull/267

diff --git a/content/browser/web_contents/web_contents_view_drag_security_info.cc b/content/browser/web_contents/web_contents_view_drag_security_info.cc
index bf24f4e2ccff56a2a92c4f11c9318644ea59daff..475c673a25fa1b3cf0e685d7c3ce19baccee6fec 100644
--- a/content/browser/web_contents/web_contents_view_drag_security_info.cc
+++ b/content/browser/web_contents/web_contents_view_drag_security_info.cc
@@ -6,6 +6,7 @@
 
 #include "content/browser/renderer_host/render_widget_host_impl.h"
 #include "content/browser/site_instance_group.h"
+#include "content/browser/web_contents/web_contents_impl.h"
 #include "content/public/common/drop_data.h"
 
 namespace content {
@@ -18,12 +19,14 @@ void WebContentsViewDragSecurityInfo::OnDragInitiated(
     const DropData& drop_data) {
   did_initiate_ = true;
   site_instance_group_id_ = source_rwh->GetSiteInstanceGroup()->GetId();
+  source_rwh_ = source_rwh->GetWeakPtr();
   image_accessible_from_frame_ = drop_data.file_contents_image_accessible;
 }
 
 void WebContentsViewDragSecurityInfo::OnDragEnded() {
   did_initiate_ = false;
   site_instance_group_id_ = SiteInstanceGroupId();
+  source_rwh_ = nullptr;
   image_accessible_from_frame_ = true;
 }
 
@@ -66,6 +69,20 @@ bool WebContentsViewDragSecurityInfo::IsValidDragTarget(
   // browser-side checks only have local tree fragment (potentially with
   // multiple origins) granularity at best, but a drag operation eventually
   // targets one single frame in that local tree fragment.
+  //
+  // Guests drag through their embedder's view, so a drag between two guests,
+  // or between a guest and its embedder, arrives here with `did_initiate_`
+  // set. Treat it like a drag from another top-level WebContents rather than
+  // a cross-site drag within one page.
+  auto* source_contents =
+      source_rwh_ ? WebContentsImpl::FromRenderWidgetHostImpl(source_rwh_.get())
+                  : nullptr;
+  auto* target_contents = WebContentsImpl::FromRenderWidgetHostImpl(target_rwh);
+  if (source_contents && target_contents &&
+      source_contents != target_contents &&
+      (source_contents->IsGuest() || target_contents->IsGuest())) {
+    return true;
+  }
   return target_rwh->GetSiteInstanceGroup()->GetId() == site_instance_group_id_;
 }
 
diff --git a/content/browser/web_contents/web_contents_view_drag_security_info.h b/content/browser/web_contents/web_contents_view_drag_security_info.h
index c083da05cdb709d18496b8cd37765fb3e761a553..510ce1695fe2091801ff9628783d65d69dd0d5fb 100644
--- a/content/browser/web_contents/web_contents_view_drag_security_info.h
+++ b/content/browser/web_contents/web_contents_view_drag_security_info.h
@@ -5,6 +5,7 @@
 #ifndef CONTENT_BROWSER_WEB_CONTENTS_WEB_CONTENTS_VIEW_DRAG_SECURITY_INFO_H_
 #define CONTENT_BROWSER_WEB_CONTENTS_WEB_CONTENTS_VIEW_DRAG_SECURITY_INFO_H_
 
+#include "base/memory/weak_ptr.h"
 #include "content/browser/site_instance_group.h"
 
 namespace content {
@@ -53,6 +54,10 @@ class WebContentsViewDragSecurityInfo {
   // The site instance of the drag origin.
   SiteInstanceGroupId site_instance_group_id_;
 
+  // The widget the drag started from, used to tell whether the drag crosses
+  // into or out of a guest WebContents.
+  base::WeakPtr<RenderWidgetHostImpl> source_rwh_;
+
   // A boolean to hold the accessibility value retrieved from the `DropData`.
   // See https://crbug.com/1264873.
   bool image_accessible_from_frame_ = true;
