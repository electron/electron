Electron adaptation notes (43-x-y):
This branch's AnimationFrameTimingMonitor still holds its client as a Client& (not a Member) and has no worker-thread (LongAnimationFrameWorker) support, so the constructor keeps client_(client) and omits the worker CHECK; the probe_sink_ member, its registration/unregistration in the constructor and Shutdown(), the enabled_ guard, and the Trace() of probe_sink_ were applied as upstream. The Trace() hunk's task_attributed_window_/congestion_scripts_/client_ lines refer to members that do not exist here.

Electron adaptation notes (43-x-y):
This branch's AnimationFrameTimingMonitor has no congestion_scripts_ or task_attributed_window_ members (worker congestion tracking landed later), so Shutdown() clears only current_frame_timing_info_ and current_scripts_; the enabled_ guard at the top of OnWorkerTaskCompleted() was applied as upstream.

diff --git a/third_party/blink/renderer/core/frame/animation_frame_timing_monitor.cc b/third_party/blink/renderer/core/frame/animation_frame_timing_monitor.cc
index 719437179d38331ea140052b19274c6a289b857f..b4d5116ae6e35e8352cfedb0b815022d80f9b707 100644
--- a/third_party/blink/renderer/core/frame/animation_frame_timing_monitor.cc
+++ b/third_party/blink/renderer/core/frame/animation_frame_timing_monitor.cc
@@ -41,15 +41,21 @@ constexpr base::TimeDelta kLongScriptDuration = base::Milliseconds(5);
 
 AnimationFrameTimingMonitor::AnimationFrameTimingMonitor(Client& client,
                                                          CoreProbeSink* sink)
-    : client_(client) {
+    : client_(client), probe_sink_(sink) {
   Thread::Current()->AddTaskTimeObserver(this);
-  sink->AddAnimationFrameTimingMonitor(this);
+  if (probe_sink_) {
+    probe_sink_->AddAnimationFrameTimingMonitor(this);
+  }
   enabled_ = true;
 }
 
 void AnimationFrameTimingMonitor::Shutdown() {
   enabled_ = false;
   frame_handling_input_ = nullptr;
+  if (probe_sink_) {
+    probe_sink_->RemoveAnimationFrameTimingMonitor(this);
+    probe_sink_ = nullptr;
+  }
   Thread::Current()->RemoveTaskTimeObserver(this);
 }
 
@@ -193,6 +199,9 @@ void AnimationFrameTimingMonitor::OnTaskCompleted(
     base::TimeTicks start_time,
     base::TimeTicks end_time,
     LocalFrame* frame) {
+  if (!enabled_) {
+    return;
+  }
   HeapVector<Member<ScriptTimingInfo>> scripts;
 
   bool did_pause = false;
@@ -527,6 +536,7 @@ void AnimationFrameTimingMonitor::Trace(Visitor* visitor) const {
   visitor->Trace(current_frame_timing_info_);
   visitor->Trace(current_scripts_);
   visitor->Trace(frame_handling_input_);
+  visitor->Trace(probe_sink_);
 }
 
