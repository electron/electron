From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sky Debreuil <skydebreuil@google.com>
Date: Tue, 13 Oct 2026 18:10:24 -0700
Subject: [a11y] Copy title attribute value in AXNodeObject

Store the title attribute in a local AtomicString rather than a
reference in AXNodeObject::Description(), and take it by value in
AXNodeObject::TextAlternativeFromTitleAttribute(), matching how other
attribute reads in Blink avoid holding references into element
attribute storage across calls that may update it.

Change-Id: Ie67fb6fd2bcddf55d5bfe506a4d33d8e5f1f5efd
Bug: 571618833
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8551193
Reviewed-by: Lucas Radaelli <lucasradaelli@google.com>
Auto-Submit: Sky Debreuil <skydebreuil@google.com>
Reviewed-by: David Tseng <dtseng@chromium.org>
Commit-Queue: Sky Debreuil <skydebreuil@google.com>
Cr-Commit-Position: refs/heads/main@{#1718179}

diff --git a/third_party/blink/renderer/modules/accessibility/ax_node_object.cc b/third_party/blink/renderer/modules/accessibility/ax_node_object.cc
index 714eff702a8248a22694e176e35db01779070f83..2d0614f77c3b54cc5344b6d812f00124a1f038ea 100644
--- a/third_party/blink/renderer/modules/accessibility/ax_node_object.cc
+++ b/third_party/blink/renderer/modules/accessibility/ax_node_object.cc
@@ -7109,7 +7109,7 @@ String AXNodeObject::TextAlternativeFromTooltip(
 }
 
 String AXNodeObject::TextAlternativeFromTitleAttribute(
-    const AtomicString& title,
+    AtomicString title,
     ax::mojom::blink::NameFrom& name_from,
     NameSources* name_sources,
     bool* found_text_alternative) const {
@@ -8042,7 +8042,8 @@ String AXNodeObject::Description(
           DescriptionSource(found_description, kTitleAttr));
       description_sources->back().type = description_from;
     }
-    const AtomicString& title = element->FastGetAttribute(kTitleAttr);
+    // Copy title as computing inner text can modify the attribute storage.
+    const AtomicString title = element->FastGetAttribute(kTitleAttr);
     if (!title.empty() &&
         String(title).StripWhiteSpace() !=
             element->GetInnerTextWithoutUpdate().StripWhiteSpace()) {
diff --git a/third_party/blink/renderer/modules/accessibility/ax_node_object.h b/third_party/blink/renderer/modules/accessibility/ax_node_object.h
index d561c18ed4ac63b4d4daeddca43481df39fff460..b4aee8e9509596f75f8d86528dbb03a6c696f8e4 100644
--- a/third_party/blink/renderer/modules/accessibility/ax_node_object.h
+++ b/third_party/blink/renderer/modules/accessibility/ax_node_object.h
@@ -392,8 +392,9 @@ class MODULES_EXPORT AXNodeObject : public AXObject {
       String* text_alternative,
       AXRelatedObjectVector* related_objects) const;
 
+  // Takes title by value as computing inner text can modify attribute storage.
   String TextAlternativeFromTitleAttribute(
-      const AtomicString& title,
+      AtomicString title,
       ax::mojom::blink::NameFrom& name_from,
       NameSources* name_sources,
       bool* found_text_alternative) const;
