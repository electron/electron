+<!DOCTYPE HTML>
+<html>
+<head>
+  <title>drawElementImage does not leak visited colors in SVG use content from outside the subtree</title>
+  <link rel="help" href="https://github.com/WICG/html-in-canvas">
+  <link rel="author" href="mailto:schenney@chromium.org">
+  <script src='/resources/testharness.js'></script>
+  <script src='/resources/testharnessreport.js'></script>
+  <script src='/html/canvas/resources/canvas-tests.js'></script>
+  <script src="/html/canvas/resources/wait-for-canvas-paint.js"></script>
+  <style>
+    #link {
+      fill: green;
+      stroke: lightgreen;
+    }
+    #link:visited {
+      fill: red;
+      stroke: lightred;
+    }
+  </style>
+</head>
+<body>
+  <svg width="0" height="0">
+    <defs>
+      <a id=link href="">
+        <rect x=10 y=10 width=80 height=80 stroke-width=10 />
+      </a>
+    </defs>
+  </svg>
+  <canvas id=canvas width="100" height="200" layoutsubtree>
+    <svg id="child" x=0 y=0 width=100 height=100>
+      <use id="chained" x=0 y=0  href="#link" />
+      <use x=0 y=0  href="#chained" />
+    </svg>
+  </canvas>
+
+  <script>
+    window.onload = () => {
+      promise_test(async function(t) {
+        await waitForCanvasPaint(canvas);
+        const context = canvas.getContext("2d");
+        context.drawElementImage(document.getElementById("child"), 0, 0);
+
+        // Fetch all pixel data once to avoid multiple slow readbacks.
+        const imgData = context.getImageData(0, 0, canvas.width, canvas.height);
+
+        // Visited link colors should not be used
+        pixel = _getPixelFromImageData(imgData, 50, 50);
+        assert_array_equals(pixel, [0, 128, 0, 255], "Unvisited color should be used");
+      });
+    }
+  </script>
+</body>
+</html>
