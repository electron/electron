From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stephen Nusko <nuskos@chromium.org>
Date: Wed, 4 Nov 2026 00:24:02 -0800
Subject: Use std::ranges::fill and base::span in PartitionRoot

Replaces std::fill_n on slot_usage with std::ranges::fill over a
base::span subspan to improve bounds safety and tracking.

Bug: 581351423
Change-Id: Ic3a9a35e86c4b913211c759a1e35a82dfa685e70
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8723328
Reviewed-by: Kalvin Lee <kdlee@chromium.org>
Commit-Queue: Kalvin Lee <kdlee@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1734865}

diff --git a/base/allocator/partition_allocator/src/partition_alloc/partition_root.cc b/base/allocator/partition_allocator/src/partition_alloc/partition_root.cc
index fc87352fdd6064f3821d808085c9ef10b1277002..9f28729355de794cb63a6848281fe96a060a419b 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/partition_root.cc
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_root.cc
@@ -22,6 +22,7 @@
 #include "partition_alloc/partition_alloc_base/bits.h"
 #include "partition_alloc/partition_alloc_base/compiler_specific.h"
 #include "partition_alloc/partition_alloc_base/component_export.h"
+#include "partition_alloc/partition_alloc_base/containers/span.h"
 #include "partition_alloc/partition_alloc_base/thread_annotations.h"
 #include "partition_alloc/partition_alloc_check.h"
 #include "partition_alloc/partition_alloc_config.h"
@@ -415,7 +416,7 @@ static size_t PartitionPurgeSlotSpan(PartitionRoot* root,
   // DiscardVirtualMemory makes the contents of discarded memory undefined.
   size_t last_slot = static_cast<size_t>(-1);
 #endif
-  std::fill_n(slot_usage.begin(), num_provisioned_slots, 1);
+  std::ranges::fill(base::span(slot_usage).first(num_provisioned_slots), 1);
   SlotSpanStart slot_span_start =
       internal::SlotSpanMetadata::ToSlotSpanStart(slot_span, root);
   // First, walk the freelist for this slot span and make a bitmap of which
