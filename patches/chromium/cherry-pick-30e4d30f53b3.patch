From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kylechar <kylechar@chromium.org>
Date: Wed, 21 Oct 2026 06:30:22 -0700
Subject: Fix ImageContext thread safety

SkiaOutputSurfaceImpl was resetting the ImageContextImpl SkImage in two
places. This isn't thread safe as it's possible SkImage is being
accessed on the GPU thread at the same time.

First, before sending the ImageContextImpl to the GPU main thread to be
deleted. This just wasn't needed.

Second, it was resetting non-overlay render pass SkImages each time they
were drawn. This was in case the render pass backing changed and a new
SkImage was needed. SkiaRenderer::UpdateRenderPassTextures() already
calls RemoveRenderPassResource() for any render pass backings that need
to be reallocated which deletes the ImageContextImpl. A new
ImageContextImpl and SkImage will be created in that case.

Bug: 574030524
Change-Id: Ic25d3d10daf8f719757a42d73710dbab7095328e
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8608392
Commit-Queue: Kyle Charbonneau <kylechar@chromium.org>
Reviewed-by: Bo Liu <boliu@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1723735}

Electron adaptation notes (43-x-y):
ImageContext on M150 still has a single gpu::SyncToken sync_token_ member
(not sync_tokens_) and carries Electron's offscreen-rendering
paint_op_buffer/clear_color accessors; those are kept while SetImage() is
moved, clear_image() becomes protected and mailbox_/texture_target_ become
const as upstream.

diff --git a/components/viz/service/display/external_use_client.h b/components/viz/service/display/external_use_client.h
index 45928e1d5f6d7e9ebcc5d994a103fd645550ad9d..d545003808e6a4eecb190537c1cba949e868bec4 100644
--- a/components/viz/service/display/external_use_client.h
+++ b/components/viz/service/display/external_use_client.h
@@ -55,10 +55,9 @@ class VIZ_SERVICE_EXPORT ExternalUseClient {
     virtual void OnContextLost();
 
     //
-    // Thread safety is guaranteed by these invariants: (a) only the compositor
-    // thread modifies ImageContext, (b) ImageContext is not modified after
-    // |image| is set, and (c) GPU thread only reads ImageContext after |image|
-    // is set.
+    // Thread safety is guaranteed by these invariants: (a) only the viz thread
+    // modifies ImageContext, (b) ImageContext is not modified after |image| is
+    // set, and (c) GPU thread only reads ImageContext after |image| is set.
     //
     const gpu::Mailbox& mailbox() const { return mailbox_; }
     uint32_t texture_target() const { return texture_target_; }
@@ -85,11 +84,6 @@ class VIZ_SERVICE_EXPORT ExternalUseClient {
 
     bool has_image() { return !!image_; }
     sk_sp<SkImage> image() { return image_; }
-    void SetImage(sk_sp<SkImage> image,
-                  std::vector<GrBackendFormat> backend_formats);
-    void SetImage(sk_sp<SkImage> image,
-                  std::vector<skgpu::graphite::TextureInfo> texture_infos);
-    void clear_image() { image_.reset(); }
     const std::vector<GrBackendFormat>& backend_formats() {
       return backend_formats_;
     }
@@ -108,10 +102,22 @@ class VIZ_SERVICE_EXPORT ExternalUseClient {
       clear_color_ = color;
     }
 
+    // SkImage and texture info MUST not be modified after they are initially
+    // set on the viz thread.
+    void SetImage(sk_sp<SkImage> image,
+                  std::vector<GrBackendFormat> backend_formats);
+    void SetImage(sk_sp<SkImage> image,
+                  std::vector<skgpu::graphite::TextureInfo> texture_infos);
+
+   protected:
+    // Resetting the image is only safe to do when ImageContext is no longer
+    // held on the viz thread, eg. during the destructor.
+    void clear_image() { image_.reset(); }
+
    private:
-    gpu::Mailbox mailbox_;
+    const gpu::Mailbox mailbox_;
     gpu::SyncToken sync_token_;
-    uint32_t texture_target_;
+    const uint32_t texture_target_;
 
     const gfx::Size size_;
     const SharedImageFormat format_;
@@ -126,7 +132,7 @@ class VIZ_SERVICE_EXPORT ExternalUseClient {
     // android video.
     std::optional<gpu::VulkanYCbCrInfo> ycbcr_info_;
 
-    // The promise image which is used on display thread.
+    // The promise image which is used on the GPU thread.
     sk_sp<SkImage> image_;
     std::vector<GrBackendFormat> backend_formats_;
     std::vector<skgpu::graphite::TextureInfo> texture_infos_;
diff --git a/components/viz/service/display_embedder/skia_output_surface_impl.cc b/components/viz/service/display_embedder/skia_output_surface_impl.cc
