Electron adaptation notes (42-x-y):
In Chromium 148 MimeHandlerStreamManager has not yet been moved to
extensions/browser/mime_handler/; the identical DidFinishNavigation() lives
in chrome/browser/pdf/pdf_viewer_stream_manager.cc (PdfViewerStreamManager),
which Electron compiles via chromium_src/BUILD.gn. Both code hunks were
applied there verbatim. The unit-test hunks (chrome/browser/pdf/*_unittest.cc,
not built by Electron) were dropped.

diff --git a/chrome/browser/pdf/pdf_viewer_stream_manager.cc b/chrome/browser/pdf/pdf_viewer_stream_manager.cc
index 9a569aeca5e3453c06ec6cf1be7f68e6088ef2b0..a59d8f97f83ef8e85bb9448f31b360591286a8df 100644
--- a/chrome/browser/pdf/pdf_viewer_stream_manager.cc
+++ b/chrome/browser/pdf/pdf_viewer_stream_manager.cc
@@ -475,6 +475,10 @@ void PdfViewerStreamManager::DidFinishNavigation(
     ClearContentNavigationCrashKeys();
   }
 
+  if (!navigation_handle->HasCommitted()) {
+    return;
+  }
+
   // Maybe set up postMessage support after the PDF content host finishes
   // navigating.
   if (MaybeSetUpPostMessage(navigation_handle)) {
@@ -505,7 +509,6 @@ void PdfViewerStreamManager::DidFinishNavigation(
     if (url == pdf_extension_url &&
         stream_info->extension_host_frame_tree_node_id() ==
             navigation_handle->GetFrameTreeNodeId() &&
-        navigation_handle->HasCommitted() &&
         !navigation_handle->IsErrorPage()) {
