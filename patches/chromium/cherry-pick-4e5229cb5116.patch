 class RenderWidgetHostViewAuraReentrantDestructionIME
@@ -7005,6 +7018,41 @@ TEST_F(RenderWidgetHostViewAuraReentrantDestructionIME,
   GetTextInputManager(view_)->UpdateTextInputState(view_, state);
