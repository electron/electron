+  if (gl_api) {
+    DrainGLErrors(gl_api);
+  }
+
   std::vector<GrBackendSemaphore> begin_semaphores;
   std::vector<GrBackendSemaphore> end_semaphores;
 
@@ -2046,6 +2070,14 @@ void RasterDecoderImpl::DoWritePixelsINTERNAL(GLint x_offset,
