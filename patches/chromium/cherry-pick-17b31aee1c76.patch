     ExceptionState& exception_state) {
-  rust::String prefix;
-  rust::String uri;
-
-  while (namespaces_next(namespaces, prefix, uri)) {
-    AtomicString namespace_q_name = g_xmlns_atom;
-    if (prefix.length()) {
