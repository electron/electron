+<title>Chrome issue 567611695</title>
+<link rel="help" href="https://crbug.com/567611695">
+<script>
+  const w = new Worker(URL.createObjectURL(new Blob([`
+    const x = new OffscreenCanvas(1, 1).getContext('2d');
+    x.filter = 'blur(calc(1px * sign(1%))) ';
