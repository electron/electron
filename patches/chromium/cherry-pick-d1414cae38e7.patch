+    <img id="image" src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='blue' width='100' height='100'/></svg>#svgView(viewBox(0,0,50,25);transform(scale(1)))">
