From: Shelley Vohr <shelley.vohr@gmail.com>
Date: Mon, 1 Jun 2020 15:30:47 -0800
Subject: fix: export zlib symbols

This patch sets ZLIB_DLL so that we properly export zlib symbols.

diff --git a/third_party/zlib/BUILD.gn b/third_party/zlib/BUILD.gn
index 61b3eb38c8a576bc076722380b9ab539dfe84a5c..d5f2914d526f6ebc083ee50bed589ac42754f1c7 100644
--- a/third_party/zlib/BUILD.gn
+++ b/third_party/zlib/BUILD.gn
@@ -317,6 +317,10 @@ component("zlib") {
   defines = []
   deps = []
 
+  if (is_win) {
+    defines += [ "ZLIB_DLL" ]
+  }
+
   if (!use_x86_x64_optimizations && !use_arm_neon_optimizations) {
     # Apparently android_cronet bot builds with NEON disabled and
     # we also should disable optimizations for iOS@x86 (a.k.a. simulator).
