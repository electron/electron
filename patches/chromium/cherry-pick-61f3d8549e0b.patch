@@ -7128,6 +7128,13 @@ class DestroyingMockInputMethod : public ui::MockInputMethod {
     }
   }
 
+  void CancelComposition(const ui::TextInputClient* client) override {
+    ui::MockInputMethod::CancelComposition(client);
