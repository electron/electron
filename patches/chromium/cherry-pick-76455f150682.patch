Electron adaptation notes (43-x-y):
Electron's refactor_expose_file_system_access_blocklist.patch moves GenerateBlockPaths() into chrome_file_system_access_permission_context.h on this branch, so the new */.mvn kBlockWrite suffix rule was added to the kBlockPaths table in the header (after the .git/hooks rule) instead of the .cc. The unit test hunk did not merge against this branch's test file and was dropped (test-only; the file is not compiled by Electron).

diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
index 85c9249ac7450e2debb8406c339db3c1369b1ec8..ecaf446100e3b1ca0d3799f6405fc85127d3bd58 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
@@ -617,6 +617,11 @@ class ChromeFileSystemAccessPermissionContext
                                 BlockType::kBlockWrite),
         BlockPath::CreateSuffix(FILE_PATH_LITERAL(".git/modules"),
                                 BlockType::kBlockWrite),
+        // Block write access to */.mvn, which holds Maven project and JVM
+        // configuration (such as jvm.config, maven.config, and extensions.xml),
+        // see crbug.com/578500839.
+        BlockPath::CreateSuffix(FILE_PATH_LITERAL(".mvn"),
+                                BlockType::kBlockWrite),
   #if BUILDFLAG(IS_WIN)
         // Some Windows specific directories to block, basically all apps, the
         // operating system itself, as well as configuration data for apps.
