+  if (HasSrcObject()) {
     mode = kObject;
   } else if (FastHasAttribute(html_names::kSrcAttr)) {
     // Otherwise, if the media element has no assigned media provider object
@@ -3069,8 +3068,7 @@ void HTMLMediaElement::LoadDeferredTracks() {
