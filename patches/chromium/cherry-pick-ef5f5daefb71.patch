From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuoRain <luotianyi@luotianyi.me>
Date: Thu, 29 Oct 2026 11:16:55 -0700
Subject: [ozone/wayland] Do not export toplevels that have no role

XdgForeignWrapper::ExportSurfaceToForeign() exports the root wl_surface
of a WaylandWindow without checking that it currently has an
xdg_toplevel role. The role is created in WaylandToplevelWindow::Show()
and destroyed in WaylandToplevelWindow::Hide(), so a window that has
never been shown, or that has been hidden again, cannot be exported.

Compositors reject such a request: Mutter replies with
WL_DISPLAY_ERROR_INVALID_OBJECT ("exported surface had an invalid role")
and Hyprland with an invalid_surface error ("surface must be an
xdg_toplevel"). libwayland then closes the connection, and
WaylandEventWatcher::WlDisplayCheckForErrors() CHECK-fails, which
crashes the browser. The same is reachable through
LinuxUiDelegate::ExportWindowHandle() by an embedder that parents a
dialog to a window that is not mapped, e.g. Electron's
dialog.showMessageBox() with show: false. See
https://github.com/electron/electron/issues/55141.

Report the failure to the caller instead, which is what
LinuxUiDelegate::ExportWindowHandle() already documents: the callback
runs with an empty handle and the dialog is shown without a parent. Keep
that empty handle intact in LinuxUiDelegateWayland instead of turning it
into a "wayland:" prefix with no handle, which is not a valid window
identifier.

Add a mock zxdg_exporter_v2 to the Wayland test compositor, and unit
tests covering the visible and the non-visible cases at both the wrapper
and the LinuxUiDelegate level.

Unit-tests are removed as Electron doesn't run Chromium tests.

Fixed: 576731833
Change-Id: I1764701d8ed9d477e89940b5d7cf1afa71810759
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8640149
Reviewed-by: Kramer Ge <fangzhoug@chromium.org>
Reviewed-by: Thomas Anderson <thomasanderson@chromium.org>
Commit-Queue: Kramer Ge <fangzhoug@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1730546}

diff --git a/ui/ozone/platform/wayland/host/linux_ui_delegate_wayland.cc b/ui/ozone/platform/wayland/host/linux_ui_delegate_wayland.cc
index 8ba73e10a0754ab6ca166feb435639c4a21d219c..833ef0620bd138da77cfc661e5ed6abc0a617a74 100644
--- a/ui/ozone/platform/wayland/host/linux_ui_delegate_wayland.cc
+++ b/ui/ozone/platform/wayland/host/linux_ui_delegate_wayland.cc
@@ -47,7 +47,7 @@ void LinuxUiDelegateWayland::ExportWindowHandle(
   DCHECK_EQ(toplevel_parent->type(), PlatformWindowType::kWindow);
 
   foreign->ExportSurfaceToForeign(
-      toplevel_parent,
+      toplevel_parent->AsWaylandToplevelWindow(),
       base::BindOnce(&LinuxUiDelegateWayland::OnHandleForward,
                      weak_factory_.GetWeakPtr(), std::move(callback)));
 }
@@ -55,6 +55,12 @@ void LinuxUiDelegateWayland::ExportWindowHandle(
 void LinuxUiDelegateWayland::OnHandleForward(
     base::OnceCallback<void(std::string)> callback,
     const std::string& handle) {
+  // An empty handle means export failed; return it as-is instead of a
+  // "wayland:" prefix with no handle.
+  if (handle.empty()) {
+    std::move(callback).Run(std::string());
+    return;
+  }
   std::move(callback).Run("wayland:" + handle);
 }
 
diff --git a/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.cc b/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.cc
index 99b1e8690cbef75125a774e08552972a38be9058..6a20f6c88ee751b5156dfac0a75544a795f02885 100644
--- a/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.cc
+++ b/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.cc
@@ -12,8 +12,8 @@
 #include "base/logging.h"
 #include "base/memory/raw_ptr.h"
 #include "ui/ozone/platform/wayland/host/wayland_connection.h"
+#include "ui/ozone/platform/wayland/host/wayland_toplevel_window.h"
 #include "ui/ozone/platform/wayland/host/wayland_window.h"
-#include "ui/platform_window/platform_window_init_properties.h"
 
 namespace ui {
 
@@ -228,9 +228,15 @@ XdgForeignWrapper::XdgForeignWrapper(WaylandConnection* connection) {
 
 XdgForeignWrapper::~XdgForeignWrapper() = default;
 
-void XdgForeignWrapper::ExportSurfaceToForeign(WaylandWindow* window,
+void XdgForeignWrapper::ExportSurfaceToForeign(WaylandToplevelWindow* window,
                                                OnHandleExported cb) {
-  DCHECK_EQ(window->type(), PlatformWindowType::kWindow);
+  // The xdg_toplevel role only exists while the window is visible; exporting
+  // a surface without it is a protocol error that closes the connection.
+  if (!window->IsVisible()) {
+    std::move(cb).Run(std::string());
+    return;
+  }
+
   auto* surface = window->root_surface()->surface();
   impl_->ExportSurfaceToForeign(surface, std::move(cb));
 }
diff --git a/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.h b/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.h
index cd9969325271efa0e8e17088070d6097e69dfdeb..ab024d30769a6a52d82692d85a3dae6dabab9231 100644
--- a/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.h
+++ b/ui/ozone/platform/wayland/host/xdg_foreign_wrapper.h
@@ -15,6 +15,7 @@
 namespace ui {
 
 class WaylandConnection;
+class WaylandToplevelWindow;
 
 // A wrapper for xdg foreign objects. Exports surfaces that have xdg_surface
 // roles and asynchronously returns handles for them. Only xdg_surface surfaces
@@ -45,8 +46,9 @@ class XdgForeignWrapper : public wl::GlobalObjectRegistrar<XdgForeignWrapper>,
 
   // Exports |window|'s wl_surface and asynchronously returns a handle for that
   // via the |cb|. Please note that wl_surface that has xdg_surface role can be
-  // exported.
-  void ExportSurfaceToForeign(WaylandWindow* window, OnHandleExported cb);
+  // exported. Runs |cb| with an empty handle if |window| is not visible.
+  void ExportSurfaceToForeign(WaylandToplevelWindow* window,
+                              OnHandleExported cb);
 
  private:
   explicit XdgForeignWrapper(WaylandConnection* connection);
