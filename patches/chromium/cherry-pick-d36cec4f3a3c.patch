+// Verify that the browser rejects a synchronous about:blank commit from a
+// sandboxed iframe that reports an opaque origin with the expected precursor
+// but a different nonce. The iframe commits in its parent's process, so a
+// compromised renderer could otherwise claim the opaque origin of a sandboxed
+// document with the same precursor in a separate sandboxed process (e.g. one
+// sandboxed by a CSP response header), and get browser-side access to its
+// StorageKey (e.g. BroadcastChannel). See https://crbug.com/573236782.
+IN_PROC_BROWSER_TEST_F(SecurityExploitBrowserTest,
+                       SandboxedIframeSyncCommitWithMismatchedOpaqueNonce) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kUseSandboxTokenForOriginDerivation)) {
+    GTEST_SKIP() << "Nonces are only synchronized with sandbox origin tokens.";
+  }
+  GURL main_url(embedded_test_server()->GetURL("a.com", "/title1.html"));
+  EXPECT_TRUE(NavigateToURL(shell(), main_url));
+
+  FrameTreeNode* root = static_cast<WebContentsImpl*>(shell()->web_contents())
+                            ->GetPrimaryFrameTree()
+                            .root();
+  url::Origin parent_origin =
+      root->current_frame_host()->GetLastCommittedOrigin();
+  EXPECT_FALSE(parent_origin.opaque());
+
+  // Report an opaque origin with the same precursor as the expected sandboxed
+  // origin, but a different nonce.
+  SyncAboutBlankCommitOriginReplacer replacer(
+      shell()->web_contents(), parent_origin.DeriveNewOpaqueOrigin());
+  RenderProcessHostBadIpcMessageWaiter kill_waiter(
+      root->current_frame_host()->GetProcess());
+
+  ExecuteScriptAsync(root,
+                     "var iframe = document.createElement('iframe');"
+                     "iframe.sandbox = '';"
+                     "iframe.src = 'about:blank';"
+                     "document.body.appendChild(iframe);");
+
+  EXPECT_EQ(bad_message::RFHI_SYNCHRONOUS_COMMIT_ORIGIN_MISMATCH,
+            kill_waiter.Wait());
+}
+
+// Same as above, but for a sandboxed popup.
+IN_PROC_BROWSER_TEST_F(SecurityExploitBrowserTest,
+                       SandboxedPopupSyncCommitWithMismatchedOpaqueNonce) {
+  if (!base::FeatureList::IsEnabled(
+          blink::features::kUseSandboxTokenForOriginDerivation)) {
+    GTEST_SKIP() << "Nonces are only synchronized with sandbox origin tokens.";
+  }
+  GURL main_url(embedded_test_server()->GetURL(
+      "a.com",
+      "/set-header?Content-Security-Policy: sandbox allow-scripts "
+      "allow-popups"));
+  EXPECT_TRUE(NavigateToURL(shell(), main_url));
+
+  FrameTreeNode* root = static_cast<WebContentsImpl*>(shell()->web_contents())
+                            ->GetPrimaryFrameTree()
+                            .root();
+  url::Origin opener_origin =
+      root->current_frame_host()->GetLastCommittedOrigin();
+  EXPECT_TRUE(opener_origin.opaque());
+
+  // Report an opaque origin with the same precursor as the expected sandboxed
+  // origin, but a different nonce.
+  std::unique_ptr<SyncAboutBlankCommitOriginReplacer> replacer;
+  auto subscription = RegisterWebContentsCreationCallback(
+      base::BindLambdaForTesting([&](WebContents* web_contents) {
+        replacer = std::make_unique<SyncAboutBlankCommitOriginReplacer>(
+            web_contents, opener_origin.DeriveNewOpaqueOrigin());
+      }));
+  RenderProcessHostBadIpcMessageWaiter kill_waiter(
+      root->current_frame_host()->GetProcess());
+
+  ExecuteScriptAsync(root, "window.open('about:blank');");
+
+  EXPECT_EQ(bad_message::RFHI_SYNCHRONOUS_COMMIT_ORIGIN_MISMATCH,
+            kill_waiter.Wait());
+}
+
