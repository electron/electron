+// Unlocked processes, e.g. for most sites on Android, can commit origins from
+// any site that doesn't require a dedicated process, including file: origins.
+class SecurityExploitUnlockedProcessBrowserTest
+    : public SecurityExploitBrowserTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    SecurityExploitBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitch(switches::kDisableSiteIsolation);
+  }
+};
+
+// Verify that the browser rejects a synchronous about:blank commit from a
+// non-sandboxed iframe in an unlocked process that reports an opaque origin
+// with a file:// precursor. Otherwise, a later commit with that origin would
+// get access to file: URLs. See https://crbug.com/580853808.
+IN_PROC_BROWSER_TEST_F(SecurityExploitUnlockedProcessBrowserTest,
+                       IframeSyncCommitWithFilePrecursor) {
+  GURL main_url(embedded_test_server()->GetURL("a.com", "/title1.html"));
+  EXPECT_TRUE(NavigateToURL(shell(), main_url));
+
+  FrameTreeNode* root = static_cast<WebContentsImpl*>(shell()->web_contents())
+                            ->GetPrimaryFrameTree()
+                            .root();
+  ASSERT_FALSE(root->current_frame_host()
+                   ->GetProcess()
+                   ->GetProcessLock()
+                   .IsLockedToSite());
+
+  SyncAboutBlankCommitOriginReplacer replacer(
+      shell()->web_contents(),
+      url::Origin::Create(GURL("file:///")).DeriveNewOpaqueOrigin());
+  RenderProcessHostBadIpcMessageWaiter kill_waiter(
+      root->current_frame_host()->GetProcess());
+
+  ExecuteScriptAsync(root,
+                     "var iframe = document.createElement('iframe');"
+                     "iframe.src = 'about:blank';"
+                     "document.body.appendChild(iframe);");
+
+  EXPECT_EQ(bad_message::RFHI_SYNCHRONOUS_COMMIT_ORIGIN_MISMATCH,
+            kill_waiter.Wait());
+}
+
+// Same as above, but the iframe reports a file:// origin, which skipped the
+// check before. See https://crbug.com/580853808.
+IN_PROC_BROWSER_TEST_F(SecurityExploitUnlockedProcessBrowserTest,
+                       IframeSyncCommitWithFileOrigin) {
+  GURL main_url(embedded_test_server()->GetURL("a.com", "/title1.html"));
+  EXPECT_TRUE(NavigateToURL(shell(), main_url));
+
+  FrameTreeNode* root = static_cast<WebContentsImpl*>(shell()->web_contents())
+                            ->GetPrimaryFrameTree()
+                            .root();
+  ASSERT_FALSE(root->current_frame_host()
+                   ->GetProcess()
+                   ->GetProcessLock()
+                   .IsLockedToSite());
+
+  SyncAboutBlankCommitOriginReplacer replacer(
+      shell()->web_contents(), url::Origin::Create(GURL("file:///")));
+  RenderProcessHostBadIpcMessageWaiter kill_waiter(
+      root->current_frame_host()->GetProcess());
+
+  ExecuteScriptAsync(root,
+                     "var iframe = document.createElement('iframe');"
+                     "iframe.src = 'about:blank';"
+                     "document.body.appendChild(iframe);");
+
+  EXPECT_EQ(bad_message::RFHI_SYNCHRONOUS_COMMIT_ORIGIN_MISMATCH,
+            kill_waiter.Wait());
+}
