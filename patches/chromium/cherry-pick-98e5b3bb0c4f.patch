+  });
+}
+
+promise_test(async t => {
+  await nextFrames();
+  accessibilityController.rootElement;
+
+  confirm_btn.focus();
+  accessibilityController.rootElement;
+  await nextFrames();
+
+  dialog.focus();
+  map_group.setAttribute('aria-owns', 'item owner');
