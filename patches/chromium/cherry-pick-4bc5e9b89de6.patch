Electron adaptation notes (45-x-y): Electron's
refactor_expose_file_system_access_blocklist.patch moves GenerateBlockPaths()
and its kBlockPaths table from chrome_file_system_access_permission_context.cc
into chrome_file_system_access_permission_context.h so that Electron can call
it, so the new platform-independent ~/.cache kBlockAllChildren rule (and the
reworded comment on the Linux/ChromeOS/Android base::DIR_CACHE rule) are
applied to the header's copy of the table instead of the .cc. The unit test
hunk applied unchanged.

diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
index 553efe32018cd56e4630242cc83ba920052a70b7..53eb33076332cc9ff7dfb0b75387fabff239bf67 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
@@ -585,6 +585,10 @@ class ChromeFileSystemAccessPermissionContext
         // it on all platforms, see crbug.com/569012015.
         BlockPath::CreateRelative(base::DIR_HOME, FILE_PATH_LITERAL(".config"),
                                   BlockType::kBlockAllChildren),
+        // ~/.cache holds caches and virtual environments for cross-platform
+        // tools, so block it on all platforms, see crbug.com/577400245.
+        BlockPath::CreateRelative(base::DIR_HOME, FILE_PATH_LITERAL(".cache"),
+                                  BlockType::kBlockAllChildren),
         // Shell startup files in the home directory, including the ones read by
         // Git Bash on Windows, see crbug.com/558362029.
         BlockPath::CreateRelative(base::DIR_HOME,
@@ -724,8 +728,8 @@ class ChromeFileSystemAccessPermissionContext
         // Block the per-user NSS database, see crbug.com/557367241.
         BlockPath::CreateRelative(base::DIR_HOME, FILE_PATH_LITERAL(".pki"),
                                   BlockType::kBlockAllChildren),
-        // And block all of ~/.cache, matching the similar restrictions on mac
-        // and windows.
+        // Also block base::DIR_CACHE to cover $XDG_CACHE_HOME overrides on Linux
+        // and ChromeOS, and the app cache directory on Android.
         BlockPath::CreateRelative(base::DIR_CACHE, BlockType::kBlockAllChildren),
   #endif
   #if BUILDFLAG(IS_ANDROID)
diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc b/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
index db4b094d0bc251eec21e90089fccb73ede43a18f..6d3fd99909301904607f5caf00449b6cffdd3547 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context_unittest.cc
@@ -727,6 +727,52 @@ TEST_F(ChromeFileSystemAccessPermissionContextTest,
         // BUILDFLAG(IS_ANDROID)
 }
 
+// ~/.cache should be blocked on all platforms even when base::DIR_CACHE points
+// elsewhere (macOS NSCachesDirectory, custom $XDG_CACHE_HOME on Linux/ChromeOS,
+// Android app cache) or does not exist (Windows).
+TEST_F(ChromeFileSystemAccessPermissionContextTest,
+       ConfirmSensitiveEntryAccess_HomeCacheBlockedOnAllPlatforms) {
+  base::FilePath home_dir = temp_dir_.GetPath().AppendASCII("home");
+  ScopedHomeDirOverride home_override = OverrideHomeDir(home_dir);
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+  base::FilePath xdg_cache_dir = temp_dir_.GetPath().AppendASCII("xdg_cache");
+  base::ScopedPathOverride cache_override(base::DIR_CACHE, xdg_cache_dir, true,
+                                          true);
+#endif
+  ResetBlockPath();
+
+  base::FilePath home_cache_dir = home_dir.AppendASCII(".cache");
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(), PathInfo(home_cache_dir),
+                HandleType::kDirectory, AccessTrigger::kOpen),
+            SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(), PathInfo(home_cache_dir),
+                HandleType::kDirectory, AccessTrigger::kSave),
+            SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(),
+                PathInfo(home_cache_dir.AppendASCII("pre-commit")),
+                HandleType::kDirectory, AccessTrigger::kOpen),
+            SensitiveDirectoryResult::kAbort);
+  EXPECT_EQ(ConfirmSensitiveEntryAccessSync(
+                permission_context(),
+                PathInfo(home_cache_dir.AppendASCII("pre-commit")
+                             .AppendASCII("sitecustomize.py")),
+                HandleType::kFile, AccessTrigger::kProgrammaticWrite),
+            SensitiveDirectoryResult::kAbort);
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+  // Custom $XDG_CACHE_HOME / Android cache directory remains blocked too.
+  EXPECT_TRUE(IsOpenAbort(xdg_cache_dir, HandleType::kDirectory));
+  EXPECT_TRUE(IsOpenAbort(xdg_cache_dir.AppendASCII("foo"), HandleType::kFile));
+#endif
+
+  // Sibling directories inside DIR_HOME remain allowed.
+  EXPECT_TRUE(
+      IsOpenAllowed(home_dir.AppendASCII("allowed"), HandleType::kDirectory));
+}
+
