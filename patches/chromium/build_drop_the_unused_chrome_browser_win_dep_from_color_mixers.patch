From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: clavin <clavin@electronjs.org>
Date: Fri, 25 Sep 2026 13:59:50 -0700
Subject: build: drop the unused //chrome/browser/win dep from color mixers

The Windows native color mixer does not include anything from
//chrome/browser/win; the dependency is left over from moving
titlebar_config.h there. On Windows it pulls //chrome/browser/profiles
into Electron's link, whose ProfileKeyedServiceFactory then collides with
the one Electron provides for its spellchecker.

diff --git a/chrome/browser/ui/color/BUILD.gn b/chrome/browser/ui/color/BUILD.gn
index c414911b93955867b5c827af3cef2c768ed2c64b..ee68f5e2fc54a52e29f8cab68da85eef343b1983 100644
--- a/chrome/browser/ui/color/BUILD.gn
+++ b/chrome/browser/ui/color/BUILD.gn
@@ -77,7 +77,6 @@ source_set("mixers") {
   if (is_win) {
     sources += [ "win/native_chrome_color_mixer_win.cc" ]
     deps += [
-      "//chrome/browser/win",
       "//ui/base",
       "//ui/color:accent_color_observer",
       "//ui/native_theme",
