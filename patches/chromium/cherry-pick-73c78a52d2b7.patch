+void IterateFillLayersReversed(const FillLayer* layer, Callback callback) {
   if (!layer) {
     return;
   }
-  IterateFillLayersReveresed(layer->Next(), callback);
+  IterateFillLayersReversed(layer->Next(), callback);
   callback(*layer);
