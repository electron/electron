diff --git a/net/filter/zstd_source_stream.cc b/net/filter/zstd_source_stream.cc
index c1840ca24e2fbe1d20278c9dfd48ba40fdd17a19..4d2f7a2291839d3433fef75264116a37b2342532 100644
--- a/net/filter/zstd_source_stream.cc
+++ b/net/filter/zstd_source_stream.cc
@@ -117,7 +117,7 @@ class ZstdSourceStream : public FilterSourceStream {
   }
 
   void* customMalloc(size_t size) {
-    void* address = malloc(size);
+    void* address = calloc(1, size);
     CHECK(address);
     malloc_sizes_.emplace(address, size);
     total_allocated_ += size;
