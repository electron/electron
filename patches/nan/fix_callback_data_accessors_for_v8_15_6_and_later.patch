From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: deepak1556 <hop2deep@gmail.com>
Date: Mon, 2 Nov 2026 16:30:53 +0900
Subject: Fix callback data accessors for V8 15.6 and later

V8 15.6 introduced FunctionCallbackInfo::DataV2() and
PropertyCallbackInfo::DataV2(), and newer V8 removed Data()
(https://crrev.com/c/8396808).

diff --git a/nan_callbacks_12_inl.h b/nan_callbacks_12_inl.h
index 7e3b135b575eddf7281fc05f9f89a6a2b9ef43d6..f87b185756c08a8fceb112d8e08748e46b955374 100644
--- a/nan_callbacks_12_inl.h
+++ b/nan_callbacks_12_inl.h
@@ -251,9 +251,21 @@ inline void* GetExternalValue(v8::Local<v8::External> ext) {
 
 namespace imp {
 
+template<typename T>
+inline v8::Local<v8::Object> GetCallbackData(const T &info) {
+#if defined(V8_MAJOR_VERSION) &&                                               \
+    (V8_MAJOR_VERSION > 15 ||                                                  \
+     (V8_MAJOR_VERSION == 15 &&                                                \
+      defined(V8_MINOR_VERSION) && V8_MINOR_VERSION >= 6))
+  return info.DataV2().template As<v8::Object>();
+#else
+  return info.Data().template As<v8::Object>();
+#endif
+}
+
 static
 void FunctionCallbackWrapper(const v8::FunctionCallbackInfo<v8::Value> &info) {
-  v8::Local<v8::Object> obj = info.Data().As<v8::Object>();
+  v8::Local<v8::Object> obj = GetCallbackData(info);
   FunctionCallback callback = reinterpret_cast<FunctionCallback>(
       reinterpret_cast<intptr_t>(
           Nan::GetExternalValue(obj->GetInternalField(kFunctionIndex)
@@ -270,7 +282,7 @@ static
