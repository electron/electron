     pFormFillEnv->ProcJavascriptAction();
   }
 }
@@ -889,16 +899,18 @@ FPDF_EXPORT void FPDF_CALLCONV
 FORM_DoDocumentOpenAction(FPDF_FORMHANDLE hHandle) {
