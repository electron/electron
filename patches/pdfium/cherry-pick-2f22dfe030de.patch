diff --git a/fxjs/cjs_app.cpp b/fxjs/cjs_app.cpp
index f56b06625cf2a271dfc97a220db654d1b56c2fbc..d18663d595fc96ec28bdf9c6be7e014018781e29 100644
--- a/fxjs/cjs_app.cpp
