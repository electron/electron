From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Sepez <tsepez@google.com>
Date: Wed, 30 Sep 2026 14:41:23 -0700
Subject: Avoid const_cast when repairing malformed JPEG input data

LibjpegScanlineDecoder previously used a const_cast in
GetWritableSrcData() to mutate the input span in place when repairing
missing trailers or corrupted scanner headers.

Avoid mutating the caller's source span by implementing copy-on-write
in GetWritableSrcData(). When repair is necessary, allocate and populate
an owned DataVector buffer member called `corrected_src_data_`.

-- Remove redundant DCHECK() give checked span usage.

Fixed: 567106301
Change-Id: Icdefd8592b0600333a0b16ef9ecba3329310c365
Reviewed-on: https://pdfium-review.googlesource.com/c/pdfium/+/159210
Reviewed-by: Lei Zhang <thestig@chromium.org>
Commit-Queue: Tom Sepez <tsepez@chromium.org>

Electron adaptation notes (43-x-y):
On this branch the libjpeg scanline decoder still lives in core/fxcodec/jpeg/jpegmodule.cpp as the JpegDecoder class (upstream later split it into libjpeg_scanline_decoder.{h,cpp} as LibjpegScanlineDecoder). The same three method bodies (PatchUpKnownBadHeaderWithInvalidHeight, PatchUpTrailer, GetWritableSrcData), the corrected_src_data_ member and the header comment were ported verbatim into jpegmodule.cpp; no other changes.

diff --git a/core/fxcodec/jpeg/jpegmodule.cpp b/core/fxcodec/jpeg/jpegmodule.cpp
index f4a7977bd35bf95e949bad0d45df531d61b2c73e..e4675551e557f48fa97ffb39cc15a0c1abc638b9 100644
--- a/core/fxcodec/jpeg/jpegmodule.cpp
+++ b/core/fxcodec/jpeg/jpegmodule.cpp
@@ -113,7 +113,7 @@ class JpegDecoder final : public ScanlineDecoder {
   // Patch up the in-memory JPEG header for known bad JPEGs.
   void PatchUpKnownBadHeaderWithInvalidHeight(size_t dimension_offset);
 
-  // Patch up the JPEG trailer, even if it is correct.
+  // Patch up the JPEG trailer if missing.
   void PatchUpTrailer();
 
   pdfium::span<uint8_t> GetWritableSrcData();
@@ -124,6 +124,7 @@ class JpegDecoder final : public ScanlineDecoder {
   static constexpr size_t kSofMarkerByteOffset = 5;
 
   JpegCommon common_ = {};
+  DataVector<uint8_t> corrected_src_data_;  // Must outlive `src_span_`.
   pdfium::raw_span<const uint8_t> src_span_;
   DataVector<uint8_t> scanline_buf_;
   bool decompress_created_ = false;
@@ -329,22 +330,30 @@ bool JpegDecoder::IsSofSegment(size_t marker_offset) const {
 
 void JpegDecoder::PatchUpKnownBadHeaderWithInvalidHeight(
     size_t dimension_offset) {
-  DCHECK(src_span_.size() > dimension_offset + 1u);
-  auto pData = GetWritableSrcData().subspan(dimension_offset);
-  pData[0] = (orig_height_ >> 8) & 0xff;
-  pData[1] = orig_height_ & 0xff;
+  auto corrected_span = GetWritableSrcData().subspan(dimension_offset);
+  corrected_span[0] = (orig_height_ >> 8) & 0xff;
+  corrected_span[1] = orig_height_ & 0xff;
 }
 
 void JpegDecoder::PatchUpTrailer() {
-  auto pData = GetWritableSrcData();
-  pData[src_span_.size() - 2] = 0xff;
-  pData[src_span_.size() - 1] = 0xd9;
+  if (src_span_.size() < 2) {
+    return;
+  }
+  auto trailer_span = src_span_.last<2>();
+  if (trailer_span[0] == 0xff && trailer_span[1] == 0xd9) {
+    return;
+  }
+  auto corrected_trailer_span = GetWritableSrcData().last<2>();
+  corrected_trailer_span[0] = 0xff;
+  corrected_trailer_span[1] = 0xd9;
 }
 
 pdfium::span<uint8_t> JpegDecoder::GetWritableSrcData() {
-  // SAFETY: const_cast<> doesn't change size.
-  return UNSAFE_BUFFERS(
-      pdfium::span(const_cast<uint8_t*>(src_span_.data()), src_span_.size()));
+  if (corrected_src_data_.empty()) {
+    corrected_src_data_.assign(src_span_.begin(), src_span_.end());
+    src_span_ = corrected_src_data_;
+  }
+  return corrected_src_data_;
 }
 
 }  // namespace
