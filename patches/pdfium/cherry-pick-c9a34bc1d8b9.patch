From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Sepez <tsepez@google.com>
Date: Fri, 16 Oct 2026 16:16:56 -0700
Subject: Make ~CFXJSE_FormCalcContext() clear internal binding of value_

This mirrors what ~CFXJSE_Engine() already did for every other bound
object. Also throw an error in V8FunctionCallback_Wrapper should the
binding somehow be gone.

Bug: 574302978
Change-Id: I9778cc265ab2bcb311842ae3c168bb8c842befc0
Reviewed-on: https://pdfium-review.googlesource.com/c/pdfium/+/161150
Reviewed-by: Lei Zhang <thestig@chromium.org>
Commit-Queue: Tom Sepez <tsepez@chromium.org>

Electron adaptation notes (45-x-y): cfxjse_class.cpp conflicted only because upstream's V8FunctionCallback_Wrapper reads the descriptor through info.DataV2() while the branch still uses info.Data(); the branch call is kept and the fix's host-object null check, FXJSE_ThrowMessage("Invalid receiver.") and the pFunctionInfo -> function_info rename are applied as upstream. cfxjse_formcalc_context.cpp applied cleanly.

diff --git a/fxjs/xfa/cfxjse_class.cpp b/fxjs/xfa/cfxjse_class.cpp
index 05007e884b94ee80e1121adebef494e6468a7e4b..47138e938b805baa03ed798b5679765081e682c8 100644
--- a/fxjs/xfa/cfxjse_class.cpp
+++ b/fxjs/xfa/cfxjse_class.cpp
@@ -45,14 +45,21 @@ FXJSE_CLASS_DESCRIPTOR* AsClassDescriptor(void* ptr) {
 
 void V8FunctionCallback_Wrapper(
     const v8::FunctionCallbackInfo<v8::Value>& info) {
-  const FXJSE_FUNCTION_DESCRIPTOR* pFunctionInfo =
+  const FXJSE_FUNCTION_DESCRIPTOR* function_info =
       AsFunctionDescriptor(info.Data().As<v8::External>()->Value(
           v8::kExternalPointerTypeTagDefault));
-  if (!pFunctionInfo) {
+  if (!function_info) {
     return;
   }
 
-  pFunctionInfo->callbackProc(CFXJSE_HostObject::FromV8(info.This()), info);
+  // Reject receivers whose binding has been cleared instead of handing a null
+  // host object to the callback.
+  CFXJSE_HostObject* host_object = CFXJSE_HostObject::FromV8(info.This());
+  if (!host_object) {
+    FXJSE_ThrowMessage(info.GetIsolate(), "Invalid receiver.");
+    return;
+  }
+  function_info->callbackProc(host_object, info);
 }
 
 void V8ConstructorCallback_Wrapper(
diff --git a/fxjs/xfa/cfxjse_formcalc_context.cpp b/fxjs/xfa/cfxjse_formcalc_context.cpp
index b4ab540a5ffecc484463a9d2e75038204fc776e4..25e3c072b406f4ddbf8a4631fe57a4e53fb65d34 100644
--- a/fxjs/xfa/cfxjse_formcalc_context.cpp
+++ b/fxjs/xfa/cfxjse_formcalc_context.cpp
@@ -36,6 +36,7 @@
 #include "fxjs/xfa/cfxjse_class.h"
 #include "fxjs/xfa/cfxjse_context.h"
 #include "fxjs/xfa/cfxjse_engine.h"
+#include "fxjs/xfa/cfxjse_isolatetracker.h"
 #include "fxjs/xfa/cjx_object.h"
 #include "v8/include/v8-container.h"
 #include "v8/include/v8-function-callback.h"
@@ -5124,7 +5125,18 @@ CFXJSE_FormCalcContext::CFXJSE_FormCalcContext(v8::Isolate* pIsolate,
                                  ->GetTemplate(isolate_)));
 }
 
-CFXJSE_FormCalcContext::~CFXJSE_FormCalcContext() = default;
+CFXJSE_FormCalcContext::~CFXJSE_FormCalcContext() {
+  // Clear the binding the same way CFXJSE_Engine does for every other bound
+  // so later calls on the retained object do not see this binding.
+  if (!value_.IsEmpty()) {
+    CFXJSE_ScopeUtil_IsolateHandle scope(GetIsolate());
+    v8::Local<v8::Value> value =
+        v8::Local<v8::Value>::New(GetIsolate(), value_);
+    if (value->IsObject()) {
+      FXJSE_ClearObjectBinding(value.As<v8::Object>());
+    }
+  }
+}
 
 CFXJSE_FormCalcContext* CFXJSE_FormCalcContext::AsFormCalcContext() {
   return this;
