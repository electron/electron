From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Diaz <ryandiaz@chromium.org>
Date: Mon, 12 Oct 2026 18:19:40 +0000
Subject: [wasm][turboshaft] Fix AssertNotNullTypecheck and WasmTypeCheckOp
 effects

AssertNotNullTypecheck discarded the AssertNotNullOp result and
forwarded the original nullable OpIndex, while WasmTypeCheckOp lacked
.CanDependOnChecks(). With --wasm-random-rescheduling, a downstream
WasmTypeCheckOp (expecting a non-nullable input) could be hoisted above
the AssertNotNullOp, causing WasmGCTypedOptimizationReducer to
DCHECK-fail when seeing the unrefined nullable type.

Fix: Set result->op = __ AssertNotNull(...) in AssertNotNullTypecheck and add .CanDependOnChecks() to WasmTypeCheckOp::effects so type checks cannot be scheduled before their guarding null checks.
Bug: 571348848
Change-Id: I10c9cc767fbc1a8a855dfa717c86967148c16690
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8545881
Commit-Queue: Ryan Diaz <ryandiaz@chromium.org>
Reviewed-by: Thibaud Michaud <thibaudm@chromium.org>
Cr-Commit-Position: refs/heads/main@{#110597}

diff --git a/src/compiler/turboshaft/operations.h b/src/compiler/turboshaft/operations.h
index f4cbc24877543231bcc11e667454ef5c0307cd62..18272c24f843f8c5fd276babc4f8762c6a5f1e6c 100644
--- a/src/compiler/turboshaft/operations.h
+++ b/src/compiler/turboshaft/operations.h
@@ -7758,7 +7758,8 @@ struct RttCanonOp : FixedArityOperationT<1, RttCanonOp> {
 struct WasmTypeCheckOp : OperationT<WasmTypeCheckOp> {
   WasmTypeCheckConfig config;
 
-  static constexpr OpEffects effects = OpEffects().AssumesConsistentHeap();
+  static constexpr OpEffects effects =
+      OpEffects().AssumesConsistentHeap().CanDependOnChecks();
 
   WasmTypeCheckOp(V<Object> object, OptionalV<Map> rtt,
                   WasmTypeCheckConfig config)
diff --git a/src/wasm/turboshaft-graph-interface.cc b/src/wasm/turboshaft-graph-interface.cc
index cb4fb458f4569920108b65cea268b3f05eb6e72c..68792a08189dda442b6ba264ce6e331b931d9cd6 100644
--- a/src/wasm/turboshaft-graph-interface.cc
+++ b/src/wasm/turboshaft-graph-interface.cc
@@ -1087,8 +1087,8 @@ class TurboshaftGraphBuildingInterface
 
   void AssertNotNullTypecheck(FullDecoder* decoder, const Value& obj,
                               Value* result) {
-    __ AssertNotNull(obj.get<Object>(), obj.type, TrapId::kTrapIllegalCast);
-    Forward(decoder, obj, result);
+    result->op =
+        __ AssertNotNull(obj.get<Object>(), obj.type, TrapId::kTrapIllegalCast);
   }
 
   void NopForTestingUnsupportedInLiftoff(FullDecoder* decoder) {
