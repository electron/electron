diff --git a/src/interpreter/bytecode-array-builder.cc b/src/interpreter/bytecode-array-builder.cc
index 5162a123765fed16b40e788cdf540a8924cbf5c0..2518527cbc34801b619d9e0a4780aba08991c87c 100644
--- a/src/interpreter/bytecode-array-builder.cc
+++ b/src/interpreter/bytecode-array-builder.cc
@@ -1752,6 +1752,7 @@ SINGLETON_CONSTANT_ENTRY_TYPES(ENTRY_GETTER)
 BytecodeJumpTable* BytecodeArrayBuilder::AllocateJumpTable(
     int size, int case_value_base) {
   DCHECK_GT(size, 0);
+  DCHECK(!RemainderOfBlockIsDead());
 
   size_t constant_pool_index = constant_array_builder()->InsertJumpTable(size);
 
diff --git a/src/interpreter/bytecode-array-writer.cc b/src/interpreter/bytecode-array-writer.cc
index d5823b899af072efe1f48ba0db28c512f6f49df8..6c454a477d36e4ecd2170878e8e1d4e2120655b2 100644
--- a/src/interpreter/bytecode-array-writer.cc
+++ b/src/interpreter/bytecode-array-writer.cc
@@ -164,8 +164,8 @@ void BytecodeArrayWriter::WriteJumpLoop(BytecodeNode* node,
 void BytecodeArrayWriter::WriteSwitch(BytecodeNode* node,
                                       BytecodeJumpTable* jump_table) {
   DCHECK(Bytecodes::IsSwitch(node->bytecode()));
+  CHECK(!exit_seen_in_block_);
 
-  if (exit_seen_in_block_) return;  // Don't emit dead code.
   UpdateExitSeenInBlock(node->bytecode());
   MaybeElideLastBytecode(node->bytecode(), node->source_info().is_valid());
 
