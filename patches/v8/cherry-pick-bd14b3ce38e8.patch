diff --git a/src/maglev/maglev-graph-builder.cc b/src/maglev/maglev-graph-builder.cc
index 1fe3c562efe346e24c1082de882b168c7896975a..c03875cbcaa5ce502ebdc7a1b97cf8a484fd93d2 100644
