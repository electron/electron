+             "}, false);")
+      .ToLocalChecked();
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK(CompileRun(ctx, "!globalThis.getter_ran")
+            .ToLocalChecked()
+            ->BooleanValue(isolate));
+  CHECK_EQ(130, CompileRun(ctx, "globalThis.probe_result")
+                    .ToLocalChecked()
+                    ->Int32Value(ctx)
