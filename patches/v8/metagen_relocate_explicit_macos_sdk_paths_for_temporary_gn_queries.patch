+        self.assertTrue(query_sdk.is_symlink())
+        self.assertEqual(query_sdk.resolve(), sdk.resolve())
+        # Mutating the query's links must not affect the running build.
+        query_sdk.unlink()
+        self.assertTrue((sdk_links / sdk.name).is_symlink())
