index 5b83562318cf553d372fa505abc908efde35f656..9952c84bbafb3e9553e16b6b375fda646edcafb6 100644
--- a/src/debug/debug-scopes.cc
+++ b/src/debug/debug-scopes.cc
@@ -461,7 +461,9 @@ bool ScopeIterator::NeedsContext() const {
   // context should the function need one. In that case the function has already
