From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Gomes <victorgomes@chromium.org>
Date: Wed, 4 Nov 2026 10:01:21 +0100
Subject: [maglev] Merge dead subgraph loops on early abort

When building a loop with MaglevSubGraphBuilder::BeginLoop, an early
abort (e.g. SetPossibleMaps failing with an empty NodeType in
TryReduceArrayPrototypeSort or TryReduceArrayIteratingBuiltin) can
return before EndLoop is reached. That left the loop header in the graph
with an unmerged backedge predecessor and null loop phi input.

Make LoopLabel call MergeDeadLoop in its destructor if EndLoop was not
called.

Fixed: 577305517
Change-Id: I69678bcd0d13f5ca7fed14e9d3aa4cc32d89d8fa
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8689947
Reviewed-by: Leszek Swirski <leszeks@chromium.org>
Commit-Queue: Leszek Swirski <leszeks@chromium.org>
Auto-Submit: Victor Gomes <victorgomes@chromium.org>
Cr-Commit-Position: refs/heads/main@{#111589}

Electron adaptation notes (43-x-y): MaglevSubGraphBuilder::LoopLabel on this branch stores a MergePointInterpreterFrameState* (not LoopMergePointInterpreterFrameState*) and EndLoop calls MergeLoop(builder_, *dummy_unit_, variable_frame_, block); the fix (V8_NODISCARD, deleted copy/move, destructor that MergeDeadLoop()s an unbound label, disarming in EndLoop) is applied on top of those signatures. The DeoptFrameScope classes that precede LoopLabel on this branch are untouched.

diff --git a/src/maglev/maglev-graph-builder.cc b/src/maglev/maglev-graph-builder.cc
index ee79818f7d26772c50db8b08a8ff61666f8437b4..a7ab49a9c0e31badb14c0a0f32ff0061b1516101 100644
--- a/src/maglev/maglev-graph-builder.cc
+++ b/src/maglev/maglev-graph-builder.cc
@@ -434,14 +434,31 @@ class V8_NODISCARD MaglevGraphBuilder::EagerDeoptFrameScope
   MaglevGraphBuilder::LazyDeoptFrameScope* parent_;
 };
 
-class MaglevGraphBuilder::MaglevSubGraphBuilder::LoopLabel {
+class V8_NODISCARD MaglevGraphBuilder::MaglevSubGraphBuilder::LoopLabel {
  public:
+  LoopLabel(const LoopLabel&) = delete;
+  LoopLabel(LoopLabel&&) = delete;
+  LoopLabel& operator=(const LoopLabel&) = delete;
+  LoopLabel& operator=(LoopLabel&&) = delete;
+
+  ~LoopLabel() {
+    if (merge_state_ != nullptr) {
+      // An early abort exited the subgraph before EndLoop was reached.
+      DCHECK_NULL(sub_builder_->builder_->current_block());
+      merge_state_->MergeDeadLoop(*sub_builder_->dummy_unit_);
+    }
+  }
+
  private:
-  explicit LoopLabel(MergePointInterpreterFrameState* merge_state,
-                     BasicBlock* loop_header)
-      : merge_state_(merge_state), loop_header_(loop_header) {}
+  LoopLabel(MaglevSubGraphBuilder* sub_builder,
+            MergePointInterpreterFrameState* merge_state,
+            BasicBlock* loop_header)
+      : sub_builder_(sub_builder),
+        merge_state_(merge_state),
+        loop_header_(loop_header) {}
 
   friend class MaglevSubGraphBuilder;
+  MaglevSubGraphBuilder* sub_builder_;
   MergePointInterpreterFrameState* merge_state_ = nullptr;
   BasicBlock* loop_header_;
 };
@@ -621,7 +638,7 @@ MaglevGraphBuilder::MaglevSubGraphBuilder::BeginLoop(
   builder_->ProcessMergePointPredecessors(*loop_state, loop_header_ref);
   builder_->StartNewBlock(nullptr, loop_state, loop_header_ref);
 
-  return LoopLabel{loop_state, loop_header_ref.block_ptr()};
+  return LoopLabel{this, loop_state, loop_header_ref.block_ptr()};
 }
 
 template <typename ControlNodeT, typename... Args>
@@ -678,8 +695,12 @@ void MaglevGraphBuilder::MaglevSubGraphBuilder::MergeDeadInterpreterFrameState(
 }
 
 void MaglevGraphBuilder::MaglevSubGraphBuilder::EndLoop(LoopLabel* loop_label) {
+  // Ensure EndLoop is called only once and disarm ~LoopLabel().
+  MergePointInterpreterFrameState* merge_state = loop_label->merge_state_;
+  DCHECK_NOT_NULL(merge_state);
+  loop_label->merge_state_ = nullptr;
   if (builder_->current_block() == nullptr) {
-    loop_label->merge_state_->MergeDeadLoop(*dummy_unit_);
+    merge_state->MergeDeadLoop(*dummy_unit_);
     return;
   }
 
@@ -687,10 +708,9 @@ void MaglevGraphBuilder::MaglevSubGraphBuilder::EndLoop(LoopLabel* loop_label) {
       builder_->FinishBlockNoAbort<JumpLoop>({}, loop_label->loop_header_);
   {
     BorrowParentKnownNodeAspectsAndVOs borrow(this);
-    loop_label->merge_state_->MergeLoop(builder_, *dummy_unit_, variable_frame_,
-                                        block);
+    merge_state->MergeLoop(builder_, *dummy_unit_, variable_frame_, block);
   }
-  block->set_predecessor_id(loop_label->merge_state_->predecessor_count() - 1);
+  block->set_predecessor_id(merge_state->predecessor_count() - 1);
 }
 
 void MaglevGraphBuilder::MaglevSubGraphBuilder::Bind(Label* label) {
