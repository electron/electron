From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marco Vitale <mrcvtl@chromium.org>
Date: Tue, 27 Oct 2026 11:02:40 +0000
Subject: [compiler] Mark JSGetTemplateObject as able to write

JSGetTemplateObject was marked as Operator::kEliminatable (which
includes kNoWrite), allowing LoadElimination to keep known maps across
it and eliminate subsequent CheckMaps nodes. However, the first
evaluation of a tagged template literal in a realm freezes the template
array, which copies its map and calls JSObject::OptimizeAsPrototype on
Array.prototype, migrating a dictionary-mode Array.prototype back to
fast properties.

Remove Operator::kNoWrite from JSGetTemplateObject (using
Operator::kNoDeopt | Operator::kNoThrow instead) and keep its control
input when lowering to Builtin::kGetTemplateObject in JSGenericLowering.

Fixed: 574339635
Change-Id: I4477388e8a76abe330ceab265b84cbec6a6a6964
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8668745
Auto-Submit: Marco Vitale <mrcvtl@chromium.org>
Reviewed-by: Darius Mercadier <dmercadier@chromium.org>
Commit-Queue: Darius Mercadier <dmercadier@chromium.org>
Cr-Commit-Position: refs/heads/main@{#111259}

diff --git a/src/compiler/js-generic-lowering.cc b/src/compiler/js-generic-lowering.cc
index c9c32b2c1386e4b002e1edbbfef0bd50da7340a7..13fa5ee1beaad6e7420eb77acf7c2169c463a642 100644
--- a/src/compiler/js-generic-lowering.cc
+++ b/src/compiler/js-generic-lowering.cc
@@ -758,9 +758,6 @@ void JSGenericLowering::LowerJSGetTemplateObject(Node* node) {
   SharedFunctionInfoRef shared = p.shared();
   TemplateObjectDescriptionRef description = p.description();
 
-  DCHECK_EQ(node->op()->ControlInputCount(), 1);
-  node->RemoveInput(NodeProperties::FirstControlIndex(node));
-
   static_assert(JSGetTemplateObjectNode::FeedbackVectorIndex() == 0);
   node->InsertInput(zone(), 0, jsgraph()->ConstantNoHole(shared, broker()));
   node->InsertInput(zone(), 1,
diff --git a/src/compiler/js-operator.cc b/src/compiler/js-operator.cc
index 19c6154dd5685583bc65cadf3b778a06a21a3309..806de879b11de1ef63a34755447026c1ac106f41 100644
--- a/src/compiler/js-operator.cc
+++ b/src/compiler/js-operator.cc
@@ -1599,7 +1599,7 @@ const Operator* JSOperatorBuilder::GetTemplateObject(
   GetTemplateObjectParameters parameters(description, shared, feedback);
   return zone()->New<Operator1<GetTemplateObjectParameters>>(  // --
       IrOpcode::kJSGetTemplateObject,                          // opcode
-      Operator::kEliminatable,                                 // properties
+      Operator::kNoDeopt | Operator::kNoThrow,                 // properties
       "JSGetTemplateObject",                                   // name
       1, 1, 1, 1, 1, 0,                                        // counts
       parameters);                                             // parameter
