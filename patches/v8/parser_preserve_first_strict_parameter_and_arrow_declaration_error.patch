diff --git a/src/parsing/expression-scope.h b/src/parsing/expression-scope.h
index 6c401e44b11a30a9d1d0ea8389709e88194f21eb..a1adbe8091a6d74d42d08f6e2666f0da3357ed5a 100644
--- a/src/parsing/expression-scope.h
+++ b/src/parsing/expression-scope.h
@@ -211,7 +211,8 @@ class ExpressionScope {
       }
     } else if (is_strict(parser_->language_mode())) {
       AsArrowHeadParsingScope()->RecordDeclarationError(loc, message);
-    } else {
+    } else if (!parser_->next_arrow_function_info_
+                    .strict_parameter_error_location.IsValid()) {
       parser_->next_arrow_function_info_.strict_parameter_error_location = loc;
       parser_->next_arrow_function_info_.strict_parameter_error_message =
           message;
diff --git a/src/parsing/parser.h b/src/parsing/parser.h
index 0a52155db3bc87cb9a4add034e72d63c8db4b417..9c01866602ff8d33a8435a5a0567e0c817fc11cd 100644
--- a/src/parsing/parser.h
+++ b/src/parsing/parser.h
@@ -79,6 +79,7 @@ struct ParserFormalParameters : FormalParametersBase {
 
   void set_strict_parameter_error(const Scanner::Location& loc,
                                   MessageTemplate message) {
+    if (strict_error_loc.IsValid()) return;
     strict_error_loc = loc;
     strict_error_message = message;
   }
diff --git a/test/mjsunit/es6/regress-strict-param-error-order.js b/test/mjsunit/es6/regress-strict-param-error-order.js
new file mode 100644
index 0000000000000000000000000000000000000000..ca6c794d29b76bc413d0ab51400f48ef2906e2dd
--- /dev/null
+++ b/test/mjsunit/es6/regress-strict-param-error-order.js
@@ -0,0 +1,32 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Strict mode parameter errors and arrow declaration errors should report
+// the first error encountered in the parameter list rather than overwriting
+// it with later errors.
+
+assertThrows(
+    () => eval('(function f(implements, eval) { "use strict"; })'),
+    SyntaxError,
+    "Unexpected strict mode reserved word");
+assertThrows(
+    () => eval('(implements, eval) => { "use strict"; }'),
+    SyntaxError,
+    "Unexpected strict mode reserved word");
+assertThrows(
+    () => eval('(function f(eval, implements) { "use strict"; })'),
+    SyntaxError,
+    "Unexpected eval or arguments in strict mode");
+assertThrows(
+    () => eval('(eval, implements) => { "use strict"; }'),
+    SyntaxError,
+    "Unexpected eval or arguments in strict mode");
+assertThrows(
+    () => eval("([a.b], 1) => {}"),
+    SyntaxError,
+    "Illegal property in declaration context");
+assertThrows(
+    () => eval("function* g() { (b = yield a, 1) => {}; }"),
+    SyntaxError,
+    "Yield expression not allowed in formal parameter");
