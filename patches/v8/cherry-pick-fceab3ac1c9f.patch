diff --git a/src/compiler/backend/register-allocator.cc b/src/compiler/backend/register-allocator.cc
index 6e85eca1299435970fb042fb41c1d1668a74401e..b4bbdbbe72a77b349bac197fe17cbb4392b71a61 100644
--- a/src/compiler/backend/register-allocator.cc
+++ b/src/compiler/backend/register-allocator.cc
@@ -4406,8 +4406,9 @@ void LinearScanAllocator::AllocateBlockedReg(LiveRange* current,
     InstructionBlock* deferred_block =
         code()->GetInstructionBlock(current->Start().ToInstructionIndex());
     new_end =
-        std::min(new_end, LifetimePosition::GapFromInstructionIndex(
-                              LastDeferredInstructionIndex(deferred_block)));
+        std::min(new_end, LifetimePosition::InstructionFromInstructionIndex(
+                              LastDeferredInstructionIndex(deferred_block))
+                              .NextFullStart());
   }
 
   // We couldn't spill until the next register use. Split before the register
diff --git a/test/unittests/compiler/regalloc/register-allocator-unittest.cc b/test/unittests/compiler/regalloc/register-allocator-unittest.cc
index 875088a20cdf105080514279879aea4214286851..b0627fff43e6e6c40cbf394d660a2e4642cbc622 100644
--- a/test/unittests/compiler/regalloc/register-allocator-unittest.cc
+++ b/test/unittests/compiler/regalloc/register-allocator-unittest.cc
@@ -813,6 +813,48 @@ INSTANTIATE_TEST_SUITE_P(
     ::testing::Combine(::testing::ValuesIn(kParameterTypes),
                        ::testing::Range(0, SlotConstraintTest::kMaxVariant)));
 
+TEST_F(RegisterAllocatorTest, AllocateBlockedRegDeferredClampBelowStart) {
+  SetNumRegs(3, 1);
+
+  // B0 (non-deferred): branch selector `c`, value `d` used at the deferred
+  // jump, and phi inputs `w0..w2` creating register pressure.
+  StartBlock();
+  VReg c = Parameter(Reg());
+  VReg d = Define(Reg());
+  VReg w0 = Define(Reg());
+  VReg w1 = Define(Reg());
+  VReg w2 = Define(Reg());
+  EndBlock(Branch(Reg(c), 1, 2));  // succs: B1 (deferred), B2
+
+  // B1 (deferred): a call clobbers all registers, defs re-occupy all
+  // registers, ending with a jump that uses `d` in a register. The next block
+  // in RPO order (B2) is not deferred.
+  StartBlock(true);
+  EmitCall(Slot(-1));
+  VReg z0 = Define(Reg());
+  VReg z1 = Define(Reg());
+  VReg z2 = Define(Reg());
+  EndBlock(Jump(2, Reg(d)));  // succ: B3
+
+  // B2 (non-deferred; predecessor B0).
+  StartBlock();
+  EmitNop();
+  EndBlock(Jump(1));  // succ: B3
+
+  // B3: merge with phis keeping `z0..z2` live out of B1, and a late use of `d`
+  // so that its split child survives past the B2 block boundary.
+  StartBlock();
+  VReg p0 = Phi(z0, w0);
+  VReg p1 = Phi(z1, w1);
+  VReg p2 = Phi(z2, w2);
+  EmitI(Use(d));
+  EmitI(Use(p0), Use(p1), Use(p2));
+  Return(p0);
+  EndBlock(Last());
+
+  Allocate();
+}
+
 }  // namespace
