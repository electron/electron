diff --git a/src/compiler/escape-analysis-reducer.cc b/src/compiler/escape-analysis-reducer.cc
index 4d54bdf1baa7b5ff4da0524b1b97fb6d2f959f17..1b83aca3b58d0bce37fd403b31f48946b6f35f42 100644
--- a/src/compiler/escape-analysis-reducer.cc
+++ b/src/compiler/escape-analysis-reducer.cc
@@ -309,6 +309,7 @@ void EscapeAnalysisReducer::Finalize() {
               NodeProperties::SetType(load, Type::None());
               NodeProperties::SetType(dead_value, Type::None());
               NodeProperties::ReplaceUses(load, dead_value, load);
+              NodeProperties::ReplaceValueInput(dead_value, load, 0);
               continue;
             }
 
diff --git a/src/compiler/verifier.cc b/src/compiler/verifier.cc
index 600a223e13fdd626ae1ddff3c24e9f30e10b1255..6ac491b6945fd7999460b49055267add75e34cb2 100644
--- a/src/compiler/verifier.cc
+++ b/src/compiler/verifier.cc
@@ -303,6 +303,7 @@ void Verifier::Visitor::Check(Node* node, const AllNodes& all) {
       UNREACHABLE();
     case IrOpcode::kDeadValue:
       CheckValueInputIs(node, 0, Type::None());
+      CHECK_NE(NodeProperties::GetValueInput(node, 0), node);
       CheckTypeIs(node, Type::None());
       break;
     case IrOpcode::kUnreachable:
