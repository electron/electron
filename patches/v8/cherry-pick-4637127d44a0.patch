From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philip Pfaffe <pfaffe@chromium.org>
Date: Tue, 3 Nov 2026 14:39:58 +0000
Subject: [M150] [debug][wasm] Defer debugger break in optimized Wasm frames
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Original change's description:
> [debug][wasm] Defer debugger break in optimized Wasm frames
>
> Debug::HandleDebugBreak deoptimizes the top JavaScript frame before it
> enters the debugger. However, Deoptimizer::DeoptimizeFunction skips
> WebAssembly frames. If an interrupt triggers Debug::HandleDebugBreak
> inside a Turboshaft WebAssembly frame, the frame stays optimized on the
> stack. While the debugger pauses the program, JavaScript can modify
> WebAssembly tables or state. These changes break compiler assumptions
> in the active Turboshaft frame.
>
> To prevent this bug, Debug::HandleDebugBreak now checks the top
> debuggable frame. If the frame is a non-Liftoff WebAssembly frame, the
> debugger defers the break. It calls SetBreakOnNextFunctionCall and
> returns immediately. This patch also updates DebugInfoImpl::IsStepping
> and ExecuteWasmDebugBreaks to check scheduled_break_on_function_call.
> A deferred break now pauses at the entry of the next JS or Liftoff
> WebAssembly function.
>
> Fixed: 577352626
> Change-Id: Ib201097ee80464c3ae716a118568fda2457d98c1
> Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8669378
> Reviewed-by: Simon Zünd <szuend@chromium.org>
> Reviewed-by: Clemens Backes <clemensb@chromium.org>
> Commit-Queue: Philip Pfaffe <pfaffe@chromium.org>
> Cr-Commit-Position: refs/heads/main@{#111331}

(cherry picked from commit afd4fd529a4bf40bd832fc525802c40d049cedad)

Bug: 581325767,577352626
Change-Id: Ib201097ee80464c3ae716a118568fda2457d98c1

diff --git a/src/debug/debug.cc b/src/debug/debug.cc
index 8830311268551a4cd133b4689785e39cfa16dd8b..362b768bc53b46ff66dcdc8a82cfe0fbc515bfe1 100644
--- a/src/debug/debug.cc
+++ b/src/debug/debug.cc
@@ -39,6 +39,7 @@
 #include "src/snapshot/embedded/embedded-data.h"
 
 #if V8_ENABLE_WEBASSEMBLY
+#include "src/wasm/wasm-code-manager.h"
 #include "src/wasm/wasm-debug.h"
 #include "src/wasm/wasm-objects-inl.h"
 #endif  // V8_ENABLE_WEBASSEMBLY
@@ -2936,6 +2937,60 @@ void Debug::HandleDebugBreak(IgnoreBreakMode ignore_break_mode,
           return;
         }
       }
+#if V8_ENABLE_WEBASSEMBLY
+    } else if (!it.done() && it.frame()->is_wasm()) {
+#if V8_ENABLE_DRUMBRAKE
+      if (!it.frame()->is_wasm_interpreter_entry())
+#endif  // V8_ENABLE_DRUMBRAKE
+      {
+        WasmFrame* wasm_frame = WasmFrame::cast(it.frame());
+        wasm::WasmCodeRefScope code_ref_scope;
+        // Optimized Wasm frames cannot be deoptimized on-stack at loop stack
+        // checks. Defer the pause to the next function call (or return to a
+        // debuggable caller frame) so that JavaScript executed during the
+        // pause cannot invalidate load-eliminated state in the optimized Wasm
+        // frame.
+        if (!wasm_frame->wasm_code()->is_liftoff()) {
+          if (ignore_events()) return;
+          thread_local_.scheduled_break_on_next_function_call_.Add(
+              break_reasons);
+          SetBreakOnNextFunctionCall();
+          for (it.Advance(); !it.done(); it.Advance()) {
+            if (it.frame()->is_wasm()) {
+#if V8_ENABLE_DRUMBRAKE
+              if (it.frame()->is_wasm_interpreter_entry()) continue;
+#endif  // V8_ENABLE_DRUMBRAKE
+              WasmFrame* caller_wasm = WasmFrame::cast(it.frame());
+              if (!caller_wasm->wasm_code()->is_inspectable()) continue;
+              wasm::DebugInfo* debug_info =
+                  caller_wasm->native_module()->GetDebugInfo();
+              if (debug_info->IsFrameBlackboxed(caller_wasm)) continue;
+              debug_info->PrepareStepOutTo(caller_wasm);
+              break;
+            }
+            JavaScriptFrame* js_frame = JavaScriptFrame::cast(it.frame());
+            if (js_frame->is_optimized()) {
+              Deoptimizer::DeoptimizeFunction(js_frame->function(),
+                                              LazyDeoptimizeReason::kDebugger,
+                                              js_frame->LookupCode());
+            }
+            HandleScope inner_scope(isolate_);
+            std::vector<Handle<SharedFunctionInfo>> infos;
+            js_frame->GetFunctions(&infos);
+            bool flooded = false;
+            for (; !infos.empty(); infos.pop_back()) {
+              Handle<SharedFunctionInfo> info = infos.back();
+              if (IsBlackboxed(info)) continue;
+              FloodWithOneShot(info);
+              flooded = true;
+              break;
+            }
+            if (flooded) break;
+          }
+          return;
+        }
+      }
+#endif  // V8_ENABLE_WEBASSEMBLY
     }
   }
 
diff --git a/src/debug/debug.h b/src/debug/debug.h
