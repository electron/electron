diff --git a/test/mjsunit/regress/regress-574222006.js b/test/mjsunit/regress/regress-574222006.js
new file mode 100644
index 0000000000000000000000000000000000000000..6a01234502813ef6560b89ac34574dc5df6fbc16
--- /dev/null
+++ b/test/mjsunit/regress/regress-574222006.js
@@ -0,0 +1,28 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+const realm = Realm.create();
+Realm.eval(realm, `
+  var x = 1;
+  function store(o) { o.x = 2; }
+  const objs = [{a: 1}, {b: 1}, {c: 1}, {d: 1}, {e: 1}];
+  for (let i = 0; i < 10; i++) {
+    for (const o of objs) store(o);
+  }
+  store(globalThis);
+`);
+
+const target = Realm.global(realm);
+
+function write(o) {
+  o.x = 42;
+}
+const objs = [{a: 1}, {b: 1}, {c: 1}, {d: 1}, {e: 1}];
+for (let i = 0; i < 10; i++) {
+  for (const o of objs) write(o);
+}
+
+Realm.eval(realm, 'store(globalThis);');
+assertThrows(() => write(target), TypeError);
+assertEquals(2, Realm.eval(realm, 'x'));
