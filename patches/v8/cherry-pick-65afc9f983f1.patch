From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Clemens Backes <clemensb@chromium.org>
Date: Mon, 26 Oct 2026 11:39:34 +0000
Subject: [wasm] Fix Proxy-on-Prototype trap lookup on handler prototype

https://crrev.com/c/6597278 added support for inlining Wasm
Proxy-on-Prototype traps by looking up the "get"/"set" trap via
GetPropertyAccessInfo on the handler's map, which also walks the
handler's prototype chain. However, it always loaded the constant
property from the handler itself rather than trap_info.holder(), and
did not record the property and prototype chain stability dependencies.

Read the constant property from the actual holder, require the handler
map to be stable, and record the property and prototype chain
dependencies.

R=jkummerow@chromium.org

TAG=agy
CONV=c2b0f7fe-cb11-43dd-a5c7-90ca3b80eb70

Fixed: 577305505
Change-Id: Ide46cfc98b813d2d24587b1d05475e76da69c549
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8657185
Reviewed-by: Jakob Kummerow <jkummerow@chromium.org>
Commit-Queue: Clemens Backes <clemensb@chromium.org>
Cr-Commit-Position: refs/heads/main@{#111162}

diff --git a/src/compiler/access-info.cc b/src/compiler/access-info.cc
index 94a6fd5caab2c812a26ea36c379c3690b468bdde..4c785ebdb791aa7e0e4a01f8a2f1eb61ce84673f 100644
--- a/src/compiler/access-info.cc
+++ b/src/compiler/access-info.cc
@@ -556,9 +556,11 @@ std::optional<ElementAccessInfo> AccessInfoFactory::ComputeElementAccessInfo(
         if (!maybe_handler->IsJSObject()) return {};
         JSObjectRef handler = maybe_handler.value().AsJSObject();
         MapRef handler_map = handler.map(broker());
-        // We could implement support for dictionary-mode handlers, but it's
-        // probably not worth it.
-        if (handler_map.is_dictionary_map()) return {};
+        // We could implement support for dictionary-mode or unstable handlers,
+        // but it's probably not worth it.
+        if (handler_map.is_dictionary_map() || !handler_map.is_stable()) {
+          return {};
+        }
         NameRef trap_name = access_mode == AccessMode::kLoad
                                 ? broker()->get_string()
                                 : broker()->set_string();
@@ -567,7 +569,10 @@ std::optional<ElementAccessInfo> AccessInfoFactory::ComputeElementAccessInfo(
         if (!trap_info.IsFastDataConstant()) return {};
         Representation repr = trap_info.field_representation();
         if (!repr.IsHeapObject() && !repr.IsTagged()) return {};
-        OptionalObjectRef trap = handler.GetOwnFastConstantDataProperty(
+        OptionalJSObjectRef trap_holder = trap_info.holder();
+        JSObjectRef trap_holder_ref =
+            trap_holder.has_value() ? trap_holder.value() : handler;
+        OptionalObjectRef trap = trap_holder_ref.GetOwnFastConstantDataProperty(
             broker(), repr, trap_info.field_index(), dependencies());
         if (!trap.has_value()) return {};
         ObjectRef trap_value = trap.value();
@@ -607,6 +612,14 @@ std::optional<ElementAccessInfo> AccessInfoFactory::ComputeElementAccessInfo(
         }
 
         // Finally: all good!
+        trap_info.RecordDependencies(dependencies());
+        if (trap_holder.has_value()) {
+          dependencies()->DependOnStablePrototypeChains(
+              trap_info.lookup_start_object_maps(), kStartAtReceiver,
+              trap_holder.value());
+        } else {
+          dependencies()->DependOnStableMap(handler_map);
+        }
         bool string_keys = key_type == wasm::kWasmExternRef;
         return ElementAccessInfo(map, trap_value, target, string_keys, zone());
       }
diff --git a/test/mjsunit/regress/wasm/regress-577305505.js b/test/mjsunit/regress/wasm/regress-577305505.js
new file mode 100644
index 0000000000000000000000000000000000000000..251f1a440a900df4b10dfeef5860c95c1301e612
--- /dev/null
+++ b/test/mjsunit/regress/wasm/regress-577305505.js
@@ -0,0 +1,120 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --wasm-js-interop
+
+d8.file.execute('test/mjsunit/wasm/wasm-module-builder.js');
+
+const builder = new WasmModuleBuilder();
+builder.startRecGroup();
+const $obj0 = builder.addStruct({fields: [], descriptor: 1});
+const $desc0 = builder.addStruct(
+    {fields: [makeField(kWasmExternRef, false)], describes: $obj0});
+builder.endRecGroup();
+
+const $p0 = builder.addImportedGlobal('p', 'p0', kWasmExternRef);
+const $p1 = builder.addImportedGlobal('p', 'p1', kWasmExternRef);
+const $g_desc0 = builder.addGlobal(
+    wasmRefType($desc0).exact(), false, false,
+    [kExprGlobalGet, $p0, kGCPrefix, kExprStructNew, $desc0]);
+const $g_desc1 = builder.addGlobal(
+    wasmRefType($desc0).exact(), false, false,
+    [kExprGlobalGet, $p1, kGCPrefix, kExprStructNew, $desc0]);
+
+builder.addFunction('make0', makeSig([], [kWasmAnyRef])).exportFunc().addBody([
+  kExprGlobalGet, $g_desc0.index,
+  kGCPrefix, kExprStructNewDesc, $obj0,
+]);
+builder.addFunction('make1', makeSig([], [kWasmAnyRef])).exportFunc().addBody([
+  kExprGlobalGet, $g_desc1.index,
+  kGCPrefix, kExprStructNewDesc, $obj0,
+]);
+
+const kTrapSig = makeSig([kWasmExternRef, kWasmI32, kWasmExternRef], [kWasmI32]);
+builder.addFunction('geti', kTrapSig).exportFunc().addBody([
+  kExprI32Const, 11,
+]);
+builder.addFunction('geti2', kTrapSig).exportFunc().addBody([
+  kExprI32Const, 22,
+]);
+
+const proto0 = {};
+const proto1 = {};
+const instance = builder.instantiate({p: {p0: proto0, p1: proto1}});
+const wasm = instance.exports;
+
+// Case 1: Proxy handler inherits the "get" trap from its prototype at an
+// in-object offset beyond the handler's own instance size.
+function HandlerProto() {
+  this.a = 1;
+  this.get = wasm.geti;
+}
+const handler_proto = new HandlerProto();
+function EmptyHandler() {}
+EmptyHandler.prototype = handler_proto;
+
+// Finish slack tracking on EmptyHandler and make handler_proto fast.
+function warmupProto(h) {
+  return h.get;
+}
+for (let i = 0; i < 20; i++) {
+  warmupProto(new EmptyHandler());
+}
+
+function allocHandlerAndAdjacentHeapNumber(v, zero) {
+  const h = new EmptyHandler();
+  const hn = v + zero;
+  return [h, hn];
+}
+const [handler] = allocHandlerAndAdjacentHeapNumber(1.2, 0.0);
+
+Object.setPrototypeOf(
+    proto0, new Proxy(Object.freeze(Object.create(null)), handler));
+Object.freeze(proto0);
+const w0 = wasm.make0();
+
+function readElem0(o) {
+  return o[0];
+}
+%PrepareFunctionForOptimization(readElem0);
+for (let i = 0; i < 5; i++) {
+  assertEquals(11, readElem0(w0));
+}
+%OptimizeFunctionOnNextCall(readElem0);
+assertEquals(11, readElem0(w0));
+
+// Mutating the prototype trap or shadowing it on the handler must deoptimize.
+handler_proto.get = wasm.geti2;
+assertEquals(22, readElem0(w0));
+
+%PrepareFunctionForOptimization(readElem0);
+for (let i = 0; i < 5; i++) {
+  assertEquals(22, readElem0(w0));
+}
+%OptimizeFunctionOnNextCall(readElem0);
+assertEquals(22, readElem0(w0));
+
+handler.get = () => 33;
+assertEquals(33, readElem0(w0));
+
+// Case 2: Proxy handler has an own constant "get" trap that is later mutated
+// in-place.
+const own_handler = {get: wasm.geti};
+Object.setPrototypeOf(
+    proto1, new Proxy(Object.freeze(Object.create(null)), own_handler));
+Object.freeze(proto1);
+const w1 = wasm.make1();
+
+function readElem1(o) {
+  return o[0];
+}
+%PrepareFunctionForOptimization(readElem1);
+for (let i = 0; i < 5; i++) {
+  assertEquals(11, readElem1(w1));
+}
+%OptimizeFunctionOnNextCall(readElem1);
+assertEquals(11, readElem1(w1));
+
+own_handler.get = wasm.geti2;
+assertEquals(22, readElem1(w1));
