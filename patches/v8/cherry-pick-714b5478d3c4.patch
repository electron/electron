Subject: Check length in FeedbackVector::SizeFor

Add FeedbackVector::kMaxLength and CHECK that the vector length
is non-negative and does not exceed kMaxLength in SizeFor().
Also add a length check in FeedbackVectorVerify().

TAG=agy
CONV=5e1a1d9b-ed48-4b56-91fb-9d3ead86c7d2

Fixed: 556715288
Change-Id: Ib88573d9bef7c364663538aa3801a5ded7eef182
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8366705
Reviewed-by: Patrick Thier <pthier@chromium.org>
Commit-Queue: Patrick Thier <pthier@chromium.org>
Auto-Submit: Leszek Swirski <leszeks@chromium.org>
Cr-Commit-Position: refs/heads/main@{#109703}

Electron adaptation notes (manual port to 42-x-y, V8 14.8):
- On this branch FeedbackVector is still Torque-generated
  (TorqueGeneratedFeedbackVector), so SizeFor()/kHeaderSize/
  kRawFeedbackSlotsOffset live in the generated base class rather than
  in the hand-written V8_OBJECT layout the upstream diff edits.
- kMaxLength is added to FeedbackVector with the upstream formula, and a
  FeedbackVector::SizeFor(int) is added that performs the upstream
  CHECK_GE/CHECK_LE and then delegates to the generated SizeFor(). All
  allocation-size callers (Factory::NewFeedbackVector,
  HeapObject::SizeFromMap) call FeedbackVector::SizeFor and pick it up.
- The objects-debug.cc hunk is dropped: this branch has no hand-written
  FeedbackVectorVerify() (the verifier is Torque-generated).
- The feedback-vector-unittest.cc hunk is taken verbatim.

diff --git a/src/objects/feedback-vector.h b/src/objects/feedback-vector.h
index 82868ec8229c03b8794f70aa786eec748f454df5..cd1576404e4cf3b56cc2c411cec882c3d3b1411a 100644
--- a/src/objects/feedback-vector.h
+++ b/src/objects/feedback-vector.h
@@ -490,6 +490,16 @@ class FeedbackVector
     return kRawFeedbackSlotsOffset + index * kTaggedSize;
   }
 
+  static constexpr int kMaxLength = (kMaxInt - kHeaderSize) / kTaggedSize;
+
+  // Shadows the Torque-generated SizeFor() so that the requested length is
+  // range-checked before the allocation size is computed.
+  static constexpr int32_t SizeFor(int length) {
+    CHECK_GE(length, 0);
+    CHECK_LE(length, kMaxLength);
+    return TorqueGeneratedFeedbackVector::SizeFor(length);
+  }
+
   TQ_OBJECT_CONSTRUCTORS(FeedbackVector)
 
  private:
diff --git a/test/unittests/objects/feedback-vector-unittest.cc b/test/unittests/objects/feedback-vector-unittest.cc
index 32c95a0d01ef9e0cc5a3ed94dd1f35fc5f176f7e..c590b621ce03d87f8e6452af56d6fc46c31d82b7 100644
--- a/test/unittests/objects/feedback-vector-unittest.cc
+++ b/test/unittests/objects/feedback-vector-unittest.cc
@@ -769,5 +769,26 @@ TEST_F(FeedbackVectorTest, DefineNamedOwnIC) {
   CHECK_EQ(InlineCacheState::MONOMORPHIC, nexus.ic_state());
 }
 
+TEST_F(FeedbackVectorTest, MaxLengthAndSizeFor) {
+  static_assert(FeedbackVector::SizeFor(0) == FeedbackVector::kHeaderSize);
+  static_assert(FeedbackVector::SizeFor(10) ==
+                FeedbackVector::kHeaderSize + 10 * kTaggedSize);
+  static_assert(FeedbackVector::SizeFor(FeedbackVector::kMaxLength) ==
+                FeedbackVector::kHeaderSize +
+                    FeedbackVector::kMaxLength * kTaggedSize);
+
+  EXPECT_EQ(FeedbackVector::kHeaderSize, FeedbackVector::SizeFor(0));
+  EXPECT_EQ(FeedbackVector::kHeaderSize + 10 * kTaggedSize,
+            FeedbackVector::SizeFor(10));
+  EXPECT_EQ(
+      FeedbackVector::kHeaderSize + FeedbackVector::kMaxLength * kTaggedSize,
+      FeedbackVector::SizeFor(FeedbackVector::kMaxLength));
+
+  ASSERT_DEATH_IF_SUPPORTED({ FeedbackVector::SizeFor(-1); }, ".*");
+  ASSERT_DEATH_IF_SUPPORTED(
+      { FeedbackVector::SizeFor(FeedbackVector::kMaxLength + 1); }, ".*");
+  ASSERT_DEATH_IF_SUPPORTED({ FeedbackVector::SizeFor(1 << 30); }, ".*");
+}
+
 }  // namespace internal
