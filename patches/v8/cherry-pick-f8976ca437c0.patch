diff --git a/test/mjsunit/regress/regress-572988453.js b/test/mjsunit/regress/regress-572988453.js
new file mode 100644
index 0000000000000000000000000000000000000000..f0dd7bcd2a4315509a2c52bc5fbd9996b8391c43
--- /dev/null
+++ b/test/mjsunit/regress/regress-572988453.js
@@ -0,0 +1,34 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --expose-gc --stress-flush-code
+
+class Outer {
+  #a = 'outer_a';
+  #b = 'outer_b';
+
+  static make() {
+    let fn;
+    class Inner extends (() => {
+      try {
+        throw null;
+      } catch (e) {
+        fn = (function(o) {
+          return o.#a + ':' + o.#b;
+        });
+      }
+      return Object;
+    })() {
+      #a() {}
+      #b() {}
+    }
+    return {fn, Inner};
+  }
+}
+
+const {fn, Inner} = Outer.make();
+assertEquals('outer_a:outer_b', fn(new Outer()));
+for (let i = 0; i < 4; i++) gc();
+assertEquals('outer_a:outer_b', fn(new Outer()));
+assertThrows(() => fn(new Inner()), TypeError);
diff --git a/test/mjsunit/regress/regress-573962535.js b/test/mjsunit/regress/regress-573962535.js
new file mode 100644
index 0000000000000000000000000000000000000000..29db88a4be5700df18ce034a363877db63e06db5
--- /dev/null
+++ b/test/mjsunit/regress/regress-573962535.js
@@ -0,0 +1,44 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --expose-gc --no-compilation-cache --stress-flush-code
+// Flags: --stress-lazy-source-positions
+
+class B {
+  #x = 'B';
+  static makeHeritageEvalFunction() {
+    let g;
+    let h;
+    let nested;
+    let nestedEval;
+    class C extends (
+      g = eval('0, function(o) { return o.#x; }'),
+      h = eval('(() => (o) => o.#x)()'),
+      nested = eval('(() => { let ctx = 1; return (o) => { () => ctx; return o.#x; }; })()'),
+      nestedEval = eval("eval('0, function(o) { return o.#x; }')"),
+      Object
+    ) {
+      #x = 'C';
+    }
+    return {g, h, nested, nestedEval, C};
+  }
+}
+
+const {g, h, nested, nestedEval, C} = B.makeHeritageEvalFunction();
+
+// Drop the eval's top-level SharedFunctionInfo and flush bytecode before
+// lazy compilation.
+for (let i = 0; i < 4; i++) gc();
+
+assertEquals('B', g(new B()));
+assertThrows(() => g(new C()), TypeError);
+
+assertEquals('B', h(new B()));
+assertThrows(() => h(new C()), TypeError);
+
+assertEquals('B', nested(new B()));
+assertThrows(() => nested(new C()), TypeError);
+
+assertEquals('B', nestedEval(new B()));
+assertThrows(() => nestedEval(new C()), TypeError);
