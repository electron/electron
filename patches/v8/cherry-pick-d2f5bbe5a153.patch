diff --git a/src/builtins/promise-race.tq b/src/builtins/promise-race.tq
index 4e3b9529b5e8be8f34570c6c8d3b6825af6488ff..53fd8b3bd8432a99a7cc1ad682ce76c6695d6c97 100644
--- a/src/builtins/promise-race.tq
+++ b/src/builtins/promise-race.tq
@@ -85,7 +85,7 @@ transitioning javascript builtin PromiseRace(
 
         // For catch prediction, mark that rejections here are semantically
         // handled by the combined Promise.
-        if (IsDebugActive() && Is<JSPromise>(promise)) deferred {
+        if (IsDebugActive() && Is<JSPromise>(thenResult)) deferred {
             SetPropertyStrict(
                 context, thenResult, kPromiseHandledBySymbol, promise);
           }
