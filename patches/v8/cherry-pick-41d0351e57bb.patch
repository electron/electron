diff --git a/src/maglev/maglev-ir.h b/src/maglev/maglev-ir.h
index 5062cc86dc7d4e20330405a4813ee1beed2bdf67..c56d26b7b0b300e01a6c1d9817796946f6072908 100644
--- a/src/maglev/maglev-ir.h
