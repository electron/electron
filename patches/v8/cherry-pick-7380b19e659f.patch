diff --git a/src/codegen/arm64/assembler-arm64.cc b/src/codegen/arm64/assembler-arm64.cc
index f3309d324808ef462943781899bb67c15a81cb37..fe9b2311abcdb84a13d632124bcfa0ab805d14ac 100644
