+            kExprLocalGet, 1,
+            kExprLocalSet, 3,
+            kExprBr, 1,
+          kExprEnd,
+          kExprReturn,
+        kExprEnd,
+      kExprEnd,
+      kExprI64Const, 42,
+    ])
+    .exportFunc();
+
+let instance = builder.instantiate({m: helper.exports});
