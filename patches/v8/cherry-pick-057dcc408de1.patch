From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthias Liedtke <mliedtke@chromium.org>
Date: Wed, 16 Sep 2026 11:07:59 +0200
Subject: [compiler] ISel: Fix VisitInt32Sub for 32-bit lhs

Only skip zero-extension of lhs if it is guaranteed to be zero-extended
already.

Fixed: 560536731
Bug: 562243479
Change-Id: I76bdfa74e60dce43817da96832e5cc2e021c06f9
Reviewed-on: https://chromium-review.googlesource.com/c/v8/v8/+/8411046
Reviewed-by: Darius Mercadier <dmercadier@chromium.org>
Commit-Queue: Matthias Liedtke <mliedtke@chromium.org>
Cr-Commit-Position: refs/heads/main@{#109855}

diff --git a/src/compiler/backend/x64/instruction-selector-x64.cc b/src/compiler/backend/x64/instruction-selector-x64.cc
index f6162dc26fcf56559a2ef0b844788ae52e214a14..5716fe1dd80a72fc72e165b406bfa2befeb45d06 100644
--- a/src/compiler/backend/x64/instruction-selector-x64.cc
+++ b/src/compiler/backend/x64/instruction-selector-x64.cc
@@ -2271,10 +2271,10 @@ void InstructionSelector::VisitInt32Sub(OpIndex node) {
   if (g.CanBeImmediate(right)) {
     int32_t imm = g.GetImmediateIntegerValue(right);
     if (imm == 0) {
-      if (this->Get(left).outputs_rep()[0] ==
-          RegisterRepresentation::Word32()) {
+      if (ZeroExtendsWord32ToWord64(left)) {
         // {EmitIdentity} reuses the virtual register of the first input
-        // for the output. This is exactly what we want here.
+        // for the output. This is only safe if it is known to zero-extend
+        // (as the int32 subtraction advertises itself as zero-extending.)
         EmitIdentity(node);
       } else {
         // Emit "movl" for subtraction of 0.
