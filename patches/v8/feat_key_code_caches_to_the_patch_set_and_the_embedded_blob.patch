+// Serialized code refers to builtins by id and embeds root-register-relative
+// offsets, so it is only valid for the exact embedded blob it was compiled
+// against. The version hash alone does not capture that for builds which
+// patch V8 without changing the version number.
+uint32_t EmbeddedBlobHash() {
+  EmbeddedData embedded_data = EmbeddedData::FromBlob();
+  return static_cast<uint32_t>(
+      base::hash_combine(embedded_data.EmbeddedBlobDataHash(),
+                         embedded_data.EmbeddedBlobCodeHash()));
+}
