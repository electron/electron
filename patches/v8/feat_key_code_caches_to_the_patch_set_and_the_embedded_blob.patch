index 7423f45762d20e9a9bb7ae1ce0b7e7d44d4e81ba..75f7ebc7ac620d286f9405e5baacb72642cb169e 100644
--- a/src/utils/version.cc
+++ b/src/utils/version.cc
@@ -6,7 +6,11 @@
 
 #include "include/v8-version-string.h"
 #include "include/v8-version.h"
+#include "src/base/hashing.h"
 #include "src/base/strings.h"
+// Generated at gn gen time from the v8_version_hash_salt GN arg; defines
+// V8_VERSION_HASH_SALT.
+#include "src/utils/version-hash-salt.inc"
 
 // Define SONAME to have the build system put a specific SONAME into the
 // shared library instead the generic SONAME generated from the V8 version
@@ -25,6 +29,25 @@ bool Version::candidate_ = (V8_IS_CANDIDATE_VERSION != 0);
 const char* Version::soname_ = SONAME;
 const char* Version::version_string_ = V8_VERSION_STRING;
 
+namespace {
+
+// FNV-1a over the salt string, evaluated at compile time.
+constexpr uint32_t SaltHash() {
+  uint32_t hash = 2166136261u;
+  for (const char* p = V8_VERSION_HASH_SALT; *p != '\0'; ++p) {
+    hash = (hash ^ static_cast<uint8_t>(*p)) * 16777619u;
+  }
+  return hash;
+}
+
+}  // namespace
+
+// static
+uint32_t Version::Hash() {
+  return static_cast<uint32_t>(
+      base::hash_combine(major_, minor_, build_, patch_, SaltHash()));
+}
+
 // Calculate the V8 version string.
 void Version::GetString(base::Vector<char> str) {
   const char* candidate = IsCandidate() ? " (candidate)" : "";
