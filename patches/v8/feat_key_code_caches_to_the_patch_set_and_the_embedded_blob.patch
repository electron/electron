   import("//build/config/clang/clang.gni")
@@ -1299,6 +1300,12 @@ enabled_external_defines =
 disabled_external_defines =
     disabled_external_v8_defines + disabled_external_cppgc_defines
 
+# The salt is written to a generated header that only src/utils/version.cc
+# includes, so that changing it recompiles a single file rather than all of
+# V8. write_file() only touches the file when its contents change.
+write_file("$target_gen_dir/src/utils/version-hash-salt.inc",
+           [ "#define V8_VERSION_HASH_SALT \"$v8_version_hash_salt\"" ])
+
 # Put defines here that are only used in our internal files and NEVER in
 # external headers that embedders (such as chromium and node) might include.
 config("features") {
diff --git a/gni/version_hash_salt.gni b/gni/version_hash_salt.gni
new file mode 100644
index 0000000000000000000000000000000000000000..80031afb917abf21a175198537a4d2b784a66ee6
--- /dev/null
+++ b/gni/version_hash_salt.gni
@@ -0,0 +1,27 @@
+# Copyright 2026 the V8 project authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # An arbitrary string that is mixed into the hash that keys code caches and
+  # serialized wasm modules (see Version::Hash). Embedders that carry patches
+  # on top of a V8 release should derive this from their patch set so that
+  # serialized code produced by a differently-patched build of the same V8
+  # version is rejected instead of deserialized.
+  v8_version_hash_salt = ""
+
+  # Alternatively, a list of files (for example the embedder's patch series)
+  # whose contents are fingerprinted at gn gen time to produce the salt.
+  # Changing any of them re-runs gn gen.
+  v8_version_hash_salt_files = []
+}
+
+if (v8_version_hash_salt_files != []) {
+  assert(v8_version_hash_salt == "",
+         "Set either v8_version_hash_salt or v8_version_hash_salt_files")
+  v8_version_hash_salt =
+      exec_script("../tools/gen-version-hash-salt.py",
+                  rebase_path(v8_version_hash_salt_files, root_build_dir),
+                  "trim string",
+                  v8_version_hash_salt_files)
+}
