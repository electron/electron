diff --git a/tools/gen-version-hash-salt.py b/tools/gen-version-hash-salt.py
new file mode 100755
index 0000000000000000000000000000000000000000..bd443f28d11f130ef419d7f04b5b86800bd01fc0
--- /dev/null
+++ b/tools/gen-version-hash-salt.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+
+# Copyright 2026 the V8 project authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Prints a short, stable fingerprint of the given files.
+
+Called by GN at gen time (see gni/version_hash_salt.gni) to derive
+v8_version_hash_salt from v8_version_hash_salt_files.
+
+Usage:
+  gen-version-hash-salt.py <file1> [file2] ...
+"""
+
+import hashlib
+import os
+import sys
+
+
+def main(paths):
+  digest = hashlib.sha256()
+  for path in paths:
+    digest.update(os.path.basename(path).encode('utf-8') + b'\n')
+    with open(path, 'rb') as f:
+      # Normalise line endings so that a CRLF checkout yields the same salt.
+      digest.update(f.read().replace(b'\r\n', b'\n'))
+  print(digest.hexdigest()[:16])
+  return 0
+
+
+if __name__ == '__main__':
+  sys.exit(main(sys.argv[1:]))
