diff --git a/test/mjsunit/maglev/context-inverted-generator3.js b/test/mjsunit/maglev/context-inverted-generator3.js
new file mode 100644
index 0000000000000000000000000000000000000000..3a91ef8ec3c546116597db2391eb61b9246ca815
--- /dev/null
+++ b/test/mjsunit/maglev/context-inverted-generator3.js
@@ -0,0 +1,30 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax
+
+function* f() {
+  yield function g() {
+    try { test } catch (e) { gen.next(); return test }
+  }
+  const test = 10;
+}
+
+var gen = f();
+var g = gen.next().value;
+%PrepareFunctionForOptimization(g);
+assertEquals(10, g());
+
+gen = f();
+g = gen.next().value;
+assertEquals(10, g());
+
+gen = f();
+g = gen.next().value;
+assertEquals(10, g());
+
+gen = f();
+g = gen.next().value;
+%OptimizeMaglevOnNextCall(g);
+assertEquals(10, g());
