Electron adaptation notes (42-x-y):
turbolev-graph-builder.cc: AddVirtualObjectInput() on this branch does
not handle vobj::FieldType::kInt32 (it is UNREACHABLE here), so only the
new `vobj` argument was threaded through. The branch had a
TODO/DCHECK(!is_undefined_nan()) in place of the undefined-NaN branch;
it is replaced by the upstream `is_fixed_double_array &&
is_undefined_nan()` branch, mirroring the maglev-code-generator.cc hunk
which applied cleanly.

diff --git a/src/compiler/heap-refs.cc b/src/compiler/heap-refs.cc
index 7978cad562b7db2ed71927b71e8930a63b57c021..af9fbc1c2ecb7635f5c72220994f983c15576b36 100644
--- a/src/compiler/heap-refs.cc
+++ b/src/compiler/heap-refs.cc
@@ -2279,6 +2279,10 @@ std::optional<Float64> JSObjectRef::GetOwnFastConstantDoubleProperty(
   Float64 unboxed_value = Float64::FromBits(
       RacyReadHeapNumberBits(Cast<HeapNumber>(constant.value())));
 
+  // Const double fields should not contain values with the hole NaN pattern
+  // unless in-sandbox memory was corrupted.
+  DCHECK_IMPLIES(!v8_flags.expose_memory_corruption_api,
+                 !unboxed_value.is_hole_nan());
   dependencies->DependOnOwnConstantDoubleProperty(*this, map(broker), index,
                                                   unboxed_value);
   return unboxed_value;
