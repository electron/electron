@@ -0,0 +1,440 @@
+#include "tracing/agent_perfetto.h"
+
+#include <cstdio>
+#include <string>
+#include "debug_utils-inl.h"
+#include "env-inl.h"
+#include "node_options.h"
+#include "trace_event.h"
+
