+std::vector<std::array<uint8_t, SHA256_DIGEST_LENGTH>>&
+BlockedSPKIsForTesting() {
+  static std::vector<std::array<uint8_t, SHA256_DIGEST_LENGTH>> list;
+  return list;
+}
+
+bool IsBlockedSPKI(const X509* cert) {
+  if (cert == nullptr) return false;
+  uint8_t* spki = nullptr;
+  int spki_len = i2d_X509_PUBKEY(X509_get_X509_PUBKEY(cert), &spki);
+  if (spki_len <= 0) return false;
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256(spki, spki_len, digest);
+  OPENSSL_free(spki);
+  for (const auto& blocked : kBlockedSPKIs) {
+    if (memcmp(digest, blocked, sizeof(digest)) == 0) return true;
+  }
+  for (const auto& blocked : BlockedSPKIsForTesting()) {
+    if (memcmp(digest, blocked.data(), sizeof(digest)) == 0) return true;
+  }
+  return false;
+}
+
+bool ContainsBlockedSPKI(const STACK_OF(X509)* certs) {
+  if (certs == nullptr) return false;
+  for (size_t i = 0; i < sk_X509_num(certs); i++) {
+    if (IsBlockedSPKI(sk_X509_value(certs, i))) return true;
+  }
+  return false;
+}
+
+// Wraps X509_verify_cert so that a chain through a blocked key is reported
+// as revoked even when the trust store would otherwise accept it. When no
+// verified chain is available every certificate the peer sent is checked.
+int CertVerifyCallback(X509_STORE_CTX* ctx, void* arg) {
+  int ok = X509_verify_cert(ctx);
+  bool blocked = ok == 1
+      ? ContainsBlockedSPKI(X509_STORE_CTX_get0_chain(ctx))
+      : IsBlockedSPKI(X509_STORE_CTX_get0_cert(ctx)) ||
+            ContainsBlockedSPKI(X509_STORE_CTX_get0_untrusted(ctx));
+  if (blocked) {
+    X509_STORE_CTX_set_error(ctx, X509_V_ERR_CERT_REVOKED);
+    return 0;
+  }
+  return ok;
+}
+
+}  // namespace
+
+void AddBlockedSPKIForTesting(const uint8_t* sha256_hash) {
+  std::array<uint8_t, SHA256_DIGEST_LENGTH> entry;
+  memcpy(entry.data(), sha256_hash, entry.size());
+  BlockedSPKIsForTesting().push_back(entry);
+}
+
+void ClearBlockedSPKIsForTesting() {
+  BlockedSPKIsForTesting().clear();
+}
