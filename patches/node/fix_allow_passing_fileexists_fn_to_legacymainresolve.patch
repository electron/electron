From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shelley Vohr <shelley.vohr@gmail.com>
Date: Sat, 17 Feb 2024 22:17:13 -0800
Subject: fix: allow passing fileExists fn to legacyMainResolve

This switch to native legacyMainResolve doesn't take asar into account, and can
cause errors when a project using ESM and asar tries to load a dependency which
uses commonJS.

We can fix this by allowing the C++ implementation of legacyMainResolve to use
a fileExists function that does take Asar into account.

diff --git a/lib/internal/modules/helpers.js b/lib/internal/modules/helpers.js
index 98d9e04d0c9a2b4f0208be742b5d31038247bfab..26cb56ad45295fcbd71d5d884fd034233c97bce9 100644
--- a/lib/internal/modules/helpers.js
+++ b/lib/internal/modules/helpers.js
@@ -29,7 +29,7 @@ const { validateString } = require('internal/validators');
 const fs = require('fs'); // Import all of `fs` so that it can be monkey-patched.
 const internalFS = require('internal/fs/utils');
 const path = require('path');
-const { pathToFileURL, fileURLToPath, URL } = require('internal/url');
+const { pathToFileURL, fileURLToPath, URL, toPathIfFileURL } = require('internal/url');
 const assert = require('internal/assert');
 
 const { getOptionValue } = require('internal/options');
@@ -69,6 +69,11 @@ let debug = require('internal/util/debuglog').debuglog('module', (fn) => {
  */
 const realpathCache = new SafeMap();
 
+function fileExists(url) {
+  const namespaced = path.toNamespacedPath(toPathIfFileURL(url));
+  return internalFsBinding.internalModuleStat(namespaced) === 0;
+}
+
 // Toggleable loader hooks for VFS support. Overrides that return
 // `undefined` fall through to the pinned native implementation.
 const nativeLoaderMethods = {
@@ -78,7 +83,7 @@ const nativeLoaderMethods = {
     [internalFS.realpathCacheKey]: realpathCache,
   }),
   legacyMainResolve: (pkgPath, main, base) =>
-    internalFsBinding.legacyMainResolve(pkgPath, main, base),
+    internalFsBinding.legacyMainResolve(pkgPath, main, base, fileExists),
   getFormatOfExtensionlessFile: (filePath) =>
     internalFsBinding.getFormatOfExtensionlessFile(filePath),
   readPackageJSON: (jsonPath, isESM, base, specifier) =>
