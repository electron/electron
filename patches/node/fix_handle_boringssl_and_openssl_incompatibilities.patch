diff --git a/src/crypto/crypto_hash.cc b/src/crypto/crypto_hash.cc
index 2cf971347b9ea98bf76a8d277a46d7a6842efda6..9391b884e18557815365e0b3c2442e364543ddd0 100644
--- a/src/crypto/crypto_hash.cc
