diff --git a/src/crypto/crypto_hash.cc b/src/crypto/crypto_hash.cc
index 085cebdef06ba9cf1d00b0437f4d07460f838137..c7b21e60de2470d09fdb918920c450ab491a783a 100644
--- a/src/crypto/crypto_hash.cc
