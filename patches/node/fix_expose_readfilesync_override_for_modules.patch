+    } else if (result->IsFalse()) {
+      // Not found
+      read_error = UV_ENOENT;
+    } else {
+      BufferValue data(isolate, result);
+      package_config.raw_json = data.ToString();
+      read_error = 0;
+    }
+  }
   if (read_error < 0) {
