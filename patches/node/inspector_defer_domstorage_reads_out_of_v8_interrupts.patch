diff --git a/test/parallel/test-inspector-dom-storage-interrupt.js b/test/parallel/test-inspector-dom-storage-interrupt.js
new file mode 100644
index 0000000000000000000000000000000000000000..e7e096d607163d2ee9b7030feb450510b138446a
--- /dev/null
+++ b/test/parallel/test-inspector-dom-storage-interrupt.js
@@ -0,0 +1,60 @@
+// DOMStorage.getDOMStorageItems may have to run the localStorage getter to
+// read a store that no notification has registered yet. A message from a
+// remote frontend is dispatched from a V8 interrupt when it arrives while
+// JavaScript is running, and calling into JavaScript is not allowed there, so
+// the command has to be answered once the interrupted JavaScript has finished.
+'use strict';
+
+const common = require('../common');
+common.skipIfSQLiteMissing();
+common.skipIfInspectorDisabled();
+const { NodeInstance } = require('../common/inspector-helper.js');
+const tmpdir = require('../common/tmpdir');
+const assert = require('node:assert');
+const { once } = require('node:events');
+const { join } = require('node:path');
+const { spawnSyncAndExitWithoutError } = require('../common/child_process');
+tmpdir.refresh();
+
+const localStorageFile = join(tmpdir.path, 'interrupt.db');
+spawnSyncAndExitWithoutError(process.execPath, [
+  `--localstorage-file=${localStorageFile}`,
+  '-e', 'localStorage.setItem("greeting", "hello")',
+]);
+
+(async () => {
+  // Keep the main thread running JavaScript nearly all the time, so that the
+  // commands below are dispatched from a V8 interrupt.
+  const instance = new NodeInstance([
+    '--inspect=0',
+    '--experimental-storage-inspection',
+    `--localstorage-file=${localStorageFile}`,
+  ], `console.log('ready');
+      setInterval(() => {
+        const end = Date.now() + 200;
+        while (Date.now() < end);
+      }, 1);`);
+  // The inspector accepts connections before pre-execution defines
+  // globalThis.localStorage.
+  const ready = once(instance, 'stdout');
+
+  const session = await instance.connectInspectorSession();
+  await ready;
+  await session.send({ method: 'DOMStorage.enable' });
+  const { storageKey } = await session.send({
+    method: 'Storage.getStorageKey',
+  });
+
+  try {
+    const { entries } = await session.send({
+      method: 'DOMStorage.getDOMStorageItems',
+      params: {
+        storageId: { isLocalStorage: true, securityOrigin: '', storageKey },
+      },
+    });
+    assert.deepStrictEqual(entries, [['greeting', 'hello']]);
+  } finally {
+    await session.disconnect();
+    await instance.kill();
+  }
+})().then(common.mustCall());
