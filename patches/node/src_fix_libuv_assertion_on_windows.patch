From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: liuxingbaoyu <30521560+liuxingbaoyu@users.noreply.github.com>
Date: Fri, 24 Jul 2026 14:09:43 +0800
Subject: src: fix libuv assertion on windows

Ignore `PostDelayedTask` after `Stop`
to avoid assertions.

Fixes: https://github.com/nodejs/node/issues/56645
Signed-off-by: liuxingbaoyu <30521560+liuxingbaoyu@users.noreply.github.com>
PR-URL: https://github.com/nodejs/node/pull/61999
Reviewed-By: Santiago Gimeno <santiago.gimeno@gmail.com>
Reviewed-By: Aviv Keller <me@aviv.sh>

In an embedder that destroys the NodePlatform without calling
V8::Dispose() first, V8's MemoryPool release task can still be running
on a platform worker thread while WorkerThreadsTaskRunner::Shutdown()
stops the DelayedTaskScheduler. When that task re-posts itself,
uv_async_send() targets the scheduler's already-closed loop; on Windows
that fails PostQueuedCompletionStatus() and ends in uv_fatal_error().

This patch can be removed when Electron updates to a version of Node.js
that contains the above commit.

diff --git a/src/node_platform.cc b/src/node_platform.cc
index 4a345d6cc321d4f5969a76a1a800f3e517528fcb..47cafc6634c14ea3d656e8819ca8351356d09254 100644
--- a/src/node_platform.cc
+++ b/src/node_platform.cc
@@ -117,6 +117,8 @@ class WorkerThreadsTaskRunner::DelayedTaskScheduler {
                        double delay_in_seconds) {
     auto locked = tasks_.Lock();
 
+    if (has_shut_down_) return;
+
     auto entry = std::make_unique<TaskQueueEntry>(std::move(task), priority);
     auto delayed = std::make_unique<ScheduleTask>(
         this, std::move(entry), delay_in_seconds);
@@ -132,6 +134,7 @@ class WorkerThreadsTaskRunner::DelayedTaskScheduler {
 
   void Stop() {
     auto locked = tasks_.Lock();
+    has_shut_down_ = true;
     locked.Push(std::make_unique<StopTask>(this));
     uv_async_send(&flush_tasks_);
   }
@@ -255,6 +258,7 @@ class WorkerThreadsTaskRunner::DelayedTaskScheduler {
   // Set on the scheduler thread by StopTask; read there by ScheduleTask.
   bool stopped_ = false;
   std::unordered_set<uv_timer_t*> timers_;
+  bool has_shut_down_ = false;
 };
 
 WorkerThreadsTaskRunner::WorkerThreadsTaskRunner(
diff --git a/test/parallel/test-process-exit-after-fetch-throw.js b/test/parallel/test-process-exit-after-fetch-throw.js
new file mode 100644
index 0000000000000000000000000000000000000000..b6868c2c9e7343ace05f927f2d81e1135faabb46
--- /dev/null
+++ b/test/parallel/test-process-exit-after-fetch-throw.js
@@ -0,0 +1,32 @@
+'use strict';
+// Ref: https://github.com/nodejs/node/issues/56645
+const common = require('../common');
+const assert = require('assert');
+const cp = require('child_process');
+const http = require('http');
+
+if (process.argv[2] === 'child') {
+  http
+    .createServer((_, res) => {
+      res.writeHead(302, { Location: '/' });
+      res.end();
+    })
+    .listen(0, '127.0.0.1', async function() {
+      try {
+        await fetch(`http://127.0.0.1:${this.address().port}/`);
+      } catch {
+        // ignore
+      }
+      process.exit(0);
+    });
+} else {
+  const child = cp.spawn(process.execPath, [__filename, 'child']);
+
+  child.on(
+    'close',
+    common.mustCall((exitCode, signal) => {
+      assert.strictEqual(exitCode, 0);
+      assert.strictEqual(signal, null);
+    }),
+  );
+}
