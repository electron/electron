From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Keeley Hammond <vertedinde@electronjs.org>
Date: Fri, 19 Jun 2026 21:06:40 +0000
Subject: src: stop using deprecated Get/SetPrototypeV2 and HolderV2

V8 advanced the deprecation of v8::Object::GetPrototypeV2(),
v8::Object::SetPrototypeV2() and v8::PropertyCallbackInfo::HolderV2()
in favor of the plain GetPrototype()/SetPrototype()/Holder() names,
which now have the V2 semantics. Rename the call sites accordingly.

https://chromium-review.googlesource.com/c/v8/v8/+/7955758

diff --git a/src/api/environment.cc b/src/api/environment.cc
index 6313d5ce1839fafb175c0e0c74eb39445baed467..4126d4b9f6caf6cbddba403189858c7f0ec60abb 100644
--- a/src/api/environment.cc
+++ b/src/api/environment.cc
@@ -989,7 +989,7 @@ MaybeLocal<Object> InitializePrivateSymbols(Local<Context> context,
 
   Local<Object> private_symbols_object;
   if (!private_symbols->NewInstance(context).ToLocal(&private_symbols_object) ||
-      private_symbols_object->SetPrototypeV2(context, Null(isolate))
+      private_symbols_object->SetPrototype(context, Null(isolate))
           .IsNothing()) {
     return MaybeLocal<Object>();
   }
@@ -1015,7 +1015,7 @@ MaybeLocal<Object> InitializePerIsolateSymbols(Local<Context> context,
   Local<Object> per_isolate_symbols_object;
   if (!per_isolate_symbols->NewInstance(context).ToLocal(
           &per_isolate_symbols_object) ||
-      per_isolate_symbols_object->SetPrototypeV2(context, Null(isolate))
+      per_isolate_symbols_object->SetPrototype(context, Null(isolate))
           .IsNothing()) {
     return MaybeLocal<Object>();
   }
diff --git a/src/internal_only_v8.cc b/src/internal_only_v8.cc
