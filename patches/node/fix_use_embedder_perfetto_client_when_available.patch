+  if (isTraceCategoryEnabled(traceEventCategory)) {
+    const id = ++traceEventId;
+    trace(CHAR_LOWERCASE_B, traceEventCategory, name, id,
+          { startTime: start });
+    trace(CHAR_LOWERCASE_E, traceEventCategory, name, id,
+          { startTime: start, duration });
+  }
   return measure;
 }
 
