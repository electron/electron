@@ -243,6 +313,12 @@ void MainThreadInterface::DispatchMessages() {
   if (dispatching_messages_)
     return;
   dispatching_messages_ = true;
+  // From a V8 interrupt, handle only the requests that cannot run JavaScript,
+  // and keep the rest, along with any later request for the same object, in
+  // their original order until the thread yields.
+  const bool in_v8_interrupt = agent_->env()->is_processing_v8_interrupt();
+  MessageQueue deferred;
+  std::unordered_set<int> deferred_objects;
   bool had_messages = false;
   do {
     if (dispatching_message_queue_.empty()) {
@@ -255,13 +331,49 @@ void MainThreadInterface::DispatchMessages() {
       std::swap(dispatching_message_queue_.front(), task);
       dispatching_message_queue_.pop_front();
 
+      if (in_v8_interrupt) {
+        int object_id = task->object_id();
+        if (!task->CanRunInV8Interrupt() ||
+            deferred_objects.count(object_id) > 0) {
+          CHECK_NE(object_id, 0);
+          deferred_objects.insert(object_id);
+          deferred.push_back(std::move(task));
+          continue;
+        }
+      }
+
       v8::SealHandleScope seal_handle_scope(agent_->env()->isolate());
       task->Call(this);
     }
   } while (had_messages);
+  if (!deferred.empty()) {
+    dispatching_message_queue_.swap(deferred);
+    ScheduleDeferredDispatch();
+  }
   dispatching_messages_ = false;
 }
 
+void MainThreadInterface::ScheduleDeferredDispatch() {
+  if (deferred_dispatch_scheduled_) return;
+  deferred_dispatch_scheduled_ = true;
+  std::weak_ptr<MainThreadInterface> weak_self{shared_from_this()};
+  auto dispatch = [weak_self](Environment*) {
+    if (auto iface = weak_self.lock()) {
+      iface->deferred_dispatch_scheduled_ = false;
+      iface->DispatchMessages();
+    }
+  };
+  Environment* env = agent_->env();
+  if (env->is_libuv_initialized()) {
+    // Keep the event loop alive until the deferred requests are handled.
+    env->SetImmediate(std::move(dispatch));
+  } else {
+    // JavaScript can run before the libuv handles exist, e.g. while a Worker
+    // bootstraps. The thread-safe queue is flushed once they do.
+    env->SetImmediateThreadsafe(std::move(dispatch));
+  }
+}
