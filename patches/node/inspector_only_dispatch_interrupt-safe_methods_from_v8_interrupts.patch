diff --git a/src/inspector/main_thread_interface.h b/src/inspector/main_thread_interface.h
index 3311f9df014a3930bbd2593641c88cb6d2405720..d804646ed74523926b1d34417410cf8cdd293889 100644
--- a/src/inspector/main_thread_interface.h
+++ b/src/inspector/main_thread_interface.h
@@ -22,9 +22,28 @@ namespace node {
 namespace inspector {
 class MainThreadInterface;
 
+// How a request is handled from a V8 API interrupt, where JavaScript must
+// not run.
+enum class V8InterruptDispatch {
+  // It may run JavaScript, so it waits until the thread yields.
+  kDefer,
+  // It does not run JavaScript, but waits behind deferred requests for the
+  // same object, so that they are handled in order.
+  kInOrder,
+  // It does not run JavaScript and is handled even when requests for the
+  // same object are deferred, because its purpose is to interrupt them.
+  kOvertake,
+};
+
 class Request {
  public:
   virtual void Call(MainThreadInterface*) = 0;
+  // The id of the object that this request acts on, or 0 if it does not act
+  // on a managed object.
+  virtual int object_id() const { return 0; }
+  virtual V8InterruptDispatch v8_interrupt_dispatch() const {
+    return V8InterruptDispatch::kInOrder;
+  }
   virtual ~Request() = default;
 };
 
