diff --git a/test/parallel/test-inspector-interrupt-deferred-dispatch.js b/test/parallel/test-inspector-interrupt-deferred-dispatch.js
new file mode 100644
index 0000000000000000000000000000000000000000..db99cc0b9e2dc6d0c22396cc130810642d797a38
--- /dev/null
+++ b/test/parallel/test-inspector-interrupt-deferred-dispatch.js
@@ -0,0 +1,135 @@
+'use strict';
+const common = require('../common');
+common.skipIfSQLiteMissing();
+common.skipIfInspectorDisabled();
+
+const assert = require('assert');
+const { writeFileSync } = require('fs');
+const { join } = require('path');
+const { NodeInstance } = require('../common/inspector-helper.js');
+const tmpdir = require('../common/tmpdir');
+tmpdir.refresh();
+
+// While JavaScript runs, a message from a remote frontend is dispatched from a
+// V8 API interrupt, where JavaScript must not run. Methods that never run
+// JavaScript, such as DOMStorage reads, are still dispatched from there, while
+// methods that may run JavaScript, such as Runtime.evaluate, have to wait until
+// the main thread yields. Later messages of the same session wait with them so
+// that the session sees its messages handled in order, but other sessions are
+// not held up. Debugger.pause, which exists to interrupt the thread, does not
+// wait behind them.
+async function runTest() {
+  const doneFile = join(tmpdir.path, 'done');
+  const pauseStartFile = join(tmpdir.path, 'pause-start');
+  const pauseDoneFile = join(tmpdir.path, 'pause-done');
+  const script = `
+  const { existsSync } = require('fs');
+  function busyUntil(file) {
+    const deadline = Date.now() + ${common.platformTimeout(10000)};
+    while (!existsSync(file) && Date.now() < deadline);
+    return existsSync(file) ? 'done' : 'timeout';
+  }
+  localStorage.setItem('key', 'value');
+  console.log('Ready');
+  globalThis.loopEnd = busyUntil(${JSON.stringify(doneFile)});
+  // Yield to the event loop until the test starts the second loop.
+  const timer = setInterval(() => {
+    if (!existsSync(${JSON.stringify(pauseStartFile)})) return;
+    clearInterval(timer);
+    console.log('Pause');
+    globalThis.pauseLoopEnd = busyUntil(${JSON.stringify(pauseDoneFile)});
+    console.log('Pause loop end', globalThis.pauseLoopEnd);
+  }, 10);
+  `;
+  const child = new NodeInstance([
+    '--inspect-brk=0',
+    '--experimental-storage-inspection',
+    `--localstorage-file=${join(tmpdir.path, 'storage.db')}`,
+  ], script);
+
+  const session = await child.connectInspectorSession();
+  const other = await child.connectInspectorSession();
+  await session.send({ method: 'NodeRuntime.enable' });
+  await session.waitForNotification('NodeRuntime.waitingForDebugger');
+  await session.send([
+    { method: 'Runtime.enable' },
+    { method: 'Debugger.enable' },
+    { method: 'DOMStorage.enable' },
+  ]);
+  await other.send({ method: 'DOMStorage.enable' });
+  const { storageKey } = await session.send({ method: 'Storage.getStorageKey' });
+  await session.send({ method: 'Runtime.runIfWaitingForDebugger' });
+  await session.send({ method: 'NodeRuntime.disable' });
+  await session.waitForNotification('Debugger.paused', 'Break on start');
+  await session.send({ method: 'Debugger.resume' });
+  await session.waitForConsoleOutput('log', ['Ready']);
+
+  const getItems = {
+    method: 'DOMStorage.getDOMStorageItems',
+    params: {
+      storageId: { isLocalStorage: true, securityOrigin: '', storageKey },
+    },
+  };
+  const expected = { entries: [['key', 'value']] };
+
+  // The loop only ends once the file is written, so these are answered from
+  // the interrupt.
+  assert.deepStrictEqual(await session.send(getItems), expected);
+
+  const order = [];
+  const evaluated = session.send({
+    method: 'Runtime.evaluate',
+    params: { expression: 'globalThis.loopEnd' },
+  }).then((result) => {
+    order.push('Runtime.evaluate');
+    return result;
+  });
+  const queuedRead = session.send(getItems).then((result) => {
+    order.push('DOMStorage.getDOMStorageItems');
+    return result;
+  });
+
+  // Another session is not blocked by the deferred Runtime.evaluate.
+  assert.deepStrictEqual(await other.send(getItems), expected);
+  assert.deepStrictEqual(order, []);
+
+  writeFileSync(doneFile, '');
+  const { result } = await evaluated;
+  // Runtime.evaluate ran after the loop, which ended because the file was
+  // written, not because it timed out.
+  assert.deepStrictEqual(result, { type: 'string', value: 'done' });
+  assert.deepStrictEqual(await queuedRead, expected);
+  assert.deepStrictEqual(order,
+                         ['Runtime.evaluate', 'DOMStorage.getDOMStorageItems']);
+
+  // Debugger.pause is dispatched from the interrupt even though the session
+  // has a deferred Runtime.evaluate, and the evaluation runs in the pause.
+  writeFileSync(pauseStartFile, '');
+  await session.waitForConsoleOutput('log', ['Pause']);
+  const pauseOrder = [];
+  const evaluatedInPause = session.send({
+    method: 'Runtime.evaluate',
+    params: { expression: 'globalThis.pauseLoopEnd' },
+  }).then((result) => {
+    pauseOrder.push('Runtime.evaluate');
+    return result;
+  });
+  await session.send({ method: 'Debugger.pause' });
+  pauseOrder.push('Debugger.pause');
+  const { params: { reason } } =
+    await session.waitForNotification('Debugger.paused');
+  assert.strictEqual(reason, 'other');
+  assert.deepStrictEqual((await evaluatedInPause).result,
+                         { type: 'undefined' });
+  assert.deepStrictEqual(pauseOrder, ['Debugger.pause', 'Runtime.evaluate']);
+  await session.send({ method: 'Debugger.resume' });
+  writeFileSync(pauseDoneFile, '');
+  await session.waitForConsoleOutput('log', ['Pause loop end', 'done']);
+
+  await other.disconnect();
+  await session.waitForDisconnect();
+  assert.deepStrictEqual(await child.expectShutdown(),
+                         { exitCode: 0, signal: null });
+}
+
+runTest().then(common.mustCall());
