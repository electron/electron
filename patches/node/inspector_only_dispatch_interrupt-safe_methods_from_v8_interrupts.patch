 using v8_inspector::StringBuffer;
 using v8_inspector::StringView;
 
+// Messages for a main thread session are dispatched from a V8 API interrupt
+// while JavaScript runs, and JavaScript must not run from there. Like Blink's
+// ShouldInterruptForMethod(), only dispatch methods that never run JavaScript
+// (no getters, Proxy traps, Error.prepareStackTrace, toString/valueOf, or
+// microtasks) from the interrupt, and defer the rest until the thread yields.
+// Next to the methods that Blink allows, this has Node.js methods that only
+// read native state or forward a message to a worker thread.
+bool CanDispatchFromV8Interrupt(const StringView& message) {
+  static constexpr std::string_view kMethods[] = {
+      "DOMStorage.disable",
+      "DOMStorage.enable",
+      "DOMStorage.getDOMStorageItems",
+      "Debugger.getPossibleBreakpoints",
+      "Debugger.getScriptSource",
+      "Debugger.getStackTrace",
+      "Debugger.pause",
+      "Debugger.removeBreakpoint",
+      "Debugger.resume",
+      "Debugger.setBreakpoint",
+      "Debugger.setBreakpointByUrl",
+      "Debugger.setBreakpointsActive",
+      "NodeWorker.sendMessageToWorker",
+      "Runtime.terminateExecution",
+      "Storage.getStorageKey",
+  };
+  // Parse the message the same way the session does when it dispatches it.
+  std::string json = protocol::StringUtil::StringViewToUtf8(message);
+  std::vector<uint8_t> cbor;
+  if (!crdtp::json::ConvertJSONToCBOR(crdtp::SpanFrom(json), &cbor).ok()) {
+    return false;
+  }
+  crdtp::Dispatchable dispatchable(
+      crdtp::SpanFrom(cbor), std::string_view(), crdtp::FallthroughCallback());
+  if (!dispatchable.ok()) return false;
+  crdtp::span<uint8_t> method = dispatchable.Method();
+  std::string_view method_name(reinterpret_cast<const char*>(method.data()),
+                               method.size());
+  return std::find(std::begin(kMethods), std::end(kMethods), method_name) !=
+         std::end(kMethods);
+}
