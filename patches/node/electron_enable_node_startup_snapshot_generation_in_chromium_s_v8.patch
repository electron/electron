+      "deps/ada",
+      "deps/simdjson",
+      "deps/uv",
+      "//third_party/zstd:headers",
+      "$node_v8_path",
+      "$node_v8_path:v8_libplatform",
+    ]
+    sources = [ "src/node_snapshot_stub.cc" ]
+  }
+
+  # The embedded Node startup snapshot, providing the real
+  # SnapshotBuilder::GetEmbeddedSnapshotData(). Linked by the shipped Electron
+  # framework and the snapshot code-cache tool. NOT linked by node_mksnapshot
+  # (that would cycle: this -> run_node_mksnapshot -> node_mksnapshot ->
+  # libnode). When node_use_node_snapshot is off it falls back to the stub, so
+  # consumers always get exactly one definition.
+  source_set("node_snapshot") {
+    configs += [
+      ":node_internal_config",
+      "$node_v8_path:v8_tracing_config",
+      # Auto-generated; node headers it pulls in use exit-time destructors.
+      "//build/config/compiler:no_exit_time_destructors",
+    ]
+    if (is_clang || !is_win) {
+      cflags_cc = [ "-Wno-exit-time-destructors" ]
+    }
+    public_configs = [ ":zstd_include_config" ]
+    deps = [
+      "//base:debugging_buildflags",
+      "deps/uv",
+      "deps/ada",
+      "deps/simdjson",
+      "//third_party/zstd:headers",
+      "$node_v8_path",
+      "$node_v8_path:v8_libplatform",
+    ]
+    if (node_use_node_snapshot) {
+      _run_node_mksnapshot = ":run_node_mksnapshot($default_toolchain)"
+      sources = [ get_label_info(_run_node_mksnapshot, "target_gen_dir") +
+                  "/node_snapshot.cc" ]
+      deps += [ _run_node_mksnapshot ]
+      if (is_clang || !is_win) {
+        # The generated node_snapshot.cc is huge auto-generated C++.
+        cflags_cc += [
+          "-Wno-c++11-narrowing",
+          "-Wno-shadow",
+        ]
+      }
+    } else {
+      # No snapshot in this config: provide the same fallback as
+      # ":node_snapshot_stub" so consumers of ":node_snapshot" still get one
+      # definition of GetEmbeddedSnapshotData().
+      sources = [ "src/node_snapshot_stub.cc" ]
     }
   }
 
