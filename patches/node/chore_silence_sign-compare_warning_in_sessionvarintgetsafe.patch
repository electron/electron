From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Kleinschmidt <jkleinsc@electronjs.org>
Date: Mon, 1 Jun 2026 11:39:31 -0400
Subject: chore: silence sqlite sign-compare warnings

Upstream sqlite contains signed/unsigned comparisons that Electron's
-Wsign-compare-as-error build rejects. Cast values only after their
non-negative ranges are established, preserving behavior.

This patch can be removed once sqlite fixes the comparisons upstream.

diff --git a/deps/sqlite/sqlite3.c b/deps/sqlite/sqlite3.c
index ac7549011639e3f1df0b6ef6faf85760a2d2292e..7c13f0032bfcab1310d1baf2da7146d7ba9af30f 100644
--- a/deps/sqlite/sqlite3.c
+++ b/deps/sqlite/sqlite3.c
@@ -228238,7 +228238,7 @@ static int rbuDeltaApply(
           /* ERROR:  insert command gives an output larger than predicted */
           return -1;
         }
-        if( cnt>lenDelta ){
+        if( cnt>(unsigned int)lenDelta ){
           /* ERROR: insert count exceeds size of delta */
           return -1;
         }
@@ -235413,7 +235413,7 @@ static int sessionVarintGetSafe(const u8 *aBuf, int nBuf, int *piVal){
   u8 aCopy[9];
   const u8 *aRead = aBuf;
   memset(aCopy, 0, sizeof(aCopy));
-  if( nBuf<sizeof(aCopy) ){
+  if( (size_t)nBuf<sizeof(aCopy) ){
     memcpy(aCopy, aBuf, nBuf);
     aRead = aCopy;
   }
