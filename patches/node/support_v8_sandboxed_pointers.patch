diff --git a/src/node_serdes_utils.h b/src/node_serdes_utils.h
new file mode 100644
index 0000000000000000000000000000000000000000..44bc180778a23ce611b570c91242a1b10c28a058
--- /dev/null
+++ b/src/node_serdes_utils.h
@@ -0,0 +1,100 @@
+#ifndef SRC_NODE_SERDES_UTILS_H_
+#define SRC_NODE_SERDES_UTILS_H_
+
+#if defined(NODE_WANT_INTERNALS) && NODE_WANT_INTERNALS
+
+#include "v8.h"
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <utility>
+
+namespace node {
+namespace serdes {
+
+class SerializerDelegate : public v8::ValueSerializer::Delegate {
+ public:
+  explicit SerializerDelegate(v8::Isolate* isolate,
+                              size_t minimum_buffer_capacity = 0)
+      : isolate_(isolate),
+        minimum_buffer_capacity_(minimum_buffer_capacity) {}
+
+  void* ReallocateBufferMemory(void* old_buffer,
+                               size_t requested_size,
+                               size_t* actual_size) override {
+    const size_t new_capacity =
+        std::max(minimum_buffer_capacity_, requested_size);
+    const auto initialization_mode =
+        old_buffer == nullptr
+            ? v8::BackingStoreInitializationMode::kZeroInitialized
+            : v8::BackingStoreInitializationMode::kUninitialized;
+    std::unique_ptr<v8::BackingStore> new_backing_store =
+        v8::ArrayBuffer::NewBackingStore(
+            isolate_,
+            new_capacity,
+            initialization_mode,
+            v8::BackingStoreOnFailureMode::kReturnNull);
+    if (new_backing_store == nullptr) return nullptr;
+
+    if (old_buffer != nullptr) {
+      CHECK_NOT_NULL(backing_store_);
+      CHECK_EQ(old_buffer, backing_store_->Data());
+      memcpy(new_backing_store->Data(),
+             old_buffer,
+             std::min(backing_store_->ByteLength(), new_capacity));
+      if (new_capacity > backing_store_->ByteLength()) {
+        memset(static_cast<uint8_t*>(new_backing_store->Data()) +
+                   backing_store_->ByteLength(),
+               0,
+               new_capacity - backing_store_->ByteLength());
+      }
+    }
+
+    backing_store_ = std::move(new_backing_store);
+    *actual_size = new_capacity;
+    return backing_store_->Data();
+  }
+
+  void FreeBufferMemory(void* buffer) override {
+    CHECK_NOT_NULL(backing_store_);
+    CHECK_EQ(buffer, backing_store_->Data());
+    backing_store_.reset();
+  }
+
+  v8::Local<v8::ArrayBuffer> AdoptReleasedBuffer(
+      v8::Isolate* isolate,
+      std::pair<uint8_t*, size_t> buffer) {
+    CHECK_EQ(isolate, isolate_);
+    if (buffer.first == nullptr) {
+      CHECK_EQ(buffer.second, 0);
+      CHECK_NULL(backing_store_);
+      return v8::ArrayBuffer::New(isolate, 0);
+    }
+
+    CHECK_NOT_NULL(backing_store_);
+    CHECK_EQ(buffer.first, backing_store_->Data());
+    auto backing_store = v8::ArrayBuffer::NewBackingStore(
+        buffer.first,
+        buffer.second,
+        [](void* data, size_t, void* deleter_data) {
+          std::unique_ptr<v8::BackingStore> allocation(
+              static_cast<v8::BackingStore*>(deleter_data));
+          CHECK_EQ(data, allocation->Data());
+        },
+        backing_store_.release());
+    return v8::ArrayBuffer::New(isolate, std::move(backing_store));
+  }
+
+ private:
+  v8::Isolate* isolate_;
+  const size_t minimum_buffer_capacity_;
+  std::unique_ptr<v8::BackingStore> backing_store_;
+};
+
+}  // namespace serdes
+}  // namespace node
+
+#endif  // defined(NODE_WANT_INTERNALS) && NODE_WANT_INTERNALS
+
+#endif  // SRC_NODE_SERDES_UTILS_H_
