+++ b/test/client-proxy/test-https-proxy-request-handshake-failure.mjs
@@ -13,6 +13,7 @@ if (!common.hasCrypto)
 // https must be dynamically imported so that builds without crypto support
 // can skip it.
 const { default: https } = await import('node:https');
+const { sslVerificationFailureError } = await import('../common/crypto.js');
 
 const server = https.createServer({
   cert: fixtures.readKey('agent8-cert.pem'),
@@ -36,8 +37,8 @@ const { code, signal, stderr, stdout } = await runProxiedRequest({
   HTTPS_PROXY: `http://localhost:${proxy.address().port}`,
 });
 
-// The proxy client should get a UNABLE_TO_VERIFY_LEAF_SIGNATURE during TLS handshake.
-assert.match(stderr, /UNABLE_TO_VERIFY_LEAF_SIGNATURE/);
+// The proxy client should get a certificate verification error during TLS handshake.
+assert.match(stderr, new RegExp(sslVerificationFailureError));
 assert.strictEqual(stdout, '');
 assert.strictEqual(code, 0);
 assert.strictEqual(signal, null);
diff --git a/test/common/crypto.js b/test/common/crypto.js
index 49678e0de43ac0b2568a75d9ef112472c0c16240..8f05c39345d66919d4c1629295add89c60fa49ab 100644
--- a/test/common/crypto.js
+++ b/test/common/crypto.js
@@ -125,6 +125,11 @@ const hasOpenSSL = (major = 0, minor = 0, patch = 0) => {
 
 const isBoringSSL = process.features.openssl_is_boringssl;
 
+// The error code reported when a certificate's issuer isn't in the trust
+// store. BoringSSL no longer reports UNABLE_TO_VERIFY_LEAF_SIGNATURE.
+const sslVerificationFailureError = isBoringSSL ?
+  'UNABLE_TO_GET_ISSUER_CERT_LOCALLY' : 'UNABLE_TO_VERIFY_LEAF_SIGNATURE';
+
 const hasFIPS = (major = 0, minor = 0, patch = 0) => {
   return crypto.getFips() === 1 && hasOpenSSL(major, minor, patch);
 };
@@ -147,6 +152,7 @@ module.exports = {
   hasOpenSSL,
   hasFIPS,
   isBoringSSL,
+  sslVerificationFailureError,
   get hasOpenSSL3() {
     return hasOpenSSL(3);
   },
