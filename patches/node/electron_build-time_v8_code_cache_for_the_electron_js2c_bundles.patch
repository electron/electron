       const std::vector<std::string>& lazy_builtins,
       std::vector<CodeCacheInfo>* out);
   void RefreshCodeCache(const std::vector<CodeCacheInfo>& in);
+  // Electron: a process-wide code cache every BuiltinLoader constructed
+  // afterwards starts out with (the Environment's, the thread_local one that
+  // compiles the per-context scripts in InitializePrimordials, embedder-owned
+  // ones). Lets an embedder whose environments are bootstrapped from scratch
+  // rather than deserialized from a snapshot supply a build-time cache that
+  // covers the bootstrap itself, which runs inside CreateEnvironment before
+  // the embedder can reach env->builtin_loader(). A snapshot's own cache and
+  // later RefreshCodeCache() calls merge over it. `cache` must outlive every
+  // loader; pass it before the first loader is constructed. Not thread-safe
+  // against concurrent loader construction -- call it during single-threaded
+  // process setup.
+  static void SetProcessDefaultCodeCache(
+      const std::vector<CodeCacheInfo>* cache);
 
   void CopySourceAndCodeCacheReferenceFrom(const BuiltinLoader* other);
 
@@ -240,6 +255,11 @@ class NODE_EXTERN_PRIVATE BuiltinLoader {
   friend class ::PerProcessTest;
 };
 
+// Electron, test-only (DCHECK builds): see node_builtins.cc.
+#if DCHECK_IS_ON()
+std::map<std::string, bool> ElectronJs2cCacheStatus();
+#endif
+
 }  // namespace builtins
 
 }  // namespace node
