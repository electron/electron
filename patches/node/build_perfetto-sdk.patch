+    action='store_true',
+    dest='with_perfetto',
+    default=None,
+    help='enable perfetto support')
+
 parser.add_argument('--shared',
     action='store_true',
     dest='shared',
@@ -1971,6 +1977,7 @@ def configure_v8(o, configs):
