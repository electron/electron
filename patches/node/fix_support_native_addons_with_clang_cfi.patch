 namespace binding {
 
+// Addon entry points live in shared libraries without CFI type metadata.
+template <typename Callback, typename... Args>
+#if defined(__clang__)
+__attribute__((no_sanitize("cfi-icall")))
+#endif
+auto CallAddonEntryPoint(Callback callback, Args... args)
+    -> decltype(callback(args...)) {
+  return callback(args...);
+}
