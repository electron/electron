From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 01:33:51 +0000
Subject: build: disable libc++ modules for ada

ada.h uses std::pair, std::vector and std::same_as before including
the headers that declare them. With clang modules enabled, libc++
modules use local submodule visibility, so these declarations are not
visible at their point of use and compilation of ada.cpp fails with
"declaration of 'pair' must be imported from module ... before it is
required".

Disable libc++ modules for the ada target to work around this. This
can be removed once ada.h includes its headers before using them.

diff --git a/deps/ada/unofficial.gni b/deps/ada/unofficial.gni
index b6c0fd4ceee989dac55c7d54e52fef183ab4621c..45199ac24943c32b0065acfc2b70cc511bba9106 100644
--- a/deps/ada/unofficial.gni
+++ b/deps/ada/unofficial.gni
@@ -22,5 +22,10 @@ template("ada_gn_build") {
     public_configs = [ ":ada_config" ]
     configs += [ "//build/config/compiler:no_exit_time_destructors" ]
     sources = gypi_values.ada_sources
+
+    # ada.h uses std::pair, std::vector and std::same_as before including
+    # their headers, which fails under libc++ modules' local submodule
+    # visibility.
+    use_libcxx_modules = false
   }
 }
