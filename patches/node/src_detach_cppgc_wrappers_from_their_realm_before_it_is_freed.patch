       kEmbedderType, realm->isolate_data()->embedder_id_for_cppgc(), 0);
   obj->SetAlignedPointerInInternalField(kSlot, ptr, 0);
-  realm->TrackCppgcWrapper(ptr);
+  ptr->list_node_ = realm->TrackCppgcWrapper(ptr);
 }
 
 template <typename T>
@@ -46,17 +45,26 @@ T* CppgcMixin::Unwrap(v8::Local<v8::Object> obj) {
 }
 
 v8::Local<v8::Object> CppgcMixin::object() const {
