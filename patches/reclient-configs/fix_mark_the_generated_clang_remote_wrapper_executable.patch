Date: Sun, 6 Sep 2026 18:08:20 +0000
Subject: fix: mark the generated clang_remote_wrapper executable

The wrapper runs on the remote Linux worker, so it needs the exec bit on
hosts where the checkout does not already carry it.

diff --git a/configure_reclient.py b/configure_reclient.py
index 5948be95b6b19e6af4f9a9503c18ce2bebf63f2d..a064b9aa42501889648e374451a95e3b1dcc553d 100755
--- a/configure_reclient.py
+++ b/configure_reclient.py
@@ -21,6 +21,7 @@ import os
 import re
 import runpy
 import shutil
+import stat
 import string
 import subprocess
 import sys
@@ -198,6 +199,8 @@ class ReclientConfigurator:
         FileUtils.write_text_file(
             (f'{Paths.src_dir}/buildtools/reclient_cfgs/chromium-browser-clang/'
              'clang_remote_wrapper'), clang_remote_wrapper)
+        FileUtils.chmod_x((f'{Paths.src_dir}/buildtools/reclient_cfgs/chromium-browser-clang/'
+             'clang_remote_wrapper'))
 
     def generate_reproxy_cfg(self):
         # Load Chromium config template and remove everything starting with $
@@ -507,6 +510,11 @@ class ReclientCfg:
 
 
 class FileUtils:
+    @classmethod
+    def chmod_x(cls, filepath):
+        st = os.stat(filepath)
+        os.chmod(filepath, st.st_mode | stat.S_IEXEC)
+
     GENERATED_FILE_HEADER = inspect.cleandoc('''
