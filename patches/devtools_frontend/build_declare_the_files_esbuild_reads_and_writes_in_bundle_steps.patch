--- a/front_end/third_party/puppeteer/BUILD.gn
+++ b/front_end/third_party/puppeteer/BUILD.gn
@@ -405,6 +405,22 @@ devtools_pre_built("puppeteer") {
   sources_are_release = false
 
   sources = filter_exclude(SOURCES, EXCLUDED_SOURCES)
+
+  # esbuild reads the package.json (and tsconfig.json) above each file it
+  # bundles; declare them so the bundle step has them under remote execution.
+  # With --sourcemap esbuild follows the sourceMappingURL of these files and
+  # reads the source maps, and the original sources they point at when the
+  # maps have no sourcesContent.
+  inputs = [ "package/package.json" ]
+  foreach(_js, filter_include(sources, [ "package/lib/puppeteer/*.js" ])) {
+    _dir = get_path_info(_js, "dir")
+    _name = get_path_info(_js, "name")
+    inputs += [
+      "$_js.map",
+      string_replace(_dir, "package/lib/puppeteer", "package/src", 1) +
+          "/$_name.ts",
+    ]
+  }
 }
 
