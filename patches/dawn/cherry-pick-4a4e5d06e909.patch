+++ b/test/tint/builtins/bufferArrayView/workgroup_runtime_array.wgsl
@@ -0,0 +1,17 @@
+@group(0) @binding(0) var<storage> in : array<u32>;
+@group(0) @binding(1) var<storage, read_write> out : array<u32>;
+const size = 256;
+var<workgroup> b : buffer<size>;
+
+@compute @workgroup_size(1)
+fn main() {
+  let view = bufferArrayView<array<u32>>(&b, 0, size);
+  for (var i = 0; i < size / 4; i++) {
+    view[i] = in[i];
+  }
+  workgroupBarrier();
+  for (var i = 0; i < size / 4; i++) {
+    out[i] = view[i];
+  }
+}
