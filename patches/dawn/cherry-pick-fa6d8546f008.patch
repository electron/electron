diff --git a/src/dawn/native/opengl/ContextEGL.cpp b/src/dawn/native/opengl/ContextEGL.cpp
index a8c65e8c14276690fd2a17d2a994e768a640033f..e6162f3ff33dcc2addb0de503962f5226dd91014 100644
--- a/src/dawn/native/opengl/ContextEGL.cpp
+++ b/src/dawn/native/opengl/ContextEGL.cpp
@@ -180,10 +180,14 @@ MaybeError ContextEGL::Initialize(wgpu::BackendType backend,
         DAWN_ASSERT(egl.HasExt(EGLExt::CreateContextRobustness));
         // EGL_EXT_create_context_robustness is promoted to 1.5 but with a different enum value.
         // PowerVR advertises EGL 1.5, but only supports the old enum value.
+        // Request reset notification so that glGetGraphicsResetStatus reports GPU resets.
         if (egl.GetMinorVersion() >= 5 && !disableEGL15Robustness) {
             AddAttrib(EGL_CONTEXT_OPENGL_ROBUST_ACCESS, EGL_TRUE);
+            AddAttrib(EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY, EGL_LOSE_CONTEXT_ON_RESET);
         } else {
             AddAttrib(EGL_CONTEXT_OPENGL_ROBUST_ACCESS_EXT, EGL_TRUE);
+            AddAttrib(EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY_EXT,
+                      EGL_LOSE_CONTEXT_ON_RESET_EXT);
         }
     }
 
diff --git a/src/dawn/native/opengl/OpenGLFunctions.cpp b/src/dawn/native/opengl/OpenGLFunctions.cpp
index f8f1bd8d580d60c062a454074ce9fdcec41e1737..29aad422400bdd054e615bdab6af4e3220c6a855 100644
--- a/src/dawn/native/opengl/OpenGLFunctions.cpp
+++ b/src/dawn/native/opengl/OpenGLFunctions.cpp
@@ -47,6 +47,25 @@ MaybeError OpenGLFunctions::Initialize(GLGetProcProc getProc) {
 #endif
     }
 
+    // glGetGraphicsResetStatus is core in OpenGL ES 3.2 and OpenGL 4.5. Otherwise load it from the
+    // robustness extensions, which all have the same signature and return values.
+    // TODO(crbug.com/580950772): Support gl.xml aliases in the OpenGL loader generator and load
+    // these with it instead of manually.
+    auto LoadResetStatusFromExtension = [&](const char* extension, const char* procName) {
+        if (GetGraphicsResetStatus == nullptr && IsGLExtensionSupported(extension)) {
+            GetGraphicsResetStatus =
+                reinterpret_cast<PFNGLGETGRAPHICSRESETSTATUSPROC>(getProc(procName));
+        }
+    };
+    if (mVersion.IsES()) {
+        LoadResetStatusFromExtension("GL_KHR_robustness", "glGetGraphicsResetStatusKHR");
+        LoadResetStatusFromExtension("GL_EXT_robustness", "glGetGraphicsResetStatusEXT");
+    } else {
+        // In desktop GL, the GL_KHR_robustness entry points have no suffix.
+        LoadResetStatusFromExtension("GL_KHR_robustness", "glGetGraphicsResetStatus");
+        LoadResetStatusFromExtension("GL_ARB_robustness", "glGetGraphicsResetStatusARB");
+    }
+
     return {};
 }
 
