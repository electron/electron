diff --git a/src/dawn/native/opengl/QueueGL.cpp b/src/dawn/native/opengl/QueueGL.cpp
index 09ccf42b03d56d2a2a8cf430c34dcff6e778fefc..1b03d1421f312b779b0fbee03905bbed8f3ace34 100644
--- a/src/dawn/native/opengl/QueueGL.cpp
+++ b/src/dawn/native/opengl/QueueGL.cpp
@@ -223,6 +223,7 @@ ResultOrError<ExecutionSerial> Queue::WaitForQueueSerialImpl(ExecutionSerial wai
                 case EGL_TIMEOUT_EXPIRED:
                     return kWaitSerialTimeout;
                 case EGL_CONDITION_SATISFIED:
+                    DAWN_TRY(CheckGraphicsResetStatus(gl, "Waiting for a queue serial"));
                     return completedSerial;
                 default:
                     DAWN_UNREACHABLE();
@@ -338,13 +339,19 @@ ResultOrError<ExecutionSerial> Queue::CheckAndUpdateCompletedSerials() {
                 DAWN_TRY_ASSIGN(result,
                                 sync->ClientWait(gl, EGL_SYNC_FLUSH_COMMANDS_BIT, Nanoseconds(0u)));
                 if (result == EGL_TIMEOUT_EXPIRED) {
-                    return fenceSerial;
+                    break;
                 }
                 // Update fenceSerial since fence is ready.
                 fenceSerial = tentativeSerial;
 
                 fencesInFlight->pop_front();
             }
+            if (fenceSerial != ExecutionSerial(0u)) {
+                // A fence also signals when the GPU work before it was discarded by a GPU reset, so
+                // check for a reset before results of that work (e.g. mapped buffers) become
+                // visible to the application.
+                DAWN_TRY(CheckGraphicsResetStatus(gl, "Completing a queue serial"));
+            }
             return fenceSerial;
         });
     });
diff --git a/src/dawn/native/opengl/UtilsGL.cpp b/src/dawn/native/opengl/UtilsGL.cpp
index b191502a5b01a48e365eba0617d3d426cbbb40af..02af2bd9aac8a6602068a336fca0dff13f463e10 100644
--- a/src/dawn/native/opengl/UtilsGL.cpp
+++ b/src/dawn/native/opengl/UtilsGL.cpp
@@ -198,6 +198,22 @@ const char* GLErrorAsString(GLenum error) {
 #undef ERROR_CASE_STRING
 }
 
+const char* GLResetStatusAsString(GLenum status) {
+#define STATUS_CASE_STRING(statusEnum) \
+    case statusEnum:                   \
+        return #statusEnum
+
+    switch (status) {
+        STATUS_CASE_STRING(GL_GUILTY_CONTEXT_RESET);
+        STATUS_CASE_STRING(GL_INNOCENT_CONTEXT_RESET);
+        STATUS_CASE_STRING(GL_UNKNOWN_CONTEXT_RESET);
+        default:
+            return "<Unknown OpenGL reset status>";
+    }
+
+#undef STATUS_CASE_STRING
+}
+
 const char* GLFramebufferStatusAsString(GLenum status) {
 #define STATUS_CASE_STRING(statusEnum) \
     case statusEnum:                   \
@@ -301,7 +317,18 @@ MaybeError CheckError(const OpenGLFunctions& gl,
 
 MaybeError CheckPendingErrorBeforeUserVisibleData(const OpenGLFunctions& gl,
                                                   const char* description) {
+    DAWN_TRY(CheckGraphicsResetStatus(gl, description));
     return CheckError(gl, description, __FILE__, __func__, __LINE__);
 }
 
+MaybeError CheckGraphicsResetStatus(const OpenGLFunctions& gl, const char* description) {
+    GLenum status = gl.GetGraphicsResetStatus();
+    if (status == GL_NO_ERROR) [[likely]] {
+        return {};
+    }
+    return DAWN_BACKEND_DEVICE_LOST_ERROR(std::string(description) +
+                                          ": the OpenGL context was reset with status " +
+                                          GLResetStatusAsString(status));
+}
+
 }  // namespace dawn::native::opengl
