From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shrek Shao <shrekshao@google.com>
Date: Mon, 2 Nov 2026 12:50:23 -0800
Subject: [opengl] Check for GPU resets before data is app-visible

A GPU reset can discard queued GPU work while no GL error is generated
on certain device.

Request EGL_LOSE_CONTEXT_ON_RESET together with robust access so that
glGetGraphicsResetStatus reports resets, and load it (core in ES 3.2 /
GL 4.5, otherwise from GL_KHR(27%)/EXT(91%)/ARB_robustness).

Check the reset status, losing the device on a reset:
- in CheckPendingErrorBeforeUserVisibleData, which MapAsync now also
  uses after glMapBufferRange instead of DAWN_GL_TRY_ALWAYS_CHECK.
- when a fence signals, before advancing the completed serial.

Bug: 576131851
Change-Id: Ie38bceb5608d9483a833aaef2bcf79d24d6e6d2e
Reviewed-on: https://dawn-review.googlesource.com/c/dawn/+/354617
Reviewed-by: Corentin Wallez <cwallez@chromium.org>
Commit-Queue: Shrek Shao <shrekshao@google.com>

Electron adaptation notes (43-x-y):
Dawn on this branch has no CheckPendingErrorBeforeUserVisibleData(),
GLFramebufferStatusAsString() / CheckFramebufferComplete(),
DAWN_BACKEND_DEVICE_LOST_ERROR or src/utils/warning_suppression_mappings.txt:
Buffer::MapAsyncImpl keeps DAWN_GL_TRY_ALWAYS_CHECK for the glMapBufferRange
error check and calls CheckGraphicsResetStatus() directly afterwards;
CheckGraphicsResetStatus() uses DAWN_DEVICE_LOST_ERROR; only
GLGraphicsResetTests.cpp is added to the test source lists.

diff --git a/src/dawn/native/opengl/BufferGL.cpp b/src/dawn/native/opengl/BufferGL.cpp
index 0f5c65065f0f1d3ddc0fdb01727a18c75b4584ce..ac55b7c266e6c15ece7a1e58cc25c84320ac3794 100644
--- a/src/dawn/native/opengl/BufferGL.cpp
+++ b/src/dawn/native/opengl/BufferGL.cpp
@@ -262,6 +262,8 @@ MaybeError Buffer::MapAsyncImpl(wgpu::MapMode mode, size_t offset, size_t size)
                     gl, MapBufferRange(GL_ARRAY_BUFFER, offset, size,
                                        GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT));
             }
+            // The mapped data becomes visible to the application.
+            DAWN_TRY(CheckGraphicsResetStatus(gl, "Mapping a buffer"));
 
             // The frontend asks that the pointer returned by GetMappedPointer is from the start of
             // the resource but OpenGL gives us the pointer at offset. Remove the offset.
diff --git a/src/dawn/native/opengl/ContextEGL.cpp b/src/dawn/native/opengl/ContextEGL.cpp
index 5e94123499d54ac75c090d4467c7a03836ade7ec..699dc06de4ee489736be85615fa8919a405d2a66 100644
--- a/src/dawn/native/opengl/ContextEGL.cpp
+++ b/src/dawn/native/opengl/ContextEGL.cpp
@@ -170,10 +170,14 @@ MaybeError ContextEGL::Initialize(wgpu::BackendType backend,
         DAWN_ASSERT(egl.HasExt(EGLExt::CreateContextRobustness));
         // EGL_EXT_create_context_robustness is promoted to 1.5 but with a different enum value.
         // PowerVR advertises EGL 1.5, but only supports the old enum value.
+        // Request reset notification so that glGetGraphicsResetStatus reports GPU resets.
         if (egl.GetMinorVersion() >= 5 && !disableEGL15Robustness) {
             AddAttrib(EGL_CONTEXT_OPENGL_ROBUST_ACCESS, EGL_TRUE);
+            AddAttrib(EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY, EGL_LOSE_CONTEXT_ON_RESET);
         } else {
             AddAttrib(EGL_CONTEXT_OPENGL_ROBUST_ACCESS_EXT, EGL_TRUE);
+            AddAttrib(EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY_EXT,
+                      EGL_LOSE_CONTEXT_ON_RESET_EXT);
         }
     }
 
diff --git a/src/dawn/native/opengl/OpenGLFunctions.cpp b/src/dawn/native/opengl/OpenGLFunctions.cpp
index f8f1bd8d580d60c062a454074ce9fdcec41e1737..29aad422400bdd054e615bdab6af4e3220c6a855 100644
--- a/src/dawn/native/opengl/OpenGLFunctions.cpp
+++ b/src/dawn/native/opengl/OpenGLFunctions.cpp
@@ -47,6 +47,25 @@ MaybeError OpenGLFunctions::Initialize(GLGetProcProc getProc) {
 #endif
     }
 
+    // glGetGraphicsResetStatus is core in OpenGL ES 3.2 and OpenGL 4.5. Otherwise load it from the
+    // robustness extensions, which all have the same signature and return values.
+    // TODO(crbug.com/580950772): Support gl.xml aliases in the OpenGL loader generator and load
+    // these with it instead of manually.
+    auto LoadResetStatusFromExtension = [&](const char* extension, const char* procName) {
+        if (GetGraphicsResetStatus == nullptr && IsGLExtensionSupported(extension)) {
+            GetGraphicsResetStatus =
+                reinterpret_cast<PFNGLGETGRAPHICSRESETSTATUSPROC>(getProc(procName));
+        }
+    };
+    if (mVersion.IsES()) {
+        LoadResetStatusFromExtension("GL_KHR_robustness", "glGetGraphicsResetStatusKHR");
+        LoadResetStatusFromExtension("GL_EXT_robustness", "glGetGraphicsResetStatusEXT");
+    } else {
+        // In desktop GL, the GL_KHR_robustness entry points have no suffix.
+        LoadResetStatusFromExtension("GL_KHR_robustness", "glGetGraphicsResetStatus");
+        LoadResetStatusFromExtension("GL_ARB_robustness", "glGetGraphicsResetStatusARB");
+    }
+
     return {};
 }
 
diff --git a/src/dawn/native/opengl/PhysicalDeviceGL.cpp b/src/dawn/native/opengl/PhysicalDeviceGL.cpp
index 32819631bab8a29c13f9c4b22f3de12a9298e2c8..bc478590fe4c124be28f3e47d58fa057a13cd276 100644
--- a/src/dawn/native/opengl/PhysicalDeviceGL.cpp
