         DAWN_ASSERT(GetBackendType() == wgpu::BackendType::OpenGLES);
diff --git a/src/dawn/native/opengl/QueueGL.cpp b/src/dawn/native/opengl/QueueGL.cpp
index c44670eb07bd59f375f38be4306e6895b53f6027..be3c436c051fa823bf55fb7fb3c72d20f108be3d 100644
--- a/src/dawn/native/opengl/QueueGL.cpp
+++ b/src/dawn/native/opengl/QueueGL.cpp
@@ -216,6 +216,7 @@ ResultOrError<ExecutionSerial> Queue::WaitForQueueSerialImpl(ExecutionSerial wai
                 case EGL_TIMEOUT_EXPIRED:
                     return kWaitSerialTimeout;
                 case EGL_CONDITION_SATISFIED:
+                    DAWN_TRY(CheckGraphicsResetStatus(gl, "Waiting for a queue serial"));
                     return completedSerial;
                 default:
                     DAWN_UNREACHABLE();
@@ -327,13 +328,19 @@ ResultOrError<ExecutionSerial> Queue::CheckAndUpdateCompletedSerials() {
                 DAWN_TRY_ASSIGN(result,
                                 sync->ClientWait(gl, EGL_SYNC_FLUSH_COMMANDS_BIT, Nanoseconds(0u)));
                 if (result == EGL_TIMEOUT_EXPIRED) {
-                    return fenceSerial;
+                    break;
                 }
                 // Update fenceSerial since fence is ready.
                 fenceSerial = tentativeSerial;
 
                 fencesInFlight->pop_front();
             }
+            if (fenceSerial != ExecutionSerial(0u)) {
+                // A fence also signals when the GPU work before it was discarded by a GPU reset, so
+                // check for a reset before results of that work (e.g. mapped buffers) become
+                // visible to the application.
+                DAWN_TRY(CheckGraphicsResetStatus(gl, "Completing a queue serial"));
+            }
             return fenceSerial;
         });
     });
diff --git a/src/dawn/native/opengl/UtilsGL.cpp b/src/dawn/native/opengl/UtilsGL.cpp
index df219b6f767de4540728bd7091ee3affd9771c72..1fc4c9626325bbdab12a3f3ff8b82cdc70fc2c12 100644
--- a/src/dawn/native/opengl/UtilsGL.cpp
+++ b/src/dawn/native/opengl/UtilsGL.cpp
@@ -196,6 +196,22 @@ const char* GLErrorAsString(GLenum error) {
 #undef ERROR_CASE_STRING
 }
 
+const char* GLResetStatusAsString(GLenum status) {
+#define STATUS_CASE_STRING(statusEnum) \
+    case statusEnum:                   \
+        return #statusEnum
+
+    switch (status) {
+        STATUS_CASE_STRING(GL_GUILTY_CONTEXT_RESET);
+        STATUS_CASE_STRING(GL_INNOCENT_CONTEXT_RESET);
+        STATUS_CASE_STRING(GL_UNKNOWN_CONTEXT_RESET);
+        default:
+            return "<Unknown OpenGL reset status>";
+    }
+
+#undef STATUS_CASE_STRING
+}
+
 const char* GLFramebufferStatusAsString(GLenum status) {
 #define STATUS_CASE_STRING(statusEnum) \
     case statusEnum:                   \
@@ -292,4 +308,14 @@ MaybeError CheckError(const OpenGLFunctions& gl,
     }
 }
 
+MaybeError CheckGraphicsResetStatus(const OpenGLFunctions& gl, const char* description) {
+    GLenum status = gl.GetGraphicsResetStatus();
+    if (status == GL_NO_ERROR) [[likely]] {
+        return {};
+    }
+    return DAWN_DEVICE_LOST_ERROR(std::string(description) +
+                                  ": the OpenGL context was reset with status " +
+                                  GLResetStatusAsString(status));
+}
+
 }  // namespace dawn::native::opengl
diff --git a/src/dawn/native/opengl/UtilsGL.h b/src/dawn/native/opengl/UtilsGL.h
index 7cab0ba81c958210ef85d8ce2af0b12041cca3d4..1ea89333cbfd2fbd458ae4e1a652f65bef72c8e1 100644
--- a/src/dawn/native/opengl/UtilsGL.h
+++ b/src/dawn/native/opengl/UtilsGL.h
@@ -52,6 +52,7 @@ bool HasAnisotropicFiltering(const OpenGLFunctions& gl);
 
 const char* GLErrorAsString(GLenum error);
 const char* GLFramebufferStatusAsString(GLenum status);
+const char* GLResetStatusAsString(GLenum status);
 
 // Checks that the framebuffer bound to `target` is complete, returning an internal error
 // otherwise. The check is unconditional so that callers relying on subsequent framebuffer
@@ -71,6 +72,12 @@ MaybeError CheckError(const OpenGLFunctions& gl,
                       const char* function,
                       unsigned int line);
 
+// Checks whether the GL context was reset (e.g. by a GPU hang). A reset can discard GPU work while
+// fences still signal and no GL error is generated, for example leaving the destination of a
+// readback unwritten. Call it before results of GPU work become visible to the application. Returns
+// a device lost error if a reset happened.
+MaybeError CheckGraphicsResetStatus(const OpenGLFunctions& gl, const char* description);
+
 #define DAWN_GL_TRY_ALWAYS_CHECK(gl, call)                      \
     (ClearErrors(gl, __FILE__, __func__, __LINE__), (gl.call)); \
     DAWN_TRY(CheckError(gl, "gl" #call, __FILE__, __func__, __LINE__))
