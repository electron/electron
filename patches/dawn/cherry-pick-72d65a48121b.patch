diff --git a/src/dawn/native/opengl/UtilsGL.cpp b/src/dawn/native/opengl/UtilsGL.cpp
index cbef91de7342c5c13d0ecbfc041368234fce1c49..b191502a5b01a48e365eba0617d3d426cbbb40af 100644
--- a/src/dawn/native/opengl/UtilsGL.cpp
+++ b/src/dawn/native/opengl/UtilsGL.cpp
@@ -262,19 +262,23 @@ MaybeError CheckError(const OpenGLFunctions& gl,
                       const char* file,
                       const char* function,
                       unsigned int line) {
-    GLenum error = gl.GetError();
+    GLenum error = INJECT_ERROR_OR_RUN(gl.GetError(), static_cast<GLenum>(GL_OUT_OF_MEMORY));
     if (error == GL_NO_ERROR) [[likely]] {
         return {};
     }
 
+    // The error may also have been left pending by an earlier unchecked call.
     std::string message = std::string(call) + " failed with " + GLErrorAsString(error);
 
-    // Check that only one GL error was generated, ClearErrors should have been called first.
+    // Drain and report all the pending errors. Keep track of whether a context loss was reported
+    // by any of them, so that it isn't hidden by an earlier error.
+    bool contextLost = error == GL_CONTEXT_LOST;
     GLenum nextError = gl.GetError();
     while (nextError != GL_NO_ERROR) {
         // Skip GL_CONTEXT_LOST errors, they will be generated continuously and result in an
         // infinite loop.
         if (nextError == GL_CONTEXT_LOST) {
+            contextLost = true;
             break;
         }
 
@@ -284,14 +288,20 @@ MaybeError CheckError(const OpenGLFunctions& gl,
 
     DebugLog(file, function, line) << message;
 
+    if (contextLost) {
+        return DAWN_BACKEND_DEVICE_LOST_ERROR(message);
+    }
     switch (error) {
         case GL_OUT_OF_MEMORY:
             return DAWN_OUT_OF_MEMORY_ERROR(message);
-        case GL_CONTEXT_LOST:
-            return DAWN_BACKEND_DEVICE_LOST_ERROR(message);
         default:
             return DAWN_INTERNAL_ERROR(message);
     }
 }
 
+MaybeError CheckPendingErrorBeforeUserVisibleData(const OpenGLFunctions& gl,
+                                                  const char* description) {
+    return CheckError(gl, description, __FILE__, __func__, __LINE__);
+}
+
 }  // namespace dawn::native::opengl
diff --git a/src/dawn/native/opengl/UtilsGL.h b/src/dawn/native/opengl/UtilsGL.h
index 7cab0ba81c958210ef85d8ce2af0b12041cca3d4..9556d22323534f0555bc978cac19b55a39d5e432 100644
--- a/src/dawn/native/opengl/UtilsGL.h
+++ b/src/dawn/native/opengl/UtilsGL.h
@@ -64,15 +64,24 @@ void ClearErrors(const OpenGLFunctions& gl,
                  const char* function,
                  unsigned int line);
 
-// Check for a single GL error.
+// Check for a GL error, also reporting the errors left pending by earlier unchecked calls. Returns
+// a device lost error if any of them is a context loss.
 MaybeError CheckError(const OpenGLFunctions& gl,
                       const char* call,
                       const char* file,
                       const char* function,
                       unsigned int line);
 
-#define DAWN_GL_TRY_ALWAYS_CHECK(gl, call)                      \
-    (ClearErrors(gl, __FILE__, __func__, __LINE__), (gl.call)); \
+// Checks for any GL error pending on the context. Call it explicitly before data becomes visible to
+// the application, so that errors from unchecked GL calls lose the device before the data becomes
+// visible to app.
+MaybeError CheckPendingErrorBeforeUserVisibleData(const OpenGLFunctions& gl,
+                                                  const char* description);
+
+// Errors left pending by earlier unchecked calls are not cleared, so that they are reported by
+// CheckError instead of being silently dropped.
+#define DAWN_GL_TRY_ALWAYS_CHECK(gl, call) \
+    (gl.call);                             \
     DAWN_TRY(CheckError(gl, "gl" #call, __FILE__, __func__, __LINE__))
 #define DAWN_GL_TRY_ALWAYS_CHECK_IGNORE_ERRORS(gl, call)        \
     (ClearErrors(gl, __FILE__, __func__, __LINE__), (gl.call)); \
