module electron.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";
import "mojo/public/mojom/base/string16.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "third_party/blink/public/mojom/messaging/transferable_message.mojom";

// A preload script and its contents, pushed to the renderer ahead of the
// document that needs it.
struct PreloadScriptData {
  string id;
  string file_path;
  // UTF-8 contents. array<uint8> rather than BigBuffer so RendererStartupData
  // can be flat-serialized into an opaque blob for the CreateNewWindowReply
  // path.
  array<uint8> contents;
  // Set if the file could not be read; surfaced via the 'preload-error' event.
  string? error;
  // V8 code cache, produced by the first renderer to compile this preload and
  // persisted under userData/Code Cache/electron-preload/. Only shipped when
  // its recorded source hash matches |contents|.
  array<uint8>? code_cache;
};

// Everything a sandboxed renderer needs to bootstrap a preload environment.
// process.arch/platform/version/versions are intentionally not here — they're
// filled renderer-side from node::per_process::metadata.
struct RendererStartupData {
  array<PreloadScriptData> preload_scripts;
  // Browser process.env, captured fresh per push.
  map<string, string> environment;
  string helper_exec_path;
};

// A value serialized with electron::SerializeV8Value(), in the buffer it is
// sent in. |buffer| may be larger than the |size| bytes that were written.
struct SerializedValue {
  mojo_base.mojom.BigBuffer buffer;
  uint64 size;
};

// Per-frame associated interface ordered against content.mojom.Frame, so
// SetStartupData() arrives before the CommitNavigation that follows it.
interface ElectronFrameStartup {
  SetStartupData(RendererStartupData data);
};

interface ElectronRenderer {
  Message(
      bool internal,
      string channel,
      SerializedValue arguments);

  ReceivePostMessage(string channel, blink.mojom.TransferableMessage message);

  TakeHeapSnapshot(handle file) => (bool success);
};

// apiBridge: APIs the main process passes to frames with
// frame.apiBridge.pass() and session.apiBridge.pass().
enum ApiBridgeMemberKind {
  kMethod,
  kSyncMethod,
  kEvent,
  kStore,
};

// The JavaScript world of a document that an API is installed in.
enum ApiBridgeWorld {
  // The world of the page.
  kMain,
  // Electron's isolated world, where preload scripts run with
  // contextIsolation.
  kIsolated,
};

struct ApiBridgeMember {
  string name;
  ApiBridgeMemberKind kind;
  // The store's value when the grant was sent. Only set for kStore.
  SerializedValue? store_value;
};

struct ApiBridgeGrant {
  // Identifies the grant in every later message. Unique per browser process.
  uint64 id;
  string name;
  ApiBridgeWorld world;
  array<ApiBridgeMember> members;
};

struct ApiBridgeError {
  // The name of the error, such as "TypeError".
  string name;
  string message;
};

union ApiBridgeResult {
  SerializedValue value;
  ApiBridgeError error;
};

// Browser -> renderer. Associated with content.mojom.Frame, so
// SetPendingGrants() arrives before the CommitNavigation that follows it.
interface ElectronApiBridgeClient {
  // The grants for the document that the next cross-document commit in this
  // frame creates. Replaces any earlier pending set.
  SetPendingGrants(array<ApiBridgeGrant> grants);
  // Changes the grants of the current document: removes |revoked| and adds
  // |added|. A grant in |added| that the document has already is refreshed.
  // Ignored unless the current document's origin serializes to |origin|, so
  // a change meant for a document that has just been replaced never reaches
  // the next one. A null |origin| means the current document, whatever its
  // origin; the browser only sends that right after a commit.
  UpdateGrants(string? origin,
               array<uint64> revoked,
               array<ApiBridgeGrant> added);
  // Replaces the grants of the current document with |grants|. Sent when a
  // page comes back from the back/forward cache or from prerendering, when
  // the grants it holds can be out of date.
  ResetGrants(array<ApiBridgeGrant> grants);
  // |args| is a serialized array.
  EmitEvent(uint64 grant_id, uint32 member, SerializedValue args);
  UpdateStore(uint64 grant_id, uint32 member, SerializedValue value);
};

// Renderer -> browser. The browser resolves the calling frame from the
// receiver, never from the message, and checks the grant and the frame's
// committed origin on every call.
interface ElectronApiBridgeHost {
  // |args| is a serialized array.
  Call(uint64 grant_id, uint32 member, SerializedValue args)
      => (ApiBridgeResult result);

  [Sync]
  CallSync(uint64 grant_id, uint32 member, SerializedValue args)
      => (ApiBridgeResult result);
};

interface ElectronAutofillAgent {
  AcceptDataListSuggestion(mojo_base.mojom.String16 value);
};

interface ElectronAutofillDriver {
  ShowAutofillPopup(gfx.mojom.RectF bounds, array<mojo_base.mojom.String16> values, array<mojo_base.mojom.String16> labels);
  HideAutofillPopup();
};

interface ElectronApiIPC {
  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process.
  Message(
      bool internal,
      string channel,
      SerializedValue arguments);

  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process, and returns the response.
  Invoke(
      bool internal,
      string channel,
      SerializedValue arguments) => (SerializedValue result);

  ReceivePostMessage(string channel, blink.mojom.TransferableMessage message);

  // Emits an event on |channel| from the ipcMain JavaScript object in the main
  // process, and waits synchronously for a response.
  [Sync]
  MessageSync(
    bool internal,
    string channel,
    SerializedValue arguments) => (SerializedValue result);

  MessageHost(
    string channel,
    SerializedValue arguments);
};
