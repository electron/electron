{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "nodenext",
    // Specs are loaded as-is by Node's built-in type stripping, so only
    // erasable syntax is allowed and imports must name real files. (Type-only
    // imports are enforced by oxlint rather than verbatimModuleSyntax, which
    // would reject the CommonJS-scoped lib/ files a couple of specs import.)
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "spec",
    "typings"
  ],
  "exclude": [
    "spec/fixtures/type-stripping"
  ]
}
